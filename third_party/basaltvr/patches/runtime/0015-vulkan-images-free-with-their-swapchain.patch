+// Waits until the GPU has finished what the runtime submitted on the game's queue: the copies of the
+// slices and, through the fence after them, every command of the game before its last xrEndFrame.
+// MoltenVK's command buffers keep no reference to their textures, so a swapchain's textures may go
+// only after that. False when the GPU took more than a second.
+bool waitForSubmittedFrames(basalt::VulkanSession* session) {
+    AcquireSRWLockExclusive(&session->syncLock);
+    bool finished = true;
+    if (session->sync != nullptr) {
+        // The newest fence signals after every earlier submission to the queue
+        FrameSlot* newest = nullptr;
+        for (FrameSlot& slot : session->sync->slots) {
+            if (slot.submitted && (newest == nullptr || slot.frameNumber > newest->frameNumber)) {
+                newest = &slot;
+            }
+        }
+        if (newest != nullptr) {
+            finished = session->waitForFences(session->device, 1, &newest->fence, VK_TRUE, 1000000000ull) == VK_SUCCESS;
+        }
+    }
+    ReleaseSRWLockExclusive(&session->syncLock);
+    return finished;
+}
