+// cranvr: a session on a Vulkan device
+XrResult createVulkanSessionHandle(
+    XrInstance instance,
+    const XrGraphicsBindingVulkanKHR* binding,
+    XrSession* session) {
+    VulkanSession* vulkan = nullptr;
+    const XrResult result = createVulkanSession(instance, binding, &vulkan);
+    if (XR_FAILED(result)) {
+        return result;
+    }
+    AcquireSRWLockExclusive(&gGraphicsLock);
+    if (gLiveSession != XR_NULL_HANDLE || gNextSessionHandle > UINTPTR_MAX - kSessionHandleStride) {
+        ReleaseSRWLockExclusive(&gGraphicsLock);
+        destroyVulkanSession(vulkan);
+        return XR_ERROR_LIMIT_REACHED;
+    }
+    gLiveSession = reinterpret_cast<XrSession>(gNextSessionHandle);
+    gNextSessionHandle += kSessionHandleStride;
+    gSessionInstance = instance;
+    gSessionVulkan = vulkan;
+    *session = gLiveSession;
+    ReleaseSRWLockExclusive(&gGraphicsLock);
+    initializeSessionLifecycle(instance, *session);
+    vulkanControlSessionCreated(*session, vulkan);
+    return XR_SUCCESS;
+}
