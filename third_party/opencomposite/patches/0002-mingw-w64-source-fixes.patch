+void DX11Compositor::ReleaseConvertTexture()
+{
+	if (convertView) {
+		convertView->Release();
+		convertView = nullptr;
+	}
+	if (convertTexture) {
+		convertTexture->Release();
+		convertTexture = nullptr;
+	}
+}
+
+bool DX11Compositor::RuntimeOffersFormat(DXGI_FORMAT format)
+{
+	uint32_t count = 0;
+	if (XR_FAILED(xrEnumerateSwapchainFormats(xr_session.get(), 0, &count, nullptr)))
+		return true; // Cannot tell: leave the choice to the runtime's answer to xrCreateSwapchain
+	std::vector<int64_t> formats(count);
+	if (XR_FAILED(xrEnumerateSwapchainFormats(xr_session.get(), count, &count, formats.data())))
+		return true;
+	for (int64_t offered : formats) {
+		if (offered == static_cast<int64_t>(format))
+			return true;
+	}
+	return false;
+}
+
+DXGI_FORMAT DX11Compositor::SwapChannelOrder(DXGI_FORMAT format)
+{
+	switch (format) {
+	case DXGI_FORMAT_R8G8B8A8_UNORM:
+		return DXGI_FORMAT_B8G8R8A8_UNORM;
+	case DXGI_FORMAT_R8G8B8A8_UNORM_SRGB:
+		return DXGI_FORMAT_B8G8R8A8_UNORM_SRGB;
+	case DXGI_FORMAT_B8G8R8A8_UNORM:
+	case DXGI_FORMAT_B8G8R8X8_UNORM:
+		return DXGI_FORMAT_R8G8B8A8_UNORM;
+	case DXGI_FORMAT_B8G8R8A8_UNORM_SRGB:
+	case DXGI_FORMAT_B8G8R8X8_UNORM_SRGB:
+		return DXGI_FORMAT_R8G8B8A8_UNORM_SRGB;
+	default:
+		return DXGI_FORMAT_UNKNOWN;
+	}
+}
