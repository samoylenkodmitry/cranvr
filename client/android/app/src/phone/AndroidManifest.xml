<?xml version="1.0" encoding="utf-8"?>
<!--
    The manifest of the phone's APK. build.gradle.kts takes it in place of src/main's when the
    property cranvrPhone is true. The app declares only what is its own. The activity, its
    launcher entry and the library name come from the Cranpose Gradle plugin.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The sockets of the link to the host -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:supportsRtl="true">
        <!-- The Cranpose library declares this activity in full. The phone's picture has the
             screen's shape in landscape, so the activity turns to landscape with the sensor. The
             Quest's activity gets its orientation from the xr service. -->
        <activity
            android:name="dev.cranpose.android.CranposeActivity"
            android:screenOrientation="sensorLandscape" />
        <!-- The entry for adb. Only a caller that holds DUMP may start it: the shell user of adb
             and the system. An app gets DUMP only when someone grants it with adb. The client
             takes launch arguments only from a launch through this entry (client/src/launch.rs),
             so another app cannot make it forget a paired Mac's key or link to another host. -->
        <activity-alias
            android:name="dev.cranvr.client.AdbStart"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:targetActivity="dev.cranpose.android.CranposeActivity">
            <!-- A start through an alias reads the native library's name from the alias's own
                 meta-data, both in Cranpose's loader and in NativeActivity. Without it the start
                 looks for the library "main" and fails. The Cranpose plugin names the library after
                 the crate cranvr-client. -->
            <meta-data
                android:name="android.app.lib_name"
                android:value="cranvr_client" />
        </activity-alias>
    </application>
</manifest>
