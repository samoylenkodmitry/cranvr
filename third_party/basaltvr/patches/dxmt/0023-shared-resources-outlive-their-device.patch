\ No newline at end of file
+#endif
+#include <atomic>
+
+namespace dxmt {
+
+// cranvr: a D3DKMT device lives until its DXGI device and each shared resource with an allocation of it let go. An
+// application may release a device before its shared textures: SteamVR's client in Steam does at its end. Such a
+// texture then frees its allocation through this, not through the device that is gone.
+class KmtDevice {
+public:
+  explicit KmtDevice(D3DKMT_HANDLE handle) : handle_(handle) {}
+  ~KmtDevice() {
+    D3DKMT_DESTROYDEVICE destroy = {};
+    destroy.hDevice = handle_;
+    D3DKMTDestroyDevice(&destroy);
+  }
+  KmtDevice(const KmtDevice &) = delete;
+  KmtDevice &operator=(const KmtDevice &) = delete;
+
+  D3DKMT_HANDLE handle() const { return handle_; }
+
+  void destroyAllocation(D3DKMT_HANDLE allocation) {
+    D3DKMT_DESTROYALLOCATION destroy = {};
+    destroy.hDevice = handle_;
+    destroy.hResource = allocation;
+    D3DKMTDestroyAllocation(&destroy);
+  }
+
+  void incRef() { refcount_.fetch_add(1u, std::memory_order_acquire); }
+  void decRef() {
+    if (refcount_.fetch_sub(1u, std::memory_order_release) == 1u)
+      delete this;
+  }
+
+private:
+  D3DKMT_HANDLE handle_;
+  std::atomic<uint32_t> refcount_ = {0u};
+};
+
+} // namespace dxmt
