+namespace {
+
+// DXMT republishes the global ID of an IOSurface texture's surface under this GUID (BasaltVR's DXMT patch 0001)
+const GUID kIOSurfaceIdGuid = {0xdd807311, 0x529e, 0x4856, {0xa5, 0xc0, 0x48, 0xbe, 0xd2, 0x04, 0x81, 0x29}};
+
+constexpr DWORD kWaitMs = 1000;
+
+enum Kind { kRgba16f, kBgra8, kRgba8Mips, kBgra8Array, kRgba8Msaa, kKeyed, kIOSurface, kKinds };
+
+struct KindInfo {
+    const char *name;
+    DXGI_FORMAT format;
+    UINT mips;
+    UINT slices;
+    UINT samples;
+    UINT misc;
+    bool nt;    // NT handle (CreateSharedHandle) rather than a legacy one (GetSharedHandle)
+    bool color; // the second process checks a texel
+};
+
+const KindInfo kKindInfo[kKinds] = {
+    {"rgba16f", DXGI_FORMAT_R16G16B16A16_FLOAT, 1, 1, 1, D3D11_RESOURCE_MISC_SHARED, false, true},
+    {"bgra8", DXGI_FORMAT_B8G8R8A8_UNORM, 1, 1, 1, D3D11_RESOURCE_MISC_SHARED, false, true},
+    {"rgba8-mips", DXGI_FORMAT_R8G8B8A8_UNORM, 4, 1, 1, D3D11_RESOURCE_MISC_SHARED, false, true},
+    {"bgra8-array", DXGI_FORMAT_B8G8R8A8_UNORM, 1, 2, 1,
+     D3D11_RESOURCE_MISC_SHARED | D3D11_RESOURCE_MISC_SHARED_NTHANDLE, true, true},
+    {"rgba8-msaa", DXGI_FORMAT_R8G8B8A8_UNORM, 1, 1, 4, D3D11_RESOURCE_MISC_SHARED, false, false},
+    {"keyed", DXGI_FORMAT_R8G8B8A8_UNORM, 1, 1, 1, D3D11_RESOURCE_MISC_SHARED_KEYEDMUTEX, false, true},
+    {"iosurface", DXGI_FORMAT_B8G8R8A8_UNORM, 1, 1, 1,
+     D3D11_RESOURCE_MISC_SHARED | D3D11_RESOURCE_MISC_SHARED_NTHANDLE, true, true},
+};
+
+template <typename T> void release(T *&object) {
+    if (object) {
+        object->Release();
+        object = nullptr;
+    }
+}
+
+bool fail(const char *what, HRESULT hr = S_OK) {
+    if (hr == S_OK)
+        std::printf("shared_churn: FAIL %s\n", what);
+    else
+        std::printf("shared_churn: FAIL %s (0x%08lx)\n", what, static_cast<unsigned long>(hr));
+    std::fflush(stdout);
+    return false;
+}
+
+struct Device {
+    ID3D11Device *device = nullptr;
+    ID3D11Device1 *device1 = nullptr;
+    ID3D11Device5 *device5 = nullptr;
+    ID3D11DeviceContext *context = nullptr;
+    ID3D11DeviceContext4 *context4 = nullptr;
+
+    bool create() {
+        D3D_FEATURE_LEVEL level = D3D_FEATURE_LEVEL_11_1;
+        HRESULT hr = D3D11CreateDevice(nullptr, D3D_DRIVER_TYPE_HARDWARE, nullptr, D3D11_CREATE_DEVICE_BGRA_SUPPORT,
+                                       &level, 1, D3D11_SDK_VERSION, &device, nullptr, &context);
+        if (FAILED(hr))
+            return fail("D3D11CreateDevice", hr);
+        if (FAILED(hr = device->QueryInterface(IID_PPV_ARGS(&device1))))
+            return fail("ID3D11Device1", hr);
+        if (FAILED(hr = device->QueryInterface(IID_PPV_ARGS(&device5))))
+            return fail("ID3D11Device5", hr);
+        if (FAILED(hr = context->QueryInterface(IID_PPV_ARGS(&context4))))
+            return fail("ID3D11DeviceContext4", hr);
+        return true;
+    }
+
+    ~Device() {
+        release(context4);
+        release(context);
+        release(device5);
+        release(device1);
+        release(device);
+    }
+};
+
+// The color of a kind in a cycle: 8-bit values that differ from one cycle and kind to the next
+void colorOf(unsigned cycle, int kind, uint8_t out[4]) {
+    unsigned seed = cycle * 7u + static_cast<unsigned>(kind) * 31u;
+    out[0] = static_cast<uint8_t>(16 + seed % 200);
+    out[1] = static_cast<uint8_t>(16 + (seed * 3u) % 200);
+    out[2] = static_cast<uint8_t>(16 + (seed * 5u) % 200);
+    out[3] = 255;
+}
+
+uint16_t halfOf(float value) {
+    // Exact for the multiples of 1/256 that the colors use
+    uint32_t bits;
+    std::memcpy(&bits, &value, 4);
+    uint32_t sign = (bits >> 16) & 0x8000u;
+    int exponent = static_cast<int>((bits >> 23) & 0xff) - 127 + 15;
+    uint32_t mantissa = bits & 0x7fffffu;
+    if (value == 0.0f)
+        return static_cast<uint16_t>(sign);
+    return static_cast<uint16_t>(sign | (static_cast<uint32_t>(exponent) << 10) | (mantissa >> 13));
+}
+
+D3D11_TEXTURE2D_DESC descOf(int kind, UINT width, UINT height) {
+    const KindInfo &k = kKindInfo[kind];
+    D3D11_TEXTURE2D_DESC desc = {};
+    desc.Width = width;
+    desc.Height = height;
+    desc.MipLevels = k.mips;
+    desc.ArraySize = k.slices;
+    desc.Format = k.format;
+    desc.SampleDesc.Count = k.samples;
+    desc.Usage = D3D11_USAGE_DEFAULT;
+    desc.BindFlags = D3D11_BIND_RENDER_TARGET | (k.samples == 1 ? D3D11_BIND_SHADER_RESOURCE : 0);
+    desc.MiscFlags = k.misc;
+    return desc;
+}
+
+std::string readLine(HANDLE pipe) {
+    std::string line;
+    char c;
+    DWORD got = 0;
+    while (ReadFile(pipe, &c, 1, &got, nullptr) && got == 1) {
+        if (c == '\n')
+            return line;
+        line += c;
+    }
+    return line.empty() ? std::string("eof") : line;
+}
+
+bool writeLine(HANDLE pipe, const std::string &line) {
+    std::string text = line + "\n";
+    DWORD done = 0;
+    return WriteFile(pipe, text.data(), static_cast<DWORD>(text.size()), &done, nullptr) && done == text.size();
+}
+
+bool waitFence(ID3D11Fence *fence, UINT64 value, HANDLE event) {
+    if (fence->GetCompletedValue() >= value)
+        return true;
+    fence->SetEventOnCompletion(value, event);
+    DWORD until = GetTickCount() + kWaitMs;
+    while (fence->GetCompletedValue() < value) {
+        DWORD now = GetTickCount();
+        if (now >= until)
+            return false;
+        WaitForSingleObject(event, until - now);
+    }
+    return true;
+}
+
+// --- the second process ---------------------------------------------------------------------------------------
+
+// Opens one texture and checks it; reply is "ok" or the failure
+std::string openAndCheck(Device &d, int kind, unsigned cycle, HANDLE handle, UINT width, UINT height) {
+    const KindInfo &k = kKindInfo[kind];
+    ID3D11Texture2D *texture = nullptr;
+    HRESULT hr = k.nt ? d.device1->OpenSharedResource1(handle, IID_PPV_ARGS(&texture))
+                      : d.device->OpenSharedResource(handle, IID_PPV_ARGS(&texture));
+    if (k.nt)
+        CloseHandle(handle);
+    if (FAILED(hr) || !texture)
+        return std::string(k.name) + " does not open";
+    D3D11_TEXTURE2D_DESC got;
+    texture->GetDesc(&got);
+    D3D11_TEXTURE2D_DESC want = descOf(kind, width, height);
+    if (got.Width != want.Width || got.Height != want.Height || got.Format != want.Format ||
+        got.MipLevels != want.MipLevels || got.ArraySize != want.ArraySize ||
+        got.SampleDesc.Count != want.SampleDesc.Count) {
+        texture->Release();
+        return std::string(k.name) + " opens with another description";
+    }
+    std::string result = "ok";
+    IDXGIKeyedMutex *mutex = nullptr;
+    if (kind == kKeyed) {
+        if (FAILED(texture->QueryInterface(IID_PPV_ARGS(&mutex))) || FAILED(mutex->AcquireSync(1, kWaitMs)))
+            result = "keyed: no keyed mutex";
+    }
+    if (k.color && result == "ok") {
+        D3D11_TEXTURE2D_DESC sdesc = want;
+        sdesc.MipLevels = 1;
+        sdesc.ArraySize = 1;
+        sdesc.Usage = D3D11_USAGE_STAGING;
+        sdesc.BindFlags = 0;
+        sdesc.CPUAccessFlags = D3D11_CPU_ACCESS_READ;
+        sdesc.MiscFlags = 0;
+        ID3D11Texture2D *staging = nullptr;
+        if (FAILED(d.device->CreateTexture2D(&sdesc, nullptr, &staging))) {
+            result = std::string(k.name) + ": no staging texture";
+        } else {
+            UINT slice = k.slices > 1 ? 1 : 0;
+            d.context->CopySubresourceRegion(staging, 0, 0, 0, 0, texture, D3D11CalcSubresource(0, slice, k.mips),
+                                             nullptr);
+            D3D11_MAPPED_SUBRESOURCE mapped;
+            if (FAILED(d.context->Map(staging, 0, D3D11_MAP_READ, 0, &mapped))) {
+                result = std::string(k.name) + ": the copy does not map";
+            } else {
+                uint8_t c[4];
+                colorOf(cycle, kind, c);
+                bool same;
+                char seen[64];
+                if (k.format == DXGI_FORMAT_R16G16B16A16_FLOAT) {
+                    const uint16_t *p = static_cast<const uint16_t *>(mapped.pData);
+                    same = p[0] == halfOf(c[0] / 256.0f) && p[1] == halfOf(c[1] / 256.0f) &&
+                           p[2] == halfOf(c[2] / 256.0f);
+                    std::snprintf(seen, sizeof(seen), "%04x %04x %04x", p[0], p[1], p[2]);
+                } else {
+                    const uint8_t *p = static_cast<const uint8_t *>(mapped.pData);
+                    bool bgra = k.format == DXGI_FORMAT_B8G8R8A8_UNORM;
+                    uint8_t r = bgra ? p[2] : p[0], b = bgra ? p[0] : p[2];
+                    same = r == c[0] && p[1] == c[1] && b == c[2];
+                    std::snprintf(seen, sizeof(seen), "%u %u %u, want %u %u %u", r, p[1], b, c[0], c[1], c[2]);
+                }
+                d.context->Unmap(staging, 0);
+                if (!same)
+                    result = std::string(k.name) + " has another color: " + seen;
+            }
+            staging->Release();
+        }
+    }
+    if (mutex) {
+        mutex->ReleaseSync(0);
+        mutex->Release();
+    }
+    texture->Release();
+    return result;
+}
+
+int child() {
+    HANDLE in = GetStdHandle(STD_INPUT_HANDLE), out = GetStdHandle(STD_OUTPUT_HANDLE);
+    Device d;
+    if (!d.create())
+        return 1;
+    HANDLE event = CreateEventW(nullptr, FALSE, FALSE, nullptr);
+    for (;;) {
+        std::string line = readLine(in);
+        if (line == "quit" || line == "eof")
+            break;
+        // "cycle N W H HANDLE*kKinds FENCE" or "forge W H HANDLE"
+        std::vector<std::string> words;
+        size_t start = 0;
+        while (start < line.size()) {
+            size_t end = line.find(' ', start);
+            if (end == std::string::npos)
+                end = line.size();
+            words.push_back(line.substr(start, end - start));
+            start = end + 1;
+        }
+        auto handleAt = [&](size_t i) {
+            return reinterpret_cast<HANDLE>(static_cast<uintptr_t>(std::strtoull(words[i].c_str(), nullptr, 16)));
+        };
+        if (words.size() == 4 && words[0] == "forge") {
+            UINT width = std::atoi(words[1].c_str()), height = std::atoi(words[2].c_str());
+            ID3D11Texture2D *texture = nullptr;
+            HANDLE handle = handleAt(3);
+            HRESULT hr = d.device1->OpenSharedResource1(handle, IID_PPV_ARGS(&texture));
+            CloseHandle(handle);
+            std::string reply = "ok";
+            if (SUCCEEDED(hr) && texture) {
+                D3D11_TEXTURE2D_DESC got;
+                texture->GetDesc(&got);
+                char text[128];
+                std::snprintf(text, sizeof(text), "the handle of a released %ux%u texture opened as %ux%u", width,
+                              height, got.Width, got.Height);
+                reply = text;
+                texture->Release();
+            }
+            writeLine(out, reply);
+            continue;
+        }
+        if (words.size() != 4 + kKinds + 1 || words[0] != "cycle") {
+            writeLine(out, "bad command: " + line);
+            continue;
+        }
+        unsigned cycle = std::strtoul(words[1].c_str(), nullptr, 10);
+        UINT width = std::atoi(words[2].c_str()), height = std::atoi(words[3].c_str());
+        std::string reply = "ok";
+        for (int kind = 0; kind < kKinds; kind++) {
+            std::string r = openAndCheck(d, kind, cycle, handleAt(4 + kind), width, height);
+            if (r != "ok" && reply == "ok")
+                reply = r;
+        }
+        ID3D11Fence *fence = nullptr;
+        HANDLE fenceHandle = handleAt(4 + kKinds);
+        HRESULT hr = d.device5->OpenSharedFence(fenceHandle, IID_PPV_ARGS(&fence));
+        CloseHandle(fenceHandle);
+        if (FAILED(hr) || !fence) {
+            if (reply == "ok")
+                reply = "ok unopened";
+        } else {
+            if (!waitFence(fence, 1, event)) {
+                if (reply == "ok")
+                    reply = "the fence never reached 1";
+            }
+            d.context4->Signal(fence, 2);
+            d.context->Flush();
+            fence->Release();
+        }
+        d.context->Flush();
+        writeLine(out, reply);
+    }
+    CloseHandle(event);
+    return 0;
+}
+
+// --- the first process ----------------------------------------------------------------------------------------
+
+struct Child {
+    PROCESS_INFORMATION process = {};
+    HANDLE toChild = nullptr, fromChild = nullptr;
+
+    bool start() {
+        SECURITY_ATTRIBUTES sa = {sizeof(sa), nullptr, TRUE};
+        HANDLE childIn = nullptr, childOut = nullptr;
+        if (!CreatePipe(&childIn, &toChild, &sa, 0) || !CreatePipe(&fromChild, &childOut, &sa, 0))
+            return fail("CreatePipe");
+        SetHandleInformation(toChild, HANDLE_FLAG_INHERIT, 0);
+        SetHandleInformation(fromChild, HANDLE_FLAG_INHERIT, 0);
+        wchar_t path[MAX_PATH];
+        GetModuleFileNameW(nullptr, path, MAX_PATH);
+        std::wstring command = std::wstring(L"\"") + path + L"\" --child";
+        STARTUPINFOW si = {};
+        si.cb = sizeof(si);
+        si.dwFlags = STARTF_USESTDHANDLES;
+        si.hStdInput = childIn;
+        si.hStdOutput = childOut;
+        si.hStdError = GetStdHandle(STD_ERROR_HANDLE);
+        BOOL ok = CreateProcessW(nullptr, &command[0], nullptr, nullptr, TRUE, 0, nullptr, nullptr, &si, &process);
+        CloseHandle(childIn);
+        CloseHandle(childOut);
+        if (!ok)
+            return fail("CreateProcess of the second process");
+        return true;
+    }
+
+    HANDLE give(HANDLE handle) {
+        HANDLE theirs = nullptr;
+        DuplicateHandle(GetCurrentProcess(), handle, process.hProcess, &theirs, 0, FALSE, DUPLICATE_SAME_ACCESS);
+        return theirs;
+    }
+
+    ~Child() {
+        if (toChild) {
+            writeLine(toChild, "quit");
+            CloseHandle(toChild);
+        }
+        if (process.hProcess) {
+            WaitForSingleObject(process.hProcess, 5000);
+            CloseHandle(process.hProcess);
+            CloseHandle(process.hThread);
+        }
+        if (fromChild)
+            CloseHandle(fromChild);
+    }
+};
+
+void waitForFile(const std::string &signal, const char *stage) {
+    std::printf("shared_churn: measure %s\n", stage);
+    std::fflush(stdout);
+    if (signal.empty())
+        return;
+    std::string path = signal + "." + stage;
+    for (int i = 0; i < 3000; i++) {
+        if (GetFileAttributesA(path.c_str()) != INVALID_FILE_ATTRIBUTES)
+            return;
+        Sleep(10);
+    }
+}
