+# cranvr: structs that a virtual method of an OpenVR interface returns by value, and that do not fit in a
+# register. MSVC passes `this` first and the address of the returned struct second, and a game is built by
+# MSVC. GCC builds MinGW's code the other way round, so such a method would write its result over the
+# object. The methods take the address as a parameter and return it instead, which is the same code on
+# both sides. stubs/codegen.py gives a game the same methods and the FnTable the original ones.
+STRUCT_RETURNS = ("HmdMatrix34_t", "HmdMatrix44_t", "HiddenAreaMesh_t", "HmdColor_t", "DistortionCoordinates_t")
+_struct_return = re.compile(r"(virtual\s+)(" + "|".join(STRUCT_RETURNS) + r")(\s+)(\w+)\(\s*(\)?)")
+
+
+def struct_returns_by_pointer(text):
