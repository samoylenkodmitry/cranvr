+/******************************************************************************
+ * DwmGetDxSharedSurface [USER32.@]
+ *
+ * Gives the shared surface that DWM composes a window from. Wine has no DWM, so no window has one.
+ */
+BOOL WINAPI DwmGetDxSharedSurface( HWND hwnd, HANDLE *surface, LUID *adapter_luid, ULONG *format,
+                                   ULONG *present_flags, ULONGLONG *update_id )
+{
+    FIXME( "(%p, %p, %p, %p, %p, %p) stub\n", hwnd, surface, adapter_luid, format, present_flags, update_id );
+    SetLastError( ERROR_CALL_NOT_IMPLEMENTED );
+    return FALSE;
+}
