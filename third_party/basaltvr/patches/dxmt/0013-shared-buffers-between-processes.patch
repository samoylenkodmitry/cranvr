Subject: [PATCH] d3d11: buffers that processes share (cranvr)

SteamVR's compositor makes a constant buffer with D3D11_RESOURCE_MISC_SHARED and stops at start when the buffer
has no shared handle ("Failed to create shared frame info constant buffer"). DXMT shared textures only. A buffer
with the flag now lies on the memory of a named file mapping. A kernel allocation carries the mapping's name, the
buffer's description and its size, so another process opens the same memory with OpenSharedResource. Such a buffer
has no dynamic renames, because a rename would move it off the shared memory.
---
diff --git a/src/d3d11/d3d11_buffer.cpp b/src/d3d11/d3d11_buffer.cpp
index 1269d63..34b879e 100644
--- a/src/d3d11/d3d11_buffer.cpp
+++ b/src/d3d11/d3d11_buffer.cpp
@@ -4,6 +4,8 @@
 #include "dxmt_dynamic.hpp"
 #include "dxmt_format.hpp"
 #include "d3d11_resource.hpp"
+#include "d3d11_shared_buffer.hpp"
+#include "log/log.hpp"
 
 namespace dxmt {
 
@@ -24,6 +26,40 @@ private:
   bool allow_raw_view;
 
   Rc<DynamicBuffer> dynamic_;
+  /* cranvr: a buffer shared with D3D11_RESOURCE_MISC_SHARED (see d3d11_shared_buffer.hpp) */
+  SharedBufferMemory shared_;
+  D3DKMT_HANDLE local_kmt_ = 0;
+  D3DKMT_HANDLE global_kmt_ = 0;
+
+  /* The shared path of the constructor: the buffer lies on the memory of a file mapping. `imported` is the memory
+   * of a buffer that another process shared, else the buffer makes its own. False when it fails: the buffer then
+   * takes the ordinary path, unshared. */
+  bool
+  InitShared(const D3D11_BUFFER_DESC *pDesc, const D3D11_SUBRESOURCE_DATA *pInitialData, MTLD3D11Device *device,
+             const SharedBufferMemory *imported, D3DKMT_HANDLE importedGlobal) {
+    SharedBufferData data;
+    if (imported) {
+      shared_ = *imported;
+    } else if (!MakeSharedBufferMemory(*pDesc, data, shared_)) {
+      ERR("D3D11Buffer: no file mapping for a shared buffer of ", pDesc->ByteWidth, " bytes");
+      return false;
+    }
+    buffer_ = new Buffer(pDesc->ByteWidth, device->GetMTLDevice());
+    Flags<BufferAllocationFlag> flags;
+    auto allocation = buffer_->allocatePlaced(flags, shared_.view, shared_.size);
+    if (pInitialData)
+      memcpy(shared_.view, pInitialData->pSysMem, pDesc->ByteWidth);
+    auto _ = buffer_->rename(std::move(allocation));
+    structured = pDesc->MiscFlags & D3D11_RESOURCE_MISC_BUFFER_STRUCTURED;
+    allow_raw_view = pDesc->MiscFlags & D3D11_RESOURCE_MISC_BUFFER_ALLOW_RAW_VIEWS;
+    // No dynamic buffer: its renames would move the buffer off the shared memory
+    if (imported) {
+      global_kmt_ = importedGlobal;
+    } else if (!ShareBuffer(device, data, &local_kmt_, &global_kmt_)) {
+      ERR("D3D11Buffer: no D3DKMT allocation for a shared buffer; it has no handle");
+    }
+    return true;
+  }
 
   using SRVBase = TResourceViewBase<tag_shader_resource_view<D3D11Buffer>>;
 
@@ -62,8 +98,15 @@ private:
   };
 
 public:
-  D3D11Buffer(const tag_buffer::DESC1 *pDesc, const D3D11_SUBRESOURCE_DATA *pInitialData, MTLD3D11Device *device) :
+  D3D11Buffer(
+      const tag_buffer::DESC1 *pDesc, const D3D11_SUBRESOURCE_DATA *pInitialData, MTLD3D11Device *device,
+      const SharedBufferMemory *imported = nullptr, D3DKMT_HANDLE importedGlobal = 0
+  ) :
       TResourceBase<tag_buffer>(*pDesc, device) {
+    if (((pDesc->MiscFlags & D3D11_RESOURCE_MISC_SHARED) && !(pDesc->MiscFlags & D3D11_RESOURCE_MISC_SHARED_NTHANDLE)) || imported) {
+      if (InitShared(pDesc, pInitialData, device, imported, importedGlobal))
+        return;
+    }
     buffer_ = new Buffer(pDesc->ByteWidth, device->GetMTLDevice());
     Flags<BufferAllocationFlag> flags;
     if (!m_parent->IsTraced() && pDesc->Usage == D3D11_USAGE_DYNAMIC)
@@ -100,6 +143,25 @@ public:
     }
   }
 
+  ~D3D11Buffer() {
+    if (local_kmt_) {
+      D3DKMT_DESTROYALLOCATION destroy = {};
+      destroy.hDevice = m_parent->GetLocalD3DKMT();
+      destroy.hResource = local_kmt_;
+      D3DKMTDestroyAllocation(&destroy);
+    }
+    if (shared_.mapping)
+      CloseHandle(shared_.mapping);
+  }
+
+  HRESULT
+  GetSharedHandle(HANDLE *pSharedHandle) override {
+    if (pSharedHandle == nullptr || (desc.MiscFlags & D3D11_RESOURCE_MISC_SHARED_NTHANDLE) || !global_kmt_)
+      return E_INVALIDARG;
+    *pSharedHandle = reinterpret_cast<HANDLE>(global_kmt_);
+    return S_OK;
+  }
+
   HRESULT
   STDMETHODCALLTYPE
   QueryInterface(REFIID riid, void **ppvObject) override {
@@ -296,6 +358,39 @@ public:
   }
 };
 
+/* cranvr: opens a buffer that another process shared (see d3d11_shared_buffer.hpp) */
+HRESULT
+ImportSharedBuffer(MTLD3D11Device *pDevice, HANDLE hResource, REFIID riid, void **ppResource) {
+  SharedBufferData data = {};
+  D3DDDI_OPENALLOCATIONINFO2 alloc = {};
+  D3DKMT_OPENRESOURCE open = {};
+  open.hDevice = pDevice->GetLocalD3DKMT();
+  open.hGlobalShare = static_cast<D3DKMT_HANDLE>(reinterpret_cast<uintptr_t>(hResource));
+  open.NumAllocations = 1;
+  open.pOpenAllocationInfo2 = &alloc;
+  open.pPrivateRuntimeData = &data;
+  open.PrivateRuntimeDataSize = sizeof(data);
+  if (D3DKMTOpenResource2(&open)) {
+    WARN("ImportSharedBuffer: Failed to open resource: ", hResource);
+    return E_INVALIDARG;
+  }
+  D3DKMT_DESTROYALLOCATION destroy = {};
+  destroy.hDevice = pDevice->GetLocalD3DKMT();
+  destroy.hResource = open.hResource;
+  D3DKMTDestroyAllocation(&destroy);
+  if (memcmp(data.magic, "dxmtbuf", 8)) {
+    WARN("ImportSharedBuffer: the handle names no shared buffer: ", hResource);
+    return E_INVALIDARG;
+  }
+  SharedBufferMemory memory;
+  if (!OpenSharedBufferMemory(data, memory)) {
+    WARN("ImportSharedBuffer: Failed to map the memory of the shared buffer: ", hResource);
+    return E_FAIL;
+  }
+  Com<D3D11Buffer> buffer = ref(new D3D11Buffer(&data.desc, nullptr, pDevice, &memory, open.hGlobalShare));
+  return buffer->QueryInterface(riid, ppResource);
+}
+
