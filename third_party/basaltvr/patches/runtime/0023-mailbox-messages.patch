@@ -1738,6 +1772,13 @@ void controlSessionCreatedWith(XrSession session, FrameSync* sync, const char* r
         return;
     }
     ReleaseSRWLockExclusive(&gControlLock);
+    // cranvr: the game's mailbox messages of the time without a daemon
+    AcquireSRWLockExclusive(&gMailboxLock);
+    const SOCKET socket = mailboxSocket();
+    if (socket != INVALID_SOCKET) {
+        sendHeldMailboxMessagesLocked(socket);
+    }
+    ReleaseSRWLockExclusive(&gMailboxLock);
 }
 
