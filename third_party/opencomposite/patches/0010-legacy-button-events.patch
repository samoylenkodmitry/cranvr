diff --git a/OpenOVR/Reimpl/BaseSystem.cpp b/OpenOVR/Reimpl/BaseSystem.cpp
index 60b5264..3c7edcb 100644
--- a/OpenOVR/Reimpl/BaseSystem.cpp
+++ b/OpenOVR/Reimpl/BaseSystem.cpp
@@ -548,6 +548,15 @@ void BaseSystem::_OnPostFrame()
 	if (inputSystem) {
 		inputSystem->InternalUpdate();
 	}
+
+	// cranvr: a game that reads the legacy controller state gets the button events of it, as SteamVR sends
+	// them. The OpenXR port stopped sending them, and a game that waits for VREvent_ButtonPress saw no press.
+	// Only a game whose legacy input is loaded gets them: a check before would load the empty manifest for a
+	// game that sets its own manifest a few frames in.
+	if (inputSystem && inputSystem->IsUsingLegacyInput()) {
+		CheckControllerEvents(leftHandIndex, lastLegacyState[0]);
+		CheckControllerEvents(rightHandIndex, lastLegacyState[1]);
+	}
 }
 
 void BaseSystem::_EnqueueEvent(const VREvent_t& e)
diff --git a/OpenOVR/Reimpl/BaseSystem.h b/OpenOVR/Reimpl/BaseSystem.h
