-    D3DKMT_ESCAPE escape = {};
-    escape.Type = D3DKMT_ESCAPE_UPDATE_RESOURCE_WINE;
-    escape.pPrivateDriverData = mach_port_name;
-    escape.PrivateDriverDataSize = sizeof(mach_port_name);
-    escape.hContext = local_kmt;
-    if (!D3DKMTEscape(&escape)) {
-      ERR("D3D11Fence: Failed to escape mach port for shared fence");
-      WMTBootstrapUnregister(mach_port_name);
+    // cranvr: DXMT stored the name in the sync object's private data with D3DKMT_ESCAPE_UPDATE_RESOURCE_WINE, which
+    // Wine 11.10 runs for resources only. Its check of the result was the wrong way round, so the fence went on
+    // without the name, and no other process could open it. The name now lives in a resource of the handle's bundle.
+    D3DKMT_CREATEALLOCATION allocation = {};
+    allocation.hDevice = device;
+    allocation.pPrivateRuntimeData = &data;
+    allocation.PrivateRuntimeDataSize = sizeof(data);
+    allocation.Flags.StandardAllocation = 1;
+    allocation.NumAllocations = 1;
+    D3DDDI_ALLOCATIONINFO2 allocationInfo = {};
+    allocation.pAllocationInfo2 = &allocationInfo;
+    D3DKMT_CREATESTANDARDALLOCATION standardAllocation = {};
+    allocation.pStandardAllocation = &standardAllocation;
+    standardAllocation.Type = D3DKMT_STANDARDALLOCATIONTYPE_EXISTINGHEAP;
+    allocation.Flags.ExistingSysMem = 1;
+    D3DDDI_ALLOCATIONINFO systemMem = {};
+    allocationInfo.pSystemMem = &systemMem;
+    allocation.Flags.CreateResource = 1;
+    allocation.Flags.CreateShared = 1;
+    allocation.Flags.NtSecuritySharing = 1;
+    if (D3DKMTCreateAllocation2(&allocation)) {
