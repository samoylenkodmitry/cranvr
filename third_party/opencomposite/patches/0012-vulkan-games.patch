+void VkCompositor::FreeResolveImage()
+{
+	if (resolveImage != VK_NULL_HANDLE)
+		vkDestroyImage(appDevice, resolveImage, nullptr);
+	if (resolveMemory != VK_NULL_HANDLE)
+		vkFreeMemory(appDevice, resolveMemory, nullptr);
+	resolveImage = VK_NULL_HANDLE;
+	resolveMemory = VK_NULL_HANDLE;
+}
+
+// cranvr: a multisampled game image goes through a single-sample image of the game's own format: a resolve needs
+// one format on both sides, and the swapchain image may have another one.
+void VkCompositor::CreateResolveImage(const vr::VRVulkanTextureData_t& tex)
+{
+	VkImageCreateInfo imageInfo = { VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO };
+	imageInfo.imageType = VK_IMAGE_TYPE_2D;
+	imageInfo.format = (VkFormat)tex.m_nFormat;
+	imageInfo.extent = { tex.m_nWidth, tex.m_nHeight, 1 };
+	imageInfo.mipLevels = 1;
+	imageInfo.arrayLayers = 1;
+	imageInfo.samples = VK_SAMPLE_COUNT_1_BIT;
+	imageInfo.tiling = VK_IMAGE_TILING_OPTIMAL;
+	imageInfo.usage = VK_IMAGE_USAGE_TRANSFER_SRC_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT;
+	imageInfo.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+	OOVR_FAILED_VK_ABORT(vkCreateImage(appDevice, &imageInfo, nullptr, &resolveImage));
+
+	VkMemoryRequirements requirements;
+	vkGetImageMemoryRequirements(appDevice, resolveImage, &requirements);
+	VkPhysicalDeviceMemoryProperties memory;
+	vkGetPhysicalDeviceMemoryProperties(appPhysicalDevice, &memory);
+	VkMemoryAllocateInfo allocateInfo = { VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO };
+	allocateInfo.allocationSize = requirements.size;
+	allocateInfo.memoryTypeIndex = UINT32_MAX;
+	for (uint32_t i = 0; i < memory.memoryTypeCount && allocateInfo.memoryTypeIndex == UINT32_MAX; i++) {
+		if ((requirements.memoryTypeBits & (1u << i)) && (memory.memoryTypes[i].propertyFlags & VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT))
+			allocateInfo.memoryTypeIndex = i;
+	}
+	if (allocateInfo.memoryTypeIndex == UINT32_MAX)
+		ERR("no device memory for the resolve image");
+	OOVR_FAILED_VK_ABORT(vkAllocateMemory(appDevice, &allocateInfo, nullptr, &resolveMemory));
+	OOVR_FAILED_VK_ABORT(vkBindImageMemory(appDevice, resolveImage, resolveMemory, 0));
+}
