+XrResult createVulkanSwapchainImages(
+    VulkanSession* session,
+    const XrSwapchainCreateInfo* createInfo,
+    VulkanSwapchainImages** imagesOutput,
+    uint32_t* iosurfaceIds) {
+    *imagesOutput = nullptr;
+    auto* images = static_cast<VulkanSwapchainImages*>(std::calloc(1, sizeof(VulkanSwapchainImages)));
+    if (images != nullptr) {
+        ::new (images) VulkanSwapchainImages();
+    }
+    if (images == nullptr) {
+        return XR_ERROR_OUT_OF_MEMORY;
+    }
+    images->session = session;
+    images->width = createInfo->width;
+    images->height = createInfo->height;
+    images->arraySize = createInfo->arraySize;
+    images->format = static_cast<VkFormat>(createInfo->format);
+    const VkImageUsageFlags usage = imageUsage(createInfo->usageFlags);
+    const VkImageCreateFlags flags =
+        (createInfo->usageFlags & XR_SWAPCHAIN_USAGE_MUTABLE_FORMAT_BIT) != 0 ? VK_IMAGE_CREATE_MUTABLE_FORMAT_BIT : 0;
+    bool ok = true;
+    for (uint32_t image = 0; image < kVulkanSwapchainImageCount && ok; ++image) {
+        if (createInfo->arraySize == 1) {
+            ok = createSurfaceImage(session, createInfo, usage, flags, images, &images->images[image],
+                                    &images->memory[image], &iosurfaceIds[image]);
+            continue;
+        }
+        // Two slices: a private image for the game, an IOSurface image for each slice
+        auto imageInfo = vkStruct<VkImageCreateInfo>(VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO);
+        imageInfo.flags = flags;
+        imageInfo.imageType = VK_IMAGE_TYPE_2D;
+        imageInfo.format = images->format;
+        imageInfo.extent = {createInfo->width, createInfo->height, 1};
+        imageInfo.mipLevels = 1;
+        imageInfo.arrayLayers = createInfo->arraySize;
+        imageInfo.samples = VK_SAMPLE_COUNT_1_BIT;
+        imageInfo.tiling = VK_IMAGE_TILING_OPTIMAL;
+        imageInfo.usage = usage;
+        imageInfo.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+        imageInfo.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+        ok = session->createImage(session->device, &imageInfo, nullptr, &images->images[image]) == VK_SUCCESS &&
+             bindMemory(session, images->images[image], &images->memory[image]);
+        for (uint32_t slice = 0; slice < createInfo->arraySize && ok; ++slice) {
+            ok = createSurfaceImage(session, createInfo, VK_IMAGE_USAGE_TRANSFER_DST_BIT | VK_IMAGE_USAGE_SAMPLED_BIT, 0,
+                                    images, &images->exports[image][slice],
+                                    &images->exportMemory[image][slice],
+                                    &iosurfaceIds[image * createInfo->arraySize + slice]);
+        }
+    }
+    if (!ok) {
+        destroyVulkanSwapchainImages(images);
+        return XR_ERROR_RUNTIME_FAILURE;
+    }
+    *imagesOutput = images;
+    return XR_SUCCESS;
+}
+
+void destroyVulkanSwapchainImages(VulkanSwapchainImages* images) {
+    if (images == nullptr) {
+        return;
+    }
+    VulkanSession* session = images->session;
+    for (uint32_t image = 0; image < kVulkanSwapchainImageCount; ++image) {
+        if (images->images[image] != VK_NULL_HANDLE) {
+            session->destroyImage(session->device, images->images[image], nullptr);
+        }
+        if (images->memory[image] != VK_NULL_HANDLE) {
+            session->freeMemory(session->device, images->memory[image], nullptr);
+        }
+        for (uint32_t slice = 0; slice < 2; ++slice) {
+            if (images->exports[image][slice] != VK_NULL_HANDLE) {
+                session->destroyImage(session->device, images->exports[image][slice], nullptr);
+            }
+            if (images->exportMemory[image][slice] != VK_NULL_HANDLE) {
+                session->freeMemory(session->device, images->exportMemory[image][slice], nullptr);
+            }
+        }
+    }
+    for (uint32_t index = 0; index < images->pooledCount; ++index) {
+        returnTexture(images->pooledTextures[index]);
+    }
+    std::free(images);
+}
+
+VkImage vulkanSwapchainImage(const VulkanSwapchainImages* images, uint32_t index) {
+    return images->images[index];
+}
+
+uint32_t vulkanSwapchainArraySize(const VulkanSwapchainImages* images) {
+    return images->arraySize;
+}
