-// Largest per-eye render target the runtime advertises, accepts for a
-// swapchain, or takes from the streamer's configured view size.
+// Largest per-eye view size the runtime recommends or takes from the
+// streamer's configured view size.
 constexpr uint32_t kMaxViewWidth = BASALT_CONTROL_MAX_VIEW_WIDTH;
 constexpr uint32_t kMaxViewHeight = BASALT_CONTROL_MAX_VIEW_HEIGHT;
 
+// cranvr: the largest swapchain image and image rect the runtime advertises and
+// accepts, twice the largest view in each axis. A game may render above the
+// recommended size: Serious Sam VR asks for 1.118 times it, and SteamVR-style
+// supersampling asks for more. The host composes from an image of any size,
+// because it samples the image in normalized coordinates into the encoder's own
+// frame. Up to twice the largest eye, its one bilinear tap per pixel still reads
+// every texel. An image at the limit takes 4128 x 4416 x 4 bytes, 73 MB: two
+// eyes of three images take 437 MB. The limit lies well under the 16384 of
+// Direct3D 11 and Metal textures. It does not follow the configured view size,
+// which shrinks with the game's render size, so a game that picks its own
+// resolution gets no lower limit than before.
+constexpr uint32_t kMaxImageWidth = 2 * kMaxViewWidth;
+constexpr uint32_t kMaxImageHeight = 2 * kMaxViewHeight;
+
 // ALVR's hashed path ID for /user/hand/right/input/system/click.
 constexpr uint64_t kAlvrRightSystemClickPathId = 0x19729bd97073d474ULL;
 
