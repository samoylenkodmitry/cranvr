+// cranvr: the quad of vs_fs with the texture's rows in the order that they have. A copy that converts the channel
+// order of a game's image (DrawQuad) must not turn the picture over: vs_fs does, for bounds that say so.
+psIn vs_plain(uint vI : SV_VERTEXID)
+{
+	psIn output;
+	output.tex = float2(vI&1,vI>>1);
+	output.pos = float4((output.tex.x-0.5f)*2,-(output.tex.y-0.5f)*2,0,1);
+	return output;
+}
