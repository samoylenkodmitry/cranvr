+bool controlSendMailboxMessage(const char* address, const char* message) {
+    const size_t addressLength = std::strlen(address);
+    const size_t messageLength = std::strlen(message);
+    // The type of the message takes two bytes of the length that the daemon accepts
+    constexpr size_t kCapacity = BASALT_CONTROL_MAX_MESSAGE_LENGTH - sizeof(uint16_t);
+    if (2 * sizeof(uint16_t) + addressLength + messageLength > kCapacity) {
+        note("cranvr: a mailbox message to %s has %zu bytes, more than the daemon takes: it is dropped\n", address, messageLength);
+        return false;
+    }
+    AcquireSRWLockShared(&gControlLock);
+    const SOCKET socket = gSocket != INVALID_SOCKET && !gReceiverFailed ? gSocket : INVALID_SOCKET;
+    ReleaseSRWLockShared(&gControlLock);
+    if (socket == INVALID_SOCKET) {
+        note("cranvr: no daemon is connected: a mailbox message to %s is dropped\n", address);
+        return false;
+    }
+    uint8_t payload[kCapacity];
+    MessageWriter writer(payload, sizeof(payload));
+    writer.u16(static_cast<uint16_t>(addressLength));
+    writer.bytes(address, addressLength);
+    writer.u16(static_cast<uint16_t>(messageLength));
+    writer.bytes(message, messageLength);
+    return writer.ok() && sendMessage(socket, BASALT_MSG_MAILBOX_MESSAGE, payload, writer.length());
+}
