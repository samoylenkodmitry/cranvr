+// The headset's frame period, from the control file's refresh rate. Read once:
+// a running game keeps its cadence. (An atomic, not a function-local static:
+// a guarded static would import libwinpthread-1.dll.)
+std::atomic<XrDuration> gDisplayPeriod{0};
+
+XrDuration displayPeriod() {
+    XrDuration period = gDisplayPeriod.load(std::memory_order_relaxed);
+    if (period == 0) {
+        period = 1'000'000'000LL / basalt::controlConfiguredRefreshHz();
+        gDisplayPeriod.store(period, std::memory_order_relaxed);
+    }
+    return period;
+}
