+      return E_FAIL;
+    }
+    objects.mutex = mutex.hKeyedMutex;
     event.signalValue(InitialValue);
-    auto fence = new MTLD3D11FenceImpl(pDevice, std::move(event), local_kmt, mach_port_name);
