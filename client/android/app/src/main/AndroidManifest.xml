<?xml version="1.0" encoding="utf-8"?>
<!--
    The app declares only what is its own. The activity, its launcher entry, the library name and
    the entries of the xr service come from the Cranpose Gradle plugin.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The sockets of the link to the host -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:supportsRtl="true">
        <!-- The Cranpose library declares this activity in full. It stands here because Android
             reads an alias only after the alias's activity. -->
        <activity android:name="dev.cranpose.android.CranposeActivity" />
        <!-- The entry for adb. Only a caller that holds DUMP may start it: the shell user of adb
             and the system. An app gets DUMP only when someone grants it with adb. The client
             takes launch arguments only from a launch through this entry (client/src/launch.rs),
             so another app cannot make it forget a paired Mac's key or link to another host. -->
        <activity-alias
            android:name="dev.cranvr.client.AdbStart"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:targetActivity="dev.cranpose.android.CranposeActivity">
            <!-- A start through an alias reads the native library's name from the alias's own
                 meta-data, both in Cranpose's loader and in NativeActivity. Without it the start
                 looks for the library "main" and fails. The Cranpose plugin names the library after
                 the crate cranvr-client. -->
            <meta-data
                android:name="android.app.lib_name"
                android:value="cranvr_client" />
        </activity-alias>
    </application>
</manifest>
