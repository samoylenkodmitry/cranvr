+/*
+ * cranvr: puts a shared texture without a keyed mutex into the order of the queues that hold it, so that another
+ * process's GPU waits for the writes that this device flushed (dxmt_shared_order.hpp). A keyed mutex orders its texture
+ * already (patch 0014). The creator submits the texture's initial contents now: a reader waits for that work too.
+ */
+static void
+OrderSharedTexture(MTLD3D11Device *pDevice, Texture *texture, const char (&unique_name)[54], UINT misc_flags,
+                   bool creator) {
+  if (misc_flags & D3D11_RESOURCE_MISC_SHARED_KEYEDMUTEX)
+    return;
+  char name[54];
+  memcpy(name, unique_name, sizeof(name));
+  name[sizeof(name) - 1] = 0;
+  if (!name[0])
+    return;
+  auto &queue = pDevice->GetDXMTDevice().queue();
+  auto order = queue.SharedOrder();
+  if (!order)
+    return;
+  uint64_t initial = creator ? queue.initializer.flushToWait() : 0;
+  texture->current()->order = SharedOrderTexture::Create(order, name, initial);
+}
