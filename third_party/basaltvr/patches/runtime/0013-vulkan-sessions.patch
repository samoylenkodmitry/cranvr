+bool isVulkanRuntimeOffered() {
+    // A file check only: the libraries load at the first Vulkan call
+    char path[MAX_PATH];
+    return SearchPathA(nullptr, "vulkan-1.dll", nullptr, MAX_PATH, path, nullptr) != 0 &&
+           SearchPathA(nullptr, "winemetal.dll", nullptr, MAX_PATH, path, nullptr) != 0;
+}
+
+const VkFormat* vulkanSwapchainFormats(uint32_t* count) {
+    *count = static_cast<uint32_t>(kSwapchainFormats.size());
+    return kSwapchainFormats.data();
+}
+
+bool isVulkanSwapchainFormat(int64_t format) {
+    for (VkFormat supported : kSwapchainFormats) {
+        if (format == static_cast<int64_t>(supported)) {
+            return true;
+        }
+    }
+    return false;
+}
