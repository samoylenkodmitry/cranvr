diff --git a/DrvOpenXR/XrController.cpp b/DrvOpenXR/XrController.cpp
index 361d51d..590a739 100644
--- a/DrvOpenXR/XrController.cpp
+++ b/DrvOpenXR/XrController.cpp
@@ -1,5 +1,7 @@
 #include "XrController.h"
 
+#include <atomic>
+
 // HACK: grab the pose from BaseInput
 #include "../OpenOVR/Misc/xrmoreutils.h"
 #include "../OpenOVR/Reimpl/BaseInput.h"
@@ -163,6 +165,17 @@ ITrackedDevice::TrackedDeviceType XrController::GetHand()
 
 void XrController::GetPose(vr::ETrackingUniverseOrigin origin, vr::TrackedDevicePose_t* pose, ETrackingStateType trackingState)
 {
+	// cranvr: the log tells when the source of a controller's pose changes. A game that gets no valid pose
+	// for a controller draws it at the origin, which is the floor. The count limits the lines.
+	static std::atomic<int> logLines{ 0 };
+	auto note = [&](int source, const char* what) {
+		if (source != lastPoseSource) {
+			lastPoseSource = source;
+			if (logLines++ < 60)
+				OOVR_LOGF("The %s controller's pose: %s", GetHand() == HAND_LEFT ? "left" : "right", what);
+		}
+	};
+
 	// Default to an invalid pose
 	ZeroMemory(pose, sizeof(*pose));
 	pose->bDeviceIsConnected = true;
@@ -170,8 +183,10 @@ void XrController::GetPose(vr::ETrackingUniverseOrigin origin, vr::TrackedDevice
 	pose->eTrackingResult = vr::TrackingResult_Running_OutOfRange;
 
 	BaseInput* input = GetUnsafeBaseInput();
-	if (input == nullptr)
+	if (input == nullptr) {
+		note(0, "the input system does not exist yet");
 		return;
+	}
 
 	// Lie and say the pose is valid if the actions haven't even been loaded yet.
 	// This is a workaround for games like DCS, which appear to require valid poses before
@@ -187,20 +202,24 @@ void XrController::GetPose(vr::ETrackingUniverseOrigin origin, vr::TrackedDevice
 	// Specifically use grip pose, since that's what InteractionProfile::GetGripToSteamVRTransform uses
 	GetBaseInput()->GetHandSpace(DeviceIndex(), space, false);
 
-	if (!space)
+	if (!space) {
+		note(1, input->AreActionsLoaded() ? "no action space (invalid)" : "the actions are not loaded yet (the pose says valid, with no position)");
 		return;
+	}
 
 	// Find the hand transform matrix, and include that
 	glm::mat4 transform = profile.GetGripToSteamVRTransform(GetHand());
 
 	if (xr_utils::PoseFromSpace(pose, space, origin, transform)) {
 		isPoseFromHandTracking = false;
+		note(2, "valid, from the runtime's grip pose action");
 		return;
 	}
 
 	// Fallback to pose from hand tracking if the controller one isn't valid
 	GetPoseFromHandTracking(input, pose);
 	isPoseFromHandTracking = true;
+	note(pose->bPoseIsValid ? 3 : 4, pose->bPoseIsValid ? "valid, from hand tracking (the grip pose action has no position)" : "invalid (the runtime has no grip pose and no hand)");
 }
 
 void XrController::GetPoseFromHandTracking(BaseInput* input, vr::TrackedDevicePose_t* pose)
