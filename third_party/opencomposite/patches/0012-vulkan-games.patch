+// cranvr: the same channels in a format of B8G8R8A8, which is all that cranvr's runtime offers. The bytes keep
+// their encoding: sRGB only for a game image that is sRGB. Float and 10-bit images hold linear light, which a blit
+// encodes into sRGB.
+static VkFormat bgra_of(VkFormat format)
+{
+	switch (format) {
+	case VK_FORMAT_R8G8B8A8_SRGB:
+	case VK_FORMAT_B8G8R8A8_SRGB:
+		return VK_FORMAT_B8G8R8A8_SRGB;
+	case VK_FORMAT_R8G8B8A8_UNORM:
+	case VK_FORMAT_B8G8R8A8_UNORM:
+		return VK_FORMAT_B8G8R8A8_UNORM;
+	default:
+		return VK_FORMAT_B8G8R8A8_SRGB;
+	}
+}
+
+static bool runtime_offers(int64_t format)
+{
+	uint32_t count = 0;
+	if (XR_FAILED(xrEnumerateSwapchainFormats(xr_session.get(), 0, &count, nullptr)))
+		return false;
+	std::vector<int64_t> formats(count);
+	if (XR_FAILED(xrEnumerateSwapchainFormats(xr_session.get(), count, &count, formats.data())))
+		return false;
+	return std::find(formats.begin(), formats.end(), format) != formats.end();
+}
