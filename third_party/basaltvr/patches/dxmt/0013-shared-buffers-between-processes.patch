+Rc<BufferAllocation>
+Buffer::allocatePlaced(Flags<BufferAllocationFlag> flags, void *memory, uint64_t length) {
+  WMTBufferInfo info;
+  info.memory.set(memory);
+  info.length = length;
+  info.options = WMTResourceHazardTrackingModeUntracked;
+  return new BufferAllocation(device_, info, flags);
+};
