+// cranvr: a pose `meters` ahead of a controller's aim pose, along its -Z, with the
+// velocity of that point of the controller.
+ControlControllerState aheadOfAim(const ControlControllerState& aim, float meters) {
+    ControlControllerState out = aim;
+    const XrVector3f offset = quaternionRotate(aim.poseInLocal.orientation, {0.0f, 0.0f, -meters});
+    out.poseInLocal.position = vectorSum(aim.poseInLocal.position, offset);
+    out.linearVelocity = vectorSum(aim.linearVelocity, vectorCrossProduct(aim.angularVelocity, offset));
+    return out;
+}
