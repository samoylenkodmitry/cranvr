diff --git a/RuntimeExtensions/XR_FB_display_refresh_rate.h b/RuntimeExtensions/XR_FB_display_refresh_rate.h
new file mode 100644
index 0000000..99f16c6
--- /dev/null
+++ b/RuntimeExtensions/XR_FB_display_refresh_rate.h
@@ -0,0 +1,12 @@
+// cranvr: the one function of XR_FB_display_refresh_rate that OpenComposite uses. The OpenXR SDK that
+// OpenComposite bundles (1.0.12) predates the extension. The names and values are the ones of the
+// Khronos registry (the extension is version 1).
+#pragma once
+
+#include <openxr/openxr.h>
+
+#ifndef XR_FB_display_refresh_rate
+#define XR_FB_display_refresh_rate 1
+#define XR_FB_DISPLAY_REFRESH_RATE_EXTENSION_NAME "XR_FB_display_refresh_rate"
+typedef XrResult(XRAPI_PTR* PFN_xrGetDisplayRefreshRateFB)(XrSession session, float* displayRefreshRate);
+#endif
