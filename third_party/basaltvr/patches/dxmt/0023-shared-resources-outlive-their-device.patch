     return container_->GetLocalD3DKMT();
   }
 
+  KmtDevice *STDMETHODCALLTYPE GetKmtDevice() override {
+    return container_->GetKmtDevice();
+  }
+
   HRESULT
   CreateGraphicsPipeline(MTL_GRAPHICS_PIPELINE_DESC *pDesc,
                          MTLCompiledGraphicsPipeline **ppPipeline) override {
@@ -1200,15 +1204,7 @@ public:
       if (D3DKMTCreateDevice(&create))
         WARN("Failed to create D3DKMT device");
       else
-        local_kmt_ = create.hDevice;
-    }
-  }
-
-  ~MTLD3D11DXGIDevice() {
-    if (local_kmt_) {
-      D3DKMT_DESTROYDEVICE destroy = {};
-      destroy.hDevice = local_kmt_;
-      D3DKMTDestroyDevice(&destroy);
+        kmt_device_ = new KmtDevice(create.hDevice);
     }
   }
 
@@ -1351,11 +1347,13 @@ public:
                                  ppSwapChain);
   }
 
-  D3DKMT_HANDLE STDMETHODCALLTYPE GetLocalD3DKMT() final { return local_kmt_; }
+  D3DKMT_HANDLE STDMETHODCALLTYPE GetLocalD3DKMT() final { return kmt_device_ ? kmt_device_->handle() : 0; }
+
+  KmtDevice *STDMETHODCALLTYPE GetKmtDevice() final { return kmt_device_.ptr(); }
 
 private:
   Com<IMTLDXGIAdapter> adapter_;
-  D3DKMT_HANDLE local_kmt_ = 0;
+  Rc<KmtDevice> kmt_device_;
   std::unique_ptr<Device> device;
   CommandQueue &cmd_queue_;
   MTLD3D11DeviceImpl d3d11_device_;
