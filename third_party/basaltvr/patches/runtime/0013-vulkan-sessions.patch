+};
+
+struct VulkanSwapchainImages {
+    VulkanSession* session = nullptr;
+    uint32_t width = 0;
+    uint32_t height = 0;
+    uint32_t arraySize = 1;
+    VkFormat format = VK_FORMAT_UNDEFINED;
+    // The images that the game renders into: on IOSurfaces for one slice, private for two
+    std::array<VkImage, kVulkanSwapchainImageCount> images{};
+    std::array<VkDeviceMemory, kVulkanSwapchainImageCount> memory{};
+    // For two slices: one IOSurface image per slice of each image
+    std::array<std::array<VkImage, 2>, kVulkanSwapchainImageCount> exports{};
+    std::array<std::array<VkDeviceMemory, 2>, kVulkanSwapchainImageCount> exportMemory{};
+    // The pool's textures that the images lie on
+    std::array<size_t, kVulkanSwapchainImageCount * 2> pooledTextures{};
+    uint32_t pooledCount = 0;
+};
