 IBackend::openvr_enum_t XrBackend::SetSkyboxOverride(const vr::Texture_t* pTextures, uint32_t unTextureCount)
 {
+	// cranvr: the runtime ends a frame with projection layers only, and this override is a quad layer. A game
+	// that sets a skybox (a loading screen, as the Unity plugin of SteamVR does) would have the frame refused, or,
+	// with a texture that has mip levels, stop here with "Cannot create DX texture swap chain". The override
+	// does nothing: the game goes on to submit its frames.
+	if (unTextureCount && pTextures) {
+		static bool logged = false;
+		if (!logged) {
+			logged = true;
+			OOVR_LOG("Ignoring the skybox override: the runtime has no quad layers");
+		}
+		return 0;
+	}
+
 	// Needed for rFactor2 loading screens
 	if (unTextureCount && pTextures) {
 		CheckOrInitCompositors(pTextures);
