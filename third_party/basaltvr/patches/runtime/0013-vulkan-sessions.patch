+    XrInstance instance, XrSystemId systemId, uint32_t capacity, uint32_t* countOutput, char* buffer) {
+    const XrResult check = checkInstanceAndSystem(instance, systemId, false);
+    return XR_FAILED(check) ? check : writeExtensionList(capacity, countOutput, buffer);
+}
