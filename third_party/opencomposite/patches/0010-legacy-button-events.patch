+++ b/OpenOVR/Reimpl/BaseSystem.h
@@ -32,6 +32,9 @@ private:
 
 	uint64_t frameNumber = 0;
 
+	// cranvr: the legacy controller state of each hand at the last frame, for its button events
+	vr::VRControllerState_t lastLegacyState[2] = {};
+
 public:
 	// To be called by other base classes
 	void _OnPostFrame();
