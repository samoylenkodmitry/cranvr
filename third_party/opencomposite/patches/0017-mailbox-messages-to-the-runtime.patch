diff --git i/RuntimeExtensions/XR_CRANVR_mailbox.h w/RuntimeExtensions/XR_CRANVR_mailbox.h
new file mode 100644
index 0000000..a4e85d5
--- /dev/null
+++ w/RuntimeExtensions/XR_CRANVR_mailbox.h
@@ -0,0 +1,14 @@
+// cranvr: XR_CRANVR_mailbox, an extension of cranvr's OpenXR runtime (BasaltVR with cranvr's patches). A game sends
+// messages to SteamVR through OpenVR's IVRMailbox, such as what its loading screen shows. OpenComposite hands each
+// message to the runtime, which passes it to cranvr-host unchanged. The host knows what a game's messages mean.
+#pragma once
+
+#include <openxr/openxr.h>
+
+#ifndef XR_CRANVR_mailbox
+#define XR_CRANVR_mailbox 1
+#define XR_CRANVR_MAILBOX_EXTENSION_NAME "XR_CRANVR_mailbox"
+// `address` is the mailbox that the message goes to, such as "game/interstitials". `message` is the message as the game
+// sent it. Both are UTF-8 text.
+typedef XrResult(XRAPI_PTR* PFN_xrSendMailboxMessageCRANVR)(XrInstance instance, const char* address, const char* message);
+#endif
