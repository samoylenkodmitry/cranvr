+std::string hex(uintptr_t value) {
+    char text[32];
+    std::snprintf(text, sizeof(text), "%llx", static_cast<unsigned long long>(value));
+    return text;
+}
+
+void waitForFile(const std::string &signal, const char *stage);
+
+unsigned fencesUnopened = 0; // the cycles whose fence the second process could not open
+
+bool cycleOnce(Device &d, Child &c, unsigned cycle, UINT width, UINT height, HANDLE event, const std::string *live) {
+    ID3D11Texture2D *textures[kKinds] = {};
+    HANDLE ntHandles[kKinds] = {};
+    std::string command = "cycle " + std::to_string(cycle) + " " + std::to_string(width) + " " + std::to_string(height);
+    bool ok = true;
+    for (int kind = 0; kind < kKinds && ok; kind++) {
+        const KindInfo &k = kKindInfo[kind];
+        D3D11_TEXTURE2D_DESC desc = descOf(kind, width, height);
+        HRESULT hr = d.device->CreateTexture2D(&desc, nullptr, &textures[kind]);
+        if (FAILED(hr)) {
+            ok = fail((std::string("CreateTexture2D ") + k.name).c_str(), hr);
+            break;
+        }
+        IDXGIKeyedMutex *mutex = nullptr;
+        if (kind == kKeyed && (FAILED(textures[kind]->QueryInterface(IID_PPV_ARGS(&mutex))) ||
+                               FAILED(mutex->AcquireSync(0, kWaitMs)))) {
+            ok = fail("keyed mutex of the first process");
+            break;
+        }
+        if (k.samples == 1) {
+            uint8_t color[4];
+            colorOf(cycle, kind, color);
+            float rgba[4] = {color[0] / 256.0f, color[1] / 256.0f, color[2] / 256.0f, 1.0f};
+            if (k.format != DXGI_FORMAT_R16G16B16A16_FLOAT) {
+                for (int i = 0; i < 3; i++)
+                    rgba[i] = color[i] / 255.0f;
+            }
+            for (UINT slice = 0; slice < k.slices; slice++) {
+                D3D11_RENDER_TARGET_VIEW_DESC rtv = {};
+                rtv.Format = k.format;
+                if (k.slices > 1) {
+                    rtv.ViewDimension = D3D11_RTV_DIMENSION_TEXTURE2DARRAY;
+                    rtv.Texture2DArray.FirstArraySlice = slice;
+                    rtv.Texture2DArray.ArraySize = 1;
+                } else {
+                    rtv.ViewDimension = D3D11_RTV_DIMENSION_TEXTURE2D;
+                }
+                ID3D11RenderTargetView *view = nullptr;
+                if (FAILED(hr = d.device->CreateRenderTargetView(textures[kind], &rtv, &view))) {
+                    ok = fail((std::string("CreateRenderTargetView ") + k.name).c_str(), hr);
+                    break;
+                }
+                d.context->ClearRenderTargetView(view, rgba);
+                view->Release();
+            }
+        }
+        if (mutex) {
+            mutex->ReleaseSync(1);
+            mutex->Release();
+        }
+        HANDLE handle = nullptr;
+        if (k.nt) {
+            IDXGIResource1 *resource = nullptr;
+            hr = textures[kind]->QueryInterface(IID_PPV_ARGS(&resource));
+            if (SUCCEEDED(hr))
+                hr = resource->CreateSharedHandle(nullptr, DXGI_SHARED_RESOURCE_READ | DXGI_SHARED_RESOURCE_WRITE,
+                                                  nullptr, &ntHandles[kind]);
+            release(resource);
+            handle = SUCCEEDED(hr) ? c.give(ntHandles[kind]) : nullptr;
+        } else {
+            IDXGIResource *resource = nullptr;
+            hr = textures[kind]->QueryInterface(IID_PPV_ARGS(&resource));
+            if (SUCCEEDED(hr))
+                hr = resource->GetSharedHandle(&handle);
+            release(resource);
+        }
+        if (FAILED(hr) || !handle) {
+            ok = fail((std::string("shared handle of ") + k.name).c_str(), hr);
+            break;
+        }
+        command += " " + hex(reinterpret_cast<uintptr_t>(handle));
+    }
+    ID3D11Fence *fence = nullptr;
+    HANDLE fenceHandle = nullptr;
+    if (ok) {
+        HRESULT hr = d.device5->CreateFence(0, D3D11_FENCE_FLAG_SHARED, IID_PPV_ARGS(&fence));
+        if (SUCCEEDED(hr))
+            hr = fence->CreateSharedHandle(nullptr, GENERIC_ALL, nullptr, &fenceHandle);
+        if (FAILED(hr))
+            ok = fail("shared fence", hr);
+    }
+    if (ok) {
+        command += " " + hex(reinterpret_cast<uintptr_t>(c.give(fenceHandle)));
+        d.context4->Signal(fence, 1);
+        d.context->Flush();
+        writeLine(c.toChild, command);
+        std::string reply = readLine(c.fromChild);
+        if (reply == "ok unopened")
+            fencesUnopened++;
+        else if (reply != "ok")
+            ok = fail(("cycle " + std::to_string(cycle) + ": " + reply).c_str());
+        else if (!waitFence(fence, 2, event))
+            ok = fail("the fence never reached 2: the second process's signal does not arrive");
+        if (ok && live)
+            waitForFile(*live, "live");
+    }
+    release(fence);
+    if (fenceHandle)
+        CloseHandle(fenceHandle);
+    for (int kind = 0; kind < kKinds; kind++) {
+        release(textures[kind]);
+        if (ntHandles[kind])
+            CloseHandle(ntHandles[kind]);
+    }
+    d.context->Flush();
+    return ok;
+}
+
+uint32_t surfaceIdOf(ID3D11Texture2D *texture) {
+    uint32_t id = 0;
+    UINT size = sizeof(id);
+    if (FAILED(texture->GetPrivateData(kIOSurfaceIdGuid, &size, &id)))
+        return 0;
+    return id;
+}
+
+// The size check of the IOSurface path: the handle of a released texture whose ID names a surface of another size now
+bool forge(Device &d, Child &c, UINT height) {
+    const UINT releasedWidth = 300, newWidth = 400;
+    D3D11_TEXTURE2D_DESC scratchDesc = descOf(kBgra8, 64, 64);
+    scratchDesc.MiscFlags = 0;
+    ID3D11Texture2D *scratchTexture = nullptr;
+    ID3D11RenderTargetView *scratch = nullptr;
+    if (FAILED(d.device->CreateTexture2D(&scratchDesc, nullptr, &scratchTexture)) ||
+        FAILED(d.device->CreateRenderTargetView(scratchTexture, nullptr, &scratch)))
+        return fail("scratch texture for the size check");
+    scratchTexture->Release();
+    struct Scratch {
+        ID3D11RenderTargetView *view;
+        ~Scratch() { view->Release(); }
+    } keep{scratch};
+    for (int attempt = 0; attempt < 50; attempt++) {
+        D3D11_TEXTURE2D_DESC desc = descOf(kIOSurface, releasedWidth, height);
+        ID3D11Texture2D *texture = nullptr;
+        if (FAILED(d.device->CreateTexture2D(&desc, nullptr, &texture)))
+            return fail("CreateTexture2D for the size check");
+        uint32_t id = surfaceIdOf(texture);
+        IDXGIResource1 *resource = nullptr;
+        HANDLE handle = nullptr;
+        if (SUCCEEDED(texture->QueryInterface(IID_PPV_ARGS(&resource))))
+            resource->CreateSharedHandle(nullptr, DXGI_SHARED_RESOURCE_READ, nullptr, &handle);
+        release(resource);
+        texture->Release();
+        d.context->Flush();
+        if (!id || !handle)
+            return fail("the size check needs an IOSurface texture (DXMT_BASALT_IOSURFACE=1)");
+        // DXMT clears a new texture on the GPU and holds it until a later submission has finished: some work on a
+        // scratch texture moves the queue on
+        for (int i = 0; i < 10; i++) {
+            float black[4] = {0, 0, 0, 1};
+            d.context->ClearRenderTargetView(scratch, black);
+            d.context->Flush();
+            Sleep(5);
+        }
+        std::vector<ID3D11Texture2D *> others;
+        bool reused = false;
+        uint32_t seen = 0;
+        for (int i = 0; i < 16 && !reused; i++) {
+            D3D11_TEXTURE2D_DESC other = descOf(kIOSurface, newWidth, height);
+            ID3D11Texture2D *t = nullptr;
+            if (FAILED(d.device->CreateTexture2D(&other, nullptr, &t)))
+                break;
+            others.push_back(t);
+            seen = surfaceIdOf(t);
+            reused = seen == id;
+        }
+        if (attempt < 3)
+            std::printf("shared_churn: size check attempt %d: released ID %u, newest ID %u\n", attempt + 1, id, seen);
+        if (reused) {
+            writeLine(c.toChild, "forge " + std::to_string(releasedWidth) + " " + std::to_string(height) + " " +
+                                     hex(reinterpret_cast<uintptr_t>(c.give(handle))));
+            std::string reply = readLine(c.fromChild);
+            for (auto *t : others)
+                t->Release();
+            CloseHandle(handle);
+            if (reply != "ok")
+                return fail(("size check: " + reply).c_str());
+            std::printf("shared_churn: the released texture's ID %u named a %ux%u surface, and the second process "
+                        "refused it (attempt %d)\n",
+                        id, newWidth, height, attempt + 1);
+            return true;
+        }
+        for (auto *t : others)
+            t->Release();
+        CloseHandle(handle);
+        d.context->Flush();
+    }
+    std::printf("shared_churn: the size check did not run: macOS gave no new surface the ID of a released one\n");
+    return true;
+}
+
+} // namespace
+
+int main(int argc, char **argv) {
+    setvbuf(stdout, nullptr, _IONBF, 0);
+    unsigned cycles = 200;
+    UINT width = 640, height = 333;
+    std::string signal;
+    for (int i = 1; i < argc; i++) {
+        std::string arg = argv[i];
+        if (arg == "--child")
+            return child();
+        if (arg == "--cycles" && i + 1 < argc)
+            cycles = std::strtoul(argv[++i], nullptr, 10);
+        else if (arg == "--width" && i + 1 < argc)
+            width = std::atoi(argv[++i]);
+        else if (arg == "--height" && i + 1 < argc)
+            height = std::atoi(argv[++i]);
+        else if (arg == "--signal" && i + 1 < argc)
+            signal = argv[++i];
+        else {
+            std::printf("usage: shared_churn.exe [--cycles N] [--width W] [--height H] [--signal FILE]\n");
+            return 2;
+        }
+    }
+    if (cycles < 1 || width < 8 || height < 8)
+        return fail("bad arguments") ? 0 : 1;
+    Device d;
+    if (!d.create())
+        return 1;
+    Child c;
+    if (!c.start())
+        return 1;
+    HANDLE event = CreateEventW(nullptr, FALSE, FALSE, nullptr);
+    bool ok = cycleOnce(d, c, 0, width, height, event, &signal);
+    if (ok)
+        waitForFile(signal, "warm");
+    auto begin = std::chrono::steady_clock::now();
+    for (unsigned cycle = 1; ok && cycle < cycles; cycle++)
+        ok = cycleOnce(d, c, cycle, width, height, event, nullptr);
+    double ms = std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - begin).count();
+    if (ok)
+        waitForFile(signal, "churned");
+    if (ok)
+        ok = forge(d, c, height);
+    CloseHandle(event);
+    if (ok && fencesUnopened)
+        std::printf("shared_churn: the second process could not open the shared fence in %u of %u cycles\n",
+                    fencesUnopened, cycles);
+    if (ok)
+        std::printf("shared_churn: PASS %u cycles of %d shared textures and a shared fence across two processes, "
+                    "%.2f ms a cycle\n",
+                    cycles, static_cast<int>(kKinds), cycles > 1 ? ms / (cycles - 1) : 0.0);
+    return ok ? 0 : 1;
+}
