+/*
+ * cranvr: the order of the GPU work of two queues on a shared texture. dxmt_shared_order.hpp says why and how.
+ */
+#include "dxmt_shared_order.hpp"
+#include "dxmt_texture.hpp"
+#include "log/log.hpp"
+#include "util_env.hpp"
+#include "util_string.hpp"
+#include <windows.h>
+#include <algorithm>
+#include <cstdio>
+#include <string>
+#include <unordered_map>
+
+namespace dxmt {
+
+static_assert(
+    std::atomic<uint64_t>::is_always_lock_free && std::atomic<uint32_t>::is_always_lock_free,
+    "the shared memory of the order needs atomics without locks"
+);
+
+namespace {
+
+using steady = std::chrono::steady_clock;
+
+constexpr double kGapTimeoutMs = 100;
+
+double
+MicrosecondsSince(steady::time_point begin) {
+  return std::chrono::duration<double, std::micro>(steady::now() - begin).count();
+}
+
+void
+Raise(std::atomic<uint64_t> &value, uint64_t to) {
+  uint64_t old = value.load(std::memory_order_relaxed);
+  while (old < to && !value.compare_exchange_weak(old, to, std::memory_order_relaxed))
+    ;
+}
+
+std::wstring
+Wide(const std::string &text) {
+  return std::wstring(text.begin(), text.end());
+}
+
+std::string
+Hex(uint64_t value) {
+  char text[17];
+  std::snprintf(text, sizeof(text), "%016llx", static_cast<unsigned long long>(value));
+  return text;
+}
+
+std::string
+ProgressName(uint64_t queue) {
+  return "Local\\dxmt_order_queue_" + Hex(queue);
+}
+
+// The broker's names of a queue's events; they go with the queue or its process
+std::string
+EventName(uint64_t queue) {
+  return "DXMT_order_" + Hex(queue);
+}
+
+std::string
+InitializerEventName(uint64_t queue) {
+  return "DXMT_order_" + Hex(queue) + "_init";
+}
+
+/* The counter of all DXMT processes of the session: each commit of a queue with a shared texture takes a stamp */
+std::atomic<uint64_t> *
+Stamps() {
+  static std::atomic<uint64_t> *stamps = []() -> std::atomic<uint64_t> * {
+    HANDLE mapping =
+        CreateFileMappingW(INVALID_HANDLE_VALUE, nullptr, PAGE_READWRITE, 0, 4096, L"Local\\dxmt_order_stamps");
+    if (!mapping)
+      return nullptr;
+    // The view keeps the section for the life of the process
+    void *view = MapViewOfFile(mapping, FILE_MAP_ALL_ACCESS, 0, 0, 4096);
+    CloseHandle(mapping);
+    return static_cast<std::atomic<uint64_t> *>(view);
+  }();
+  return stamps;
+}
+
+SharedOrderProgress *
+MapProgress(uint64_t queue) {
+  HANDLE mapping = OpenFileMappingW(FILE_MAP_READ, FALSE, Wide(ProgressName(queue)).c_str());
+  if (!mapping)
+    return nullptr;
+  void *view = MapViewOfFile(mapping, FILE_MAP_READ, 0, 0, sizeof(SharedOrderProgress));
+  CloseHandle(mapping);
+  return static_cast<SharedOrderProgress *>(view);
+}
+
+WMT::Reference<WMT::SharedEvent>
+LookUpEvent(WMT::Device device, const std::string &name) {
+  mach_port_t port = 0;
+  if (!WMTBootstrapLookUp(name.c_str(), &port) || !port)
+    return {};
+  auto event = device.newSharedEventWithMachPort(port);
+  WMTMachPortDeallocate(port); // the event takes a right of its own
+  return event;
+}
+
+} // namespace
+
+/* Another queue, in this process or another one, as a reader sees it. Links live as long as the process. */
+class SharedOrderLink {
+public:
+  uint64_t queue = 0;
+  SharedOrderProgress *progress = nullptr;
+  WMT::Reference<WMT::SharedEvent> event;
+  WMT::Reference<WMT::SharedEvent> initializer_event;
+  bool initializer_tried = false; // under the registry's lock
+  HANDLE process = nullptr;       // null for a queue of this process
+  std::atomic<bool> dead = false;
+  std::atomic<uint64_t> reached = 0;             // a value that the event has reached
+  std::atomic<uint64_t> initializer_reached = 0; // the same for the initializer event
+  std::atomic<uint64_t> watch = 0;               // the newest value that a GPU of this process waits for
+  std::atomic<uint64_t> watch_initializer = 0;
+
+  /* Whether the queue's process has ended; asks the system, so the encode thread calls it only while it waits */
+  bool
+  Ended() {
+    if (dead.load(std::memory_order_relaxed))
+      return true;
+    if (process && WaitForSingleObject(process, 0) == WAIT_OBJECT_0) {
+      dead.store(true, std::memory_order_relaxed);
+      return true;
+    }
+    return false;
+  }
+};
+
+namespace {
+
+class Registry {
+public:
+  static Registry &
+  Get() {
+    static Registry *registry = new Registry();
+    return *registry;
+  }
+
+  /* The link of a queue; one that cannot be made is dead. A look-up through the broker may take up to a second when
+   * the other process hangs, so this runs once for each queue. */
+  SharedOrderLink *
+  Link(uint64_t queue, WMT::Device device) {
+    std::lock_guard<dxmt::mutex> lock(lock_);
+    auto found = links_.find(queue);
+    if (found != links_.end())
+      return found->second;
+    auto link = new SharedOrderLink();
+    link->queue = queue;
+    link->progress = MapProgress(queue);
+    if (link->progress) {
+      DWORD pid = link->progress->pid.load(std::memory_order_acquire);
+      if (pid != GetCurrentProcessId())
+        link->process = OpenProcess(SYNCHRONIZE, FALSE, pid);
+      if (pid == GetCurrentProcessId() || link->process)
+        link->event = LookUpEvent(device, EventName(queue));
+    }
+    if (!link->progress || !link->event)
+      link->dead.store(true);
+    links_[queue] = link;
+    return link;
+  }
+
+  /* A queue of this process: its events need no broker */
+  void
+  AddLocal(
+      uint64_t queue, WMT::Reference<WMT::SharedEvent> event, WMT::Reference<WMT::SharedEvent> initializer_event
+  ) {
+    std::lock_guard<dxmt::mutex> lock(lock_);
+    auto link = new SharedOrderLink();
+    link->queue = queue;
+    link->progress = MapProgress(queue);
+    link->event = std::move(event);
+    link->initializer_event = std::move(initializer_event);
+    link->initializer_tried = true;
+    if (!link->progress)
+      link->dead.store(true);
+    links_[queue] = link;
+  }
+
+  /* The initializer event of a link's queue, looked up the first time that a reader needs it */
+  WMT::SharedEvent
+  InitializerEvent(SharedOrderLink *link, WMT::Device device) {
+    std::lock_guard<dxmt::mutex> lock(lock_);
+    if (!link->initializer_tried) {
+      link->initializer_tried = true;
+      link->initializer_event = LookUpEvent(device, InitializerEventName(link->queue));
+    }
+    return link->initializer_event;
+  }
+
+private:
+  dxmt::mutex lock_;
+  std::unordered_map<uint64_t, SharedOrderLink *> links_;
+};
+
+/* A thread of each process. It ends the waits of the process's GPUs for a process that has gone. It also times the waits
+ * with DXMT_SHARED_ORDER_STATS=1. It lives until the process ends. */
+class Watch {
+public:
+  static Watch &
+  Get() {
+    static Watch *watch = new Watch();
+    return *watch;
+  }
+
+  void
+  Add(SharedOrderLink *link) {
+    std::unique_lock<dxmt::mutex> lock(lock_);
+    if (std::find(links_.begin(), links_.end(), link) == links_.end())
+      links_.push_back(link);
+    Start();
+  }
+
+  void
+  Time(WMT::SharedEvent event, uint64_t value, obj_handle_t listener) {
+    std::unique_lock<dxmt::mutex> lock(lock_);
+    if (timings_.size() >= MAXIMUM_WAIT_OBJECTS - 1)
+      return;
+    HANDLE handle;
+    if (!free_.empty()) {
+      handle = free_.back();
+      free_.pop_back();
+    } else if (!(handle = CreateEventW(nullptr, FALSE, FALSE, nullptr))) {
+      return;
+    }
+    timings_.push_back({handle, steady::now()});
+    MTLSharedEvent_setWin32EventAtValue(event, listener, handle, value);
+    Start();
+  }
+
+private:
+  struct Timing {
+    HANDLE event;
+    steady::time_point encoded;
+  };
+
+  void
+  Start() {
+    if (thread_)
+      return;
+    // The thread runs code of this DLL, so the DLL stays loaded
+    HMODULE self = nullptr;
+    GetModuleHandleExW(
+        GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_PIN, reinterpret_cast<LPCWSTR>(&Watch::Run),
+        &self
+    );
+    thread_ = CreateThread(nullptr, 0, &Watch::Run, this, 0, nullptr);
+  }
+
+  static DWORD WINAPI
+  Run(void *self) {
+    static_cast<Watch *>(self)->Loop();
+    return 0;
+  }
+
+  void
+  Loop() {
+    auto since = steady::now();
+    for (;;) {
+      std::vector<HANDLE> events;
+      {
+        std::unique_lock<dxmt::mutex> lock(lock_);
+        for (auto &timing : timings_)
+          events.push_back(timing.event);
+      }
+      if (events.empty()) {
+        Sleep(100);
+      } else {
+        DWORD got = WaitForMultipleObjects(events.size(), events.data(), FALSE, 100);
+        if (got < WAIT_OBJECT_0 + events.size()) {
+          std::unique_lock<dxmt::mutex> lock(lock_);
+          auto &timing = timings_[got - WAIT_OBJECT_0];
+          double us = MicrosecondsSince(timing.encoded);
+          timed_++;
+          timed_us_ += us;
+          timed_max_us_ = std::max(timed_max_us_, us);
+          free_.push_back(timing.event);
+          timings_.erase(timings_.begin() + (got - WAIT_OBJECT_0));
+        }
+      }
+      Check();
+      if (timed_ && std::chrono::duration<double>(steady::now() - since).count() >= 10) {
+        Logger::info(str::format(
+            "cranvr: shared order: in the last ", std::chrono::duration<double>(steady::now() - since).count(),
+            " s the values of ", timed_, " waits came ", timed_us_ / timed_, " us on average and ", timed_max_us_,
+            " us at most after the encode of the waiting command buffer"
+        ));
+        timed_ = 0;
+        timed_us_ = timed_max_us_ = 0;
+        since = steady::now();
+      }
+    }
+  }
+
+  /* Drops the links whose waits are over; sets the events of a process that has ended to the values that GPUs of this
+   * process wait for */
+  void
+  Check() {
+    std::vector<SharedOrderLink *> links;
+    {
+      std::unique_lock<dxmt::mutex> lock(lock_);
+      if (links_.empty() || std::chrono::duration<double, std::milli>(steady::now() - checked_).count() < 100)
+        return;
+      checked_ = steady::now();
+      links = links_;
+    }
+    for (auto link : links) {
+      uint64_t value = link->watch.load(std::memory_order_relaxed);
+      uint64_t initial = link->watch_initializer.load(std::memory_order_relaxed);
+      bool waiting = link->event.signaledValue() < value ||
+                     (initial && link->initializer_event && link->initializer_event.signaledValue() < initial);
+      if (waiting && link->Ended()) {
+        WARN(
+            "cranvr: shared order: the process of queue ", Hex(link->queue),
+            " ended before its GPU reached the value that a GPU of this process waits for; this process sets it"
+        );
+        link->event.signalValue(value);
+        if (initial && link->initializer_event)
+          link->initializer_event.signalValue(initial);
+        waiting = false;
+      }
+      if (!waiting) {
+        std::unique_lock<dxmt::mutex> lock(lock_);
+        // A wait encoded meanwhile raised a value: the next check looks again
+        if (link->watch.load(std::memory_order_relaxed) == value &&
+            link->watch_initializer.load(std::memory_order_relaxed) == initial)
+          links_.erase(std::remove(links_.begin(), links_.end(), link), links_.end());
+      }
+    }
+  }
+
+  dxmt::mutex lock_;
+  HANDLE thread_ = nullptr;
+  std::vector<SharedOrderLink *> links_;
+  steady::time_point checked_ = steady::now();
+  std::vector<Timing> timings_;
+  std::vector<HANDLE> free_;
+  uint64_t timed_ = 0;
+  double timed_us_ = 0, timed_max_us_ = 0;
+};
+
+} // namespace
+
+SharedOrderTexture *
+SharedOrderTexture::Create(SharedOrderQueue *queue, const char *unique_name, uint64_t initial) {
+  std::wstring name = Wide(std::string("Local\\dxmt_order_") + unique_name);
+  HANDLE mapping =
+      CreateFileMappingW(INVALID_HANDLE_VALUE, nullptr, PAGE_READWRITE, 0, sizeof(SharedOrderSection), name.c_str());
+  if (!mapping)
+    return nullptr;
+  auto section =
+      static_cast<SharedOrderSection *>(MapViewOfFile(mapping, FILE_MAP_ALL_ACCESS, 0, 0, sizeof(SharedOrderSection)));
+  if (!section) {
+    CloseHandle(mapping);
+    return nullptr;
+  }
+  for (unsigned i = 0; i < kSharedOrderSlots; i++) {
+    uint64_t free = 0;
+    auto &slot = section->slots[i];
+    if (!slot.queue.compare_exchange_strong(free, queue->Id(), std::memory_order_acq_rel))
+      continue;
+    // A freed slot holds zeros; the creator's initial contents come before the handle leaves the process
+    slot.initial.store(initial, std::memory_order_release);
+    uint32_t used = section->used.load(std::memory_order_relaxed);
+    while (used < i + 1 && !section->used.compare_exchange_weak(used, i + 1, std::memory_order_acq_rel))
+      ;
+    auto order = new SharedOrderTexture();
+    order->mapping_ = mapping;
+    order->section_ = section;
+    order->slot_ = i;
+    // The links of the queues that hold the texture already are made now, on the caller's thread
+    used = std::min(section->used.load(std::memory_order_acquire), kSharedOrderSlots);
+    for (unsigned j = 0; j < used; j++) {
+      uint64_t other = section->slots[j].queue.load(std::memory_order_acquire);
+      if (j != i && other && other != queue->Id())
+        order->known_[j] = {other, Registry::Get().Link(other, queue->Device())};
+    }
+    return order;
+  }
+  static bool told = false;
+  if (!std::exchange(told, true))
+    WARN("cranvr: shared order: all ", kSharedOrderSlots, " slots of a shared texture are taken: no order for one more");
+  UnmapViewOfFile(section);
+  CloseHandle(mapping);
+  return nullptr;
+}
+
+SharedOrderTexture::~SharedOrderTexture() {
+  // The allocation goes after its queue's GPU has finished every chunk that used it, so no reader owes it a wait now
+  auto &slot = section_->slots[slot_];
+  slot.written.store(0, std::memory_order_relaxed);
+  slot.previous.store(0, std::memory_order_relaxed);
+  slot.initial.store(0, std::memory_order_relaxed);
+  slot.queue.store(0, std::memory_order_release);
+  UnmapViewOfFile(section_);
+  CloseHandle(mapping_);
+}
+
+SharedOrderQueue *
+SharedOrderQueue::Create(
+    WMT::Device device, WMT::Reference<WMT::SharedEvent> event, WMT::Reference<WMT::SharedEvent> initializer_event,
+    obj_handle_t listener
+) {
+  static bool off = env::getEnvVar("DXMT_SHARED_ORDER") == "0";
+  if (off) {
+    static bool told = false;
+    if (!std::exchange(told, true))
+      WARN("cranvr: shared order: off (DXMT_SHARED_ORDER=0): another process may read a shared texture before its "
+           "writer's GPU wrote it");
+    return nullptr;
+  }
+  auto stamps = Stamps();
+  if (!stamps)
+    return nullptr;
+  // An ID that no other queue of the session has: the process, a count of this process's queues and the clock's low
+  // bits, for a process whose ID came back after an earlier process with sections that readers still map
+  static std::atomic<uint32_t> made = 0;
+  for (int attempt = 0; attempt < 8; attempt++) {
+    LARGE_INTEGER now;
+    QueryPerformanceCounter(&now);
+    uint64_t id = (static_cast<uint64_t>(GetCurrentProcessId()) << 32) |
+                  (static_cast<uint64_t>(made.fetch_add(1) & 0xffff) << 16) | (now.QuadPart & 0xffff);
+    HANDLE mapping = CreateFileMappingW(
+        INVALID_HANDLE_VALUE, nullptr, PAGE_READWRITE, 0, sizeof(SharedOrderProgress), Wide(ProgressName(id)).c_str()
+    );
+    if (!mapping)
+      return nullptr;
+    if (GetLastError() == ERROR_ALREADY_EXISTS) {
+      CloseHandle(mapping);
+      continue;
+    }
+    auto progress = static_cast<SharedOrderProgress *>(
+        MapViewOfFile(mapping, FILE_MAP_ALL_ACCESS, 0, 0, sizeof(SharedOrderProgress))
+    );
+    if (!progress) {
+      CloseHandle(mapping);
+      return nullptr;
+    }
+    progress->pid.store(GetCurrentProcessId(), std::memory_order_release);
+    // The broker serves both events while the queue lives; it takes rights of its own
+    bool served = true;
+    for (auto [served_event, name] :
+         {std::pair{event.handle, EventName(id)}, std::pair{initializer_event.handle, InitializerEventName(id)}}) {
+      mach_port_t port = MTLSharedEvent_createMachPort(served_event);
+      served = served && port && WMTBootstrapRegister(name.c_str(), port);
+      if (port)
+        WMTMachPortDeallocate(port);
+    }
+    if (!served) {
+      WMTBootstrapUnregister(EventName(id).c_str());
+      WMTBootstrapUnregister(InitializerEventName(id).c_str());
+      UnmapViewOfFile(progress);
+      CloseHandle(mapping);
+      ERR("cranvr: shared order: the queue's events cannot be served: no order for its shared textures");
+      return nullptr;
+    }
+    auto queue = new SharedOrderQueue();
+    queue->id_ = id;
+    queue->device_ = device;
+    queue->event_ = event;
+    queue->initializer_event_ = initializer_event;
+    queue->listener_ = listener;
+    queue->mapping_ = mapping;
+    queue->progress_ = progress;
+    queue->stamps_ = stamps;
+    queue->timing_ = env::getEnvVar("DXMT_SHARED_ORDER_STATS") == "1";
+    queue->waits_.reserve(16);
+    Registry::Get().AddLocal(id, event, initializer_event);
+    return queue;
+  }
+  return nullptr;
+}
+
+SharedOrderQueue::~SharedOrderQueue() {
+  Report(true);
+  // A reader that waits for chunks that the encode thread never got to goes on
+  progress_->closed.store(1, std::memory_order_release);
+  WMTBootstrapUnregister(EventName(id_).c_str());
+  WMTBootstrapUnregister(InitializerEventName(id_).c_str());
+  UnmapViewOfFile(progress_);
+  CloseHandle(mapping_);
+}
+
+uint64_t
+SharedOrderQueue::Commit(uint64_t chunk) {
+  uint64_t stamp = stamps_->fetch_add(1, std::memory_order_seq_cst) + 1;
+  auto &entry = progress_->ring[chunk % kSharedOrderRing];
+  entry.stamp.store(stamp, std::memory_order_relaxed);
+  entry.chunk.store(chunk, std::memory_order_release);
+  progress_->committed.store(chunk, std::memory_order_release);
+  return stamp;
+}
+
+void
+SharedOrderQueue::Publish(uint64_t chunk, uint64_t event) {
+  progress_->ordered_event.store(event, std::memory_order_release);
+  progress_->ordered.store(chunk, std::memory_order_release);
+}
+
+bool
+SharedOrderQueue::AwaitOrdered(SharedOrderLink *link, uint64_t stamp) {
+  auto progress = link->progress;
+  steady::time_point begin;
+  bool waited = false;
+  bool ended = false;
+  for (unsigned spin = 0;; spin++) {
+    if (progress->closed.load(std::memory_order_acquire))
+      break;
+    uint64_t ordered = progress->ordered.load(std::memory_order_acquire);
+    uint64_t committed = progress->committed.load(std::memory_order_acquire);
+    if (ordered >= committed)
+      break;
+    // The newest chunk of the other queue that it committed before this chunk
+    uint64_t need = 0;
+    for (uint64_t chunk = committed; chunk > ordered; chunk--) {
+      auto &entry = progress->ring[chunk % kSharedOrderRing];
+      uint64_t seen = entry.chunk.load(std::memory_order_acquire);
+      if (seen > chunk)
+        break; // a newer commit took the entry: this chunk and the older ones are done
+      if (seen < chunk || entry.stamp.load(std::memory_order_relaxed) < stamp) {
+        need = chunk;
+        break;
+      }
+    }
+    if (!need || progress->ordered.load(std::memory_order_acquire) >= need)
+      break;
+    if (!waited) {
+      waited = true;
+      begin = steady::now();
+    }
+    double us = MicrosecondsSince(begin);
+    if (us >= kGapTimeoutMs * 1000) {
+      stats_.timeouts++;
+      static bool told = false;
+      if (!std::exchange(told, true))
+        WARN(
+            "cranvr: shared order: queue ", Hex(link->queue), " did not get to its chunks within ", kGapTimeoutMs,
+            " ms; this command buffer may use a shared texture before the GPU work of those chunks"
+        );
+      break;
+    }
+    if (spin % 64 == 63 && link->Ended()) {
+      ended = true;
+      break;
+    }
+    if (us < 2000)
+      SwitchToThread();
+    else
+      Sleep(1);
+  }
+  if (waited) {
+    double us = MicrosecondsSince(begin);
+    stats_.gaps++;
+    stats_.gap_us += us;
+    stats_.gap_max_us = std::max(stats_.gap_max_us, us);
+  }
+  return !ended;
+}
+
+int
+SharedOrderQueue::WaitFor(SharedOrderLink *link, uint64_t stamp) {
+  for (unsigned i = 0; i < waits_.size(); i++) {
+    if (waits_[i].link == link)
+      return i;
+  }
+  stats_.checks++;
+  if (!AwaitOrdered(link, stamp))
+    return -1;
+  waits_.push_back({link, 0, 0});
+  return waits_.size() - 1;
+}
+
+void
+SharedOrderQueue::Encode(WMT::CommandBuffer cmdbuf, Wait &wait) {
+  auto link = wait.link;
+  if (wait.value > link->reached.load(std::memory_order_relaxed)) {
+    uint64_t now = link->event.signaledValue();
+    Raise(link->reached, now);
+    if (now < wait.value) {
+      cmdbuf.encodeWaitForEvent(link->event, wait.value);
+      stats_.waits++;
+      Raise(link->watch, wait.value);
+      Watch::Get().Add(link);
+      if (timing_)
+        Watch::Get().Time(link->event, wait.value, listener_);
+    }
+  }
+  if (wait.initial > link->initializer_reached.load(std::memory_order_relaxed)) {
+    WMT::SharedEvent initializer = Registry::Get().InitializerEvent(link, device_);
+    if (initializer) {
+      uint64_t now = initializer.signaledValue();
+      Raise(link->initializer_reached, now);
+      if (now < wait.initial) {
+        cmdbuf.encodeWaitForEvent(initializer, wait.initial);
+        stats_.waits++;
+        Raise(link->watch_initializer, wait.initial);
+        Watch::Get().Add(link);
+      }
+    }
+  }
+}
+
+void
+SharedOrderQueue::Order(
+    WMT::CommandBuffer cmdbuf, uint64_t chunk, uint64_t event, uint64_t stamp, std::vector<TextureAllocation *> &used
+) {
+  if (used.empty()) {
+    Publish(chunk, event);
+    return;
+  }
+  auto begin = steady::now();
+  stats_.chunks++;
+  for (TextureAllocation *allocation : used) {
+    auto order = allocation->order;
+    if (order->noted_write) {
+      auto &slot = order->section_->slots[order->slot_];
+      slot.previous.store(slot.written.load(std::memory_order_relaxed), std::memory_order_release);
+      slot.written.store(event, std::memory_order_release);
+    }
+  }
+  waits_.clear();
+  for (TextureAllocation *allocation : used) {
+    auto order = allocation->order;
+    auto section = order->section_;
+    unsigned count = std::min(section->used.load(std::memory_order_acquire), kSharedOrderSlots);
+    for (unsigned i = 0; i < count; i++) {
+      if (i == order->slot_)
+        continue;
+      auto &slot = section->slots[i];
+      uint64_t queue = slot.queue.load(std::memory_order_acquire);
+      if (!queue || queue == id_)
+        continue;
+      auto &known = order->known_[i];
+      if (known.queue != queue)
+        known = {queue, Registry::Get().Link(queue, device_)};
+      if (known.link->dead.load(std::memory_order_relaxed))
+        continue;
+      int index = WaitFor(known.link, stamp);
+      if (index < 0)
+        continue; // the other queue's process ended
+      // The newest write and the one before it, from one moment: the writer stores `previous` before `written`
+      uint64_t written, previous;
+      do {
+        written = slot.written.load(std::memory_order_acquire);
+        previous = slot.previous.load(std::memory_order_acquire);
+      } while (slot.written.load(std::memory_order_acquire) != written);
+      uint64_t initial = slot.initial.load(std::memory_order_acquire);
+      if (slot.queue.load(std::memory_order_acquire) != queue)
+        continue; // the slot was freed meanwhile: its queue's GPU had finished with the texture
+      // A write of a chunk whose order step still runs came after this chunk's commit. The write before it passed its
+      // order step: it covers every write that this chunk owes a wait
+      uint64_t ordered = known.link->progress->ordered_event.load(std::memory_order_acquire);
+      auto &wait = waits_[index];
+      wait.value = std::max(wait.value, written <= ordered ? written : previous);
+      wait.initial = std::max(wait.initial, initial);
+    }
+  }
+  if (!waits_.empty())
+    stats_.others++;
+  for (auto &wait : waits_)
+    Encode(cmdbuf, wait);
+  Publish(chunk, event);
+  double us = MicrosecondsSince(begin);
+  stats_.step_us += us;
+  stats_.step_max_us = std::max(stats_.step_max_us, us);
+  if (std::chrono::duration<double>(steady::now() - stats_.since).count() >= 10)
+    Report(false);
+}
+
+void
+SharedOrderQueue::Report(bool last) {
+  double seconds = std::chrono::duration<double>(steady::now() - stats_.since).count();
+  if (stats_.others) {
+    Logger::info(str::format(
+        "cranvr: shared order: queue ", Hex(id_), last ? " at its end" : "", ", in the last ", seconds, " s: ",
+        stats_.chunks, " command buffers used shared textures, ", stats_.others,
+        " of them textures that other queues hold (", stats_.checks, " looks at another queue); ", stats_.waits,
+        " waits encoded for another GPU; the step took ", stats_.step_us / stats_.chunks, " us on average and ",
+        stats_.step_max_us, " us at most; ", stats_.gaps, " waits for another queue's encode thread, ",
+        stats_.gaps ? stats_.gap_us / stats_.gaps : 0.0, " us on average and ", stats_.gap_max_us, " us at most; ",
+        stats_.timeouts, " of them timed out"
+    ));
+  }
+  stats_ = Stats();
+}
+
+} // namespace dxmt
diff --git c/src/dxmt/dxmt_shared_order.hpp i/src/dxmt/dxmt_shared_order.hpp
new file mode 100644
index 0000000..6373fc3
--- /dev/null
+++ i/src/dxmt/dxmt_shared_order.hpp
@@ -0,0 +1,205 @@
+#pragma once
+/*
+ * cranvr: the order of the GPU work of two queues on a shared texture (cranvr issue #177).
+ *
+ * Direct3D 11 asks a writer to call Flush before another device uses a resource that they share without a keyed
+ * mutex. After that the reader sees the writes. On Windows the GPU's scheduler keeps this order. Metal orders no work
+ * of two command queues on a texture. Two processes always have two queues. So the reader's GPU could copy a texture
+ * before the writer's GPU had run the clear that the writer flushed before it sent the handle. A keyed mutex orders
+ * its texture already (patch 0014). Such a texture takes no part here. The others do: the stock path
+ * (MTLSharedTextureHandle) and the IOSurface textures of patch 0019 that another DXMT process opens.
+ *
+ * How it works. Every command buffer of DXMT ends with a signal of its queue's shared event at the chunk's event
+ * value. Each queue that holds a shared texture serves that event through winemetal's broker (patch 0020). So another
+ * process can wait for it. A small section of shared memory has a slot for each queue that holds the texture. The
+ * texture's unique name names the section. A slot holds the event value of the queue's newest command buffer that
+ * wrote the texture. A queue that encodes a command buffer with the texture reads the slots of the other queues. Its
+ * GPU waits for those values before the first encoder of the command buffer. The reader's GPU waits only while the
+ * writer's GPU has not finished the write. No CPU waits for a GPU.
+ *
+ * The gap between a commit and the encode. A chunk's commands are recorded functions. The texture uses of a chunk
+ * become known only on the queue's encode thread, after Flush returned. A reader could look at the slot after the
+ * writer's Flush but before the writer's encode thread had written the slot. So each queue also publishes the chunks
+ * that it committed. It also publishes its newest chunk whose order step is done ("ordered"). A reader whose look
+ * falls in that gap waits on its encode thread for the writer's encode thread. The wait ends when the writer has run
+ * the order step of those chunks. That step comes right after the replay of the chunk's commands. Metal's encoding and
+ * a present's wait for a drawable come after it.
+ *
+ * Which chunks a reader owes a wait. A reader owes the writes of the chunks that the writer committed before the
+ * reader committed its own chunk: the writer's Flush came before the message that the reader acted on. Each commit
+ * takes a stamp from one counter of all DXMT processes of the session. A reader waits only for chunks with a smaller
+ * stamp than its own. So waits point back in one order. Two processes that read each other's textures cannot wait for
+ * each other. The GPU of a reader waits only for chunks that wrote the texture and passed their order step. The waits
+ * of those chunks are therefore fixed. The newest write in a slot may belong to a chunk whose order step still runs.
+ * That chunk came after the reader's chunk. The reader then waits for the write before it, which the slot keeps too.
+ * That write covers every write that the reader owes.
+ *
+ * Initial contents. DXMT clears a new texture, or fills it with its initial data, on a queue of its own (the resource
+ * initializer). The device's next chunk waits for that queue. The creator of a shared texture submits that work at
+ * once. It puts the initializer event's value into its slot. The broker serves the initializer event too.
+ *
+ * Cost. A queue without a shared texture pays nothing. A queue with one pays one atomic add on the shared counter and
+ * three stores at each commit. It pays two stores at each encode, plus two stores for each shared texture that the
+ * chunk wrote. A chunk that uses a shared texture of another queue reads a few words of shared memory. It asks the
+ * other queue's event for its value only when the value is new. It encodes a wait only when the other GPU has not
+ * reached the value. A game whose swapchain images only cranvr-host reads pays the stores alone.
+ *
+ * Why not other ways:
+ * - A shared event for each texture, signalled at the writer's flush: the flush does not know which textures its
+ *   chunk wrote (see the gap above). Each written texture would also cost a signal in the command buffer and a name in
+ *   the broker. The queue's own event costs neither.
+ * - Flush waits for the encode thread: the app's thread of every process with a shared texture would then wait for the
+ *   encode of its frame at each Flush, about a millisecond or more of each frame. Here the reader's encode thread
+ *   waits instead, only in the gap.
+ * - The reader waits on the writer's newest committed value in the gap: such a wait covers newer work of the writer
+ *   than the reader owes. Two processes that read each other's textures could also wait for each other's next chunk
+ *   for good.
+ * - The writer's CPU waits for its GPU before it shares: shared_churn.exe did that to hide the gap. It costs the
+ *   writer's CPU the writer's GPU time.
+ *
+ * What ends a wait. A writer's process may end before its GPU signals the value. A watch thread of the reader then
+ * sets the event to the value. A writer's queue that was destroyed marks its section closed: nothing of it is left to
+ * wait for. A writer's encode thread may not get to its chunk within 100 ms. The reader then goes on without those
+ * chunks and logs it once. No process sets the event of another process that lives: the writer's event queries read
+ * it.
+ *
+ * DXMT_SHARED_ORDER=0 turns the order off, for a comparison. DXMT_SHARED_ORDER_STATS=1 also times each wait that the
+ * GPU had not reached at the encode: the time from the encode to the other GPU's signal (an upper bound of the GPU's
+ * wait).
+ */
+
+#include "Metal.hpp"
+#include "thread.hpp"
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <vector>
+
+namespace dxmt {
+
+class TextureAllocation;
+class SharedOrderLink;
+class SharedOrderQueue;
+
+constexpr unsigned kSharedOrderRing = 64; // more than the 32 chunks that a queue can have in flight
+constexpr unsigned kSharedOrderSlots = 32;
+
+/* The shared memory of one queue, written by that queue's threads */
+struct SharedOrderProgress {
+  std::atomic<uint64_t> committed;     // the newest committed chunk
+  std::atomic<uint64_t> ordered;       // the newest chunk whose order step is done
+  std::atomic<uint64_t> ordered_event; // the event value of that chunk, stored before `ordered`
+  std::atomic<uint32_t> pid;           // the process, for a reader that waits for it
+  std::atomic<uint32_t> closed;        // the queue is gone: its chunks that were never encoded never come
+  struct Entry {
+    std::atomic<uint64_t> chunk; // stored after `stamp`
+    std::atomic<uint64_t> stamp;
+  } ring[kSharedOrderRing]; // the stamp of each recent commit, at chunk % kSharedOrderRing
+};
+
+/* One queue's part of a shared texture */
+struct SharedOrderSlot {
+  std::atomic<uint64_t> queue;    // the queue's ID; 0 = free
+  std::atomic<uint64_t> written;  // the event value of the queue's newest chunk that wrote the texture
+  std::atomic<uint64_t> previous; // the value of the write before that one, stored before `written`
+  std::atomic<uint64_t> initial;  // the value of the queue's initializer event that the initial contents need
+};
+
+/* The shared memory of one shared texture, named by its unique name */
+struct SharedOrderSection {
+  std::atomic<uint32_t> used; // the slots below this index may be taken
+  uint32_t unused;
+  SharedOrderSlot slots[kSharedOrderSlots];
+};
+
+/* A texture's slot in its section. Created on the app's thread; the encode thread of the texture's queue uses it. */
+class SharedOrderTexture {
+public:
+  static SharedOrderTexture *Create(SharedOrderQueue *queue, const char *unique_name, uint64_t initial);
+  ~SharedOrderTexture();
+
+  // The encode thread's notes: the chunk that used the texture last, whether that chunk writes it
+  uint64_t noted_chunk = 0;
+  bool noted_write = false;
+
+private:
+  friend class SharedOrderQueue;
+  SharedOrderTexture() = default;
+
+  void *mapping_ = nullptr;
+  SharedOrderSection *section_ = nullptr;
+  unsigned slot_ = 0;
+  // The link of each other slot's queue, found once
+  struct Known {
+    uint64_t queue = 0;
+    SharedOrderLink *link = nullptr;
+  } known_[kSharedOrderSlots];
+};
+
+/* The order state of a command queue that holds a shared texture */
+class SharedOrderQueue {
+public:
+  static SharedOrderQueue *Create(
+      WMT::Device device, WMT::Reference<WMT::SharedEvent> event, WMT::Reference<WMT::SharedEvent> initializer_event,
+      obj_handle_t listener
+  );
+  ~SharedOrderQueue();
+
+  uint64_t
+  Id() const {
+    return id_;
+  }
+
+  WMT::Device
+  Device() const {
+    return device_;
+  }
+
+  /* The app's thread, at the commit of a chunk: returns the chunk's stamp */
+  uint64_t Commit(uint64_t chunk);
+
+  /* The encode thread, after the chunk's commands ran and before its first Metal encoder */
+  void Order(
+      WMT::CommandBuffer cmdbuf, uint64_t chunk, uint64_t event, uint64_t stamp, std::vector<TextureAllocation *> &used
+  );
+
+private:
+  struct Wait {
+    SharedOrderLink *link;
+    uint64_t value;
+    uint64_t initial;
+  };
+
+  SharedOrderQueue() = default;
+  int WaitFor(SharedOrderLink *link, uint64_t stamp);
+  bool AwaitOrdered(SharedOrderLink *link, uint64_t stamp);
+  void Encode(WMT::CommandBuffer cmdbuf, Wait &wait);
+  void Publish(uint64_t chunk, uint64_t event);
+  void Report(bool last);
+
+  uint64_t id_ = 0;
+  WMT::Device device_;
+  WMT::Reference<WMT::SharedEvent> event_;
+  WMT::Reference<WMT::SharedEvent> initializer_event_;
+  obj_handle_t listener_ = 0;
+  void *mapping_ = nullptr;
+  SharedOrderProgress *progress_ = nullptr;
+  std::atomic<uint64_t> *stamps_ = nullptr;
+  bool timing_ = false;
+  std::vector<Wait> waits_;
+
+  // Counts of the encode thread, logged every 10 s and at the end
+  struct Stats {
+    uint64_t chunks = 0;      // chunks that used a shared texture
+    uint64_t others = 0;      // chunks that used a shared texture of another queue too
+    uint64_t checks = 0;      // other queues looked at, one per chunk and queue
+    uint64_t waits = 0;       // waits encoded: the other GPU had not reached the value yet
+    uint64_t gaps = 0;        // waits for another queue's order step
+    double gap_us = 0, gap_max_us = 0;
+    uint64_t timeouts = 0;
+    double step_us = 0, step_max_us = 0;
+    std::chrono::steady_clock::time_point since = std::chrono::steady_clock::now();
+  } stats_;
+};
+
+} // namespace dxmt
