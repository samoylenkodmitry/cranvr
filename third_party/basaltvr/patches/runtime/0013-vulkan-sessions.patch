+XrResult XRAPI_CALL getVulkanGraphicsDevice(
+    XrInstance instance, XrSystemId systemId, VkInstance vulkanInstance, VkPhysicalDevice* physicalDevice) {
+    const XrResult check = checkInstanceAndSystem(instance, systemId, false);
