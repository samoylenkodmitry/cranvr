diff --git a/dlls/wininet/internet.c b/dlls/wininet/internet.c
index 7eb9dd7..588835b 100644
--- a/dlls/wininet/internet.c
+++ b/dlls/wininet/internet.c
@@ -219,20 +219,54 @@ object_header_t *get_handle_object( HINTERNET hinternet )
     return info;
 }
 
+/* A handle's children are added, released and invalidated on more than one thread: an application with
+ * several requests in flight closes them on its own threads, and asynchronous requests end on worker
+ * threads. The list of children changes under WININET_cs only. */
+void add_child_handle( object_header_t *parent, object_header_t *child )
+{
+    EnterCriticalSection( &WININET_cs );
+    list_add_head( &parent->children, &child->entry );
+    LeaveCriticalSection( &WININET_cs );
+}
+
 static void invalidate_handle(object_header_t *info)
 {
-    object_header_t *child, *next;
+    object_header_t *child, **children = NULL;
+    unsigned int count, i;
 
-    if(!info->valid_handle)
+    if(!InterlockedExchange( (LONG *)&info->valid_handle, FALSE ))
         return;
-    info->valid_handle = FALSE;
 
-    /* Free all children as native does */
-    LIST_FOR_EACH_ENTRY_SAFE( child, next, &info->children, object_header_t, entry )
+    /* Free all children as native does. The walk takes a reference to each child that is not being
+     * destroyed, under the lock, and invalidates the children after it: another thread may release a
+     * child meanwhile, which removes it from the list and frees it. */
+    EnterCriticalSection( &WININET_cs );
+    count = list_count( &info->children );
+    if (count && !(children = malloc( count * sizeof(*children) )))
+        count = 0;
+    i = 0;
+    if (count)
     {
-        TRACE("invalidating child handle %p for parent %p\n", child->hInternet, info);
-        invalidate_handle( child );
+        LIST_FOR_EACH_ENTRY( child, &info->children, object_header_t, entry )
+        {
+            LONG refs = child->refs, seen;
+
+            while (refs && (seen = InterlockedCompareExchange( &child->refs, refs + 1, refs )) != refs)
+                refs = seen;
+            if (refs)
+                children[i++] = child;
+        }
+    }
+    LeaveCriticalSection( &WININET_cs );
+
+    count = i;
+    for (i = 0; i < count; i++)
+    {
+        TRACE("invalidating child handle %p for parent %p\n", children[i]->hInternet, info);
+        invalidate_handle( children[i] );
+        WININET_Release( children[i] );
     }
+    free( children );
 
     WININET_Release(info);
 }
@@ -259,7 +293,11 @@ BOOL WININET_Release( object_header_t *info )
         }
         TRACE( "destroying object %p\n", info);
         if ( info->htype != WH_HINIT )
+        {
+            EnterCriticalSection( &WININET_cs );
             list_remove( &info->entry );
+            LeaveCriticalSection( &WININET_cs );
+        }
         info->vtbl->Destroy( info );
 
         if(info->hInternet) {
