+// cranvr: takes the interaction-profile events of this session that wait in the queue and counts
+// them. Each hand's profile may change in its own xrSyncActions. Any other event fails: -1.
+int takeInteractionProfileChanges(XrInstance instance, XrSession session) {
+    int count = 0;
+    for (;;) {
+        XrEventDataBuffer eventData{};
+        eventData.type = XR_TYPE_EVENT_DATA_BUFFER;
+        const XrResult result = xrPollEvent(instance, &eventData);
+        if (result == XR_EVENT_UNAVAILABLE) {
+            return count;
+        }
+        const auto* changed =
+            reinterpret_cast<const XrEventDataInteractionProfileChanged*>(&eventData);
+        if (result != XR_SUCCESS ||
+            eventData.type != XR_TYPE_EVENT_DATA_INTERACTION_PROFILE_CHANGED ||
+            changed->session != session) {
+            std::fprintf(
+                stderr,
+                "FAIL: expected only interaction-profile events, got XrResult %d/type %d\n",
+                result, static_cast<int>(eventData.type));
+            return -1;
+        }
+        ++count;
+    }
+}
