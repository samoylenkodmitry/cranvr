--- /dev/null
+++ b/runtime/tests/tracking_smoke.cpp
@@ -0,0 +1,753 @@
+// cranvr: reads hands, body, face and eyes through the OpenXR extensions that the runtime offers for
+// a headset's tracking, and compares them with the script of cranvr-probe's `--tracking` mode
+// (probe/src/tracked.rs, whose formulas are repeated here). The probe's head stands still, so the
+// game's LOCAL space is the probe's room lifted by the floor's height of 0.3 m.
+//
+// Usage: tracking_smoke.exe [--features hands,body,full_body,face,eyes] [--wait-seconds N]
+//                           [--seconds N]
+//   --features      the features that the headset must offer and that this program uses
+//                   (default: all)
+//   --wait-seconds  how long to wait for the headset's features to show in the runtime's list of
+//                   extensions (default 30). A game that starts before the headset connects sees
+//                   none, so the test waits.
+//   --seconds       how long to wait for every feature's data to arrive (default 20)
+//
+// It prints one line for each check and ends with "tracking_smoke: PASS" or "tracking_smoke: FAIL".
+// It needs a host with a headset that sends the probe's script: scripts/e2e.sh --tracking-wine.
+
+#include <windows.h>
+
+#include <d3d11_1.h>
+#include <dxgi1_2.h>
+
+#include <openxr/openxr.h>
+#include <openxr/openxr_platform.h>
+
+#include <algorithm>
+#include <cmath>
+#include <cstdarg>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+#include <vector>
+
+namespace {
+
+constexpr float kFloorLift = 0.3f;
+
+// An OpenXR structure with its type set and nothing else
+template <typename T>
+T make(XrStructureType type) {
+    T value{};
+    value.type = type;
+    return value;
+}
+
+struct Quat {
+    float x, y, z, w;
+};
+struct Vec3 {
+    float x, y, z;
+};
+
+Quat mul(const Quat& a, const Quat& b) {
+    return {
+        a.w * b.x + a.x * b.w + a.y * b.z - a.z * b.y,
+        a.w * b.y - a.x * b.z + a.y * b.w + a.z * b.x,
+        a.w * b.z + a.x * b.y - a.y * b.x + a.z * b.w,
+        a.w * b.w - a.x * b.x - a.y * b.y - a.z * b.z,
+    };
+}
+
+Vec3 rotate(const Quat& q, const Vec3& v) {
+    const Vec3 u{q.x, q.y, q.z};
+    const Vec3 t{
+        2.0f * (u.y * v.z - u.z * v.y), 2.0f * (u.z * v.x - u.x * v.z),
+        2.0f * (u.x * v.y - u.y * v.x)};
+    const Vec3 c{u.y * t.z - u.z * t.y, u.z * t.x - u.x * t.z, u.x * t.y - u.y * t.x};
+    return {v.x + q.w * t.x + c.x, v.y + q.w * t.y + c.y, v.z + q.w * t.z + c.z};
+}
+
+Quat about(char axis, float degrees) {
+    const float half = degrees * 3.14159265358979f / 360.0f;
+    const float s = std::sin(half);
+    const float c = std::cos(half);
+    return axis == 'x' ? Quat{s, 0, 0, c} : axis == 'y' ? Quat{0, s, 0, c} : Quat{0, 0, s, c};
+}
+
+struct Pose {
+    Quat q;
+    Vec3 p;
+};
+
+Pose compose(const Pose& root, const Pose& relative) {
+    const Vec3 moved = rotate(root.q, relative.p);
+    return {mul(root.q, relative.q), {root.p.x + moved.x, root.p.y + moved.y, root.p.z + moved.z}};
+}
+
+// The script of probe/src/tracked.rs, lifted by the floor
+Pose handJoint(int side, int index) {
+    const float yaw = side == 0 ? 20.0f : -15.0f;
+    const Vec3 at = side == 0 ? Vec3{-0.20f, 1.20f, -0.40f} : Vec3{0.25f, 1.10f, -0.40f};
+    const Pose wrist{about('y', yaw), {at.x, at.y + kFloorLift, at.z}};
+    const float i = static_cast<float>(index);
+    const float mirror = side == 0 ? -1.0f : 1.0f;
+    return compose(wrist, {about('x', 2.0f * i), {mirror * 0.005f * i, -0.003f * i, -0.006f * i}});
+}
+
+Pose bodyJoint(int index) {
+    const Pose root{about('y', 10.0f), {0.10f, 0.0f + kFloorLift, -0.50f}};
+    const float i = static_cast<float>(index);
+    return compose(root, {about('z', i), {0.01f * i, 0.02f * i, 0.005f * i}});
+}
+
+float faceWeight(int index) {
+    return static_cast<float>((7 * index) % 71) / 70.0f;
+}
+
+Pose gazePose() {
+    return {mul(about('y', 15.0f), about('x', -5.0f)), {0.0f, 1.6f + kFloorLift, 0.0f}};
+}
+
+// The angle between two orientations in radians
+float angleBetween(const Quat& a, const XrQuaternionf& b) {
+    const Quat inverse{-a.x, -a.y, -a.z, a.w};
+    const Quat turn = mul(inverse, {b.x, b.y, b.z, b.w});
+    return 2.0f * std::atan2(std::sqrt(turn.x * turn.x + turn.y * turn.y + turn.z * turn.z),
+                             std::fabs(turn.w));
+}
+
+float distance(const Vec3& a, const XrVector3f& b) {
+    return std::sqrt((a.x - b.x) * (a.x - b.x) + (a.y - b.y) * (a.y - b.y) + (a.z - b.z) * (a.z - b.z));
+}
+
+constexpr XrSpaceLocationFlags kAllFlags =
+    XR_SPACE_LOCATION_POSITION_VALID_BIT | XR_SPACE_LOCATION_ORIENTATION_VALID_BIT |
+    XR_SPACE_LOCATION_POSITION_TRACKED_BIT | XR_SPACE_LOCATION_ORIENTATION_TRACKED_BIT;
+
+int gProblems = 0;
+
+void report(bool ok, const char* format, ...) {
+    char text[512];
+    va_list arguments;
+    va_start(arguments, format);
+    std::vsnprintf(text, sizeof(text), format, arguments);
+    va_end(arguments);
+    std::printf("tracking_smoke: %s %s\n", ok ? "ok  " : "FAIL", text);
+    std::fflush(stdout);
+    if (!ok) {
+        ++gProblems;
+    }
+}
+
+int finish(const char* reason) {
+    std::printf("tracking_smoke: %s\n", reason);
+    std::printf("tracking_smoke: FAIL\n");
+    std::fflush(stdout);
+    return 1;
+}
+
+uint64_t unixMilliseconds() {
+    FILETIME time{};
+    GetSystemTimeAsFileTime(&time);
+    const uint64_t ticks = (static_cast<uint64_t>(time.dwHighDateTime) << 32) | time.dwLowDateTime;
+    return (ticks - 116444736000000000ULL) / 10000ULL;
+}
+
+struct Feature {
+    const char* word;
+    uint32_t bit;
+};
+
+constexpr uint32_t kHands = 1;
+constexpr uint32_t kBody = 2;
+constexpr uint32_t kFullBody = 4;
+constexpr uint32_t kFace = 8;
+constexpr uint32_t kEyes = 16;
+
+constexpr Feature kFeatures[] = {
+    {"hands", kHands}, {"body", kBody}, {"full_body", kFullBody}, {"face", kFace}, {"eyes", kEyes}};
+
+// The extensions of each feature, as the runtime lists them
+bool listed(const std::vector<std::string>& names, const char* name) {
+    return std::find(names.begin(), names.end(), name) != names.end();
+}
+
+std::vector<std::string> instanceExtensions() {
+    uint32_t count = 0;
+    std::vector<std::string> names;
+    if (XR_FAILED(xrEnumerateInstanceExtensionProperties(nullptr, 0, &count, nullptr))) {
+        return names;
+    }
+    std::vector<XrExtensionProperties> properties(count);
+    for (XrExtensionProperties& property : properties) {
+        property.type = XR_TYPE_EXTENSION_PROPERTIES;
+    }
+    if (XR_FAILED(xrEnumerateInstanceExtensionProperties(nullptr, count, &count, properties.data()))) {
+        return names;
+    }
+    for (const XrExtensionProperties& property : properties) {
+        names.emplace_back(property.extensionName);
+    }
+    return names;
+}
+
+template <typename F>
+F procedure(XrInstance instance, const char* name) {
+    PFN_xrVoidFunction function = nullptr;
+    if (XR_FAILED(xrGetInstanceProcAddr(instance, name, &function))) {
+        return nullptr;
+    }
+    return reinterpret_cast<F>(function);
+}
+
+#define CHECK_XR(call)                                                                          \
+    do {                                                                                        \
+        const XrResult checked = (call);                                                        \
+        if (XR_FAILED(checked)) {                                                               \
+            std::printf("tracking_smoke: %s returned %d\n", #call, static_cast<int>(checked));  \
+            return finish("an OpenXR call failed");                                             \
+        }                                                                                       \
+    } while (false)
+
+}  // namespace
+
+int main(int argc, char** argv) {
+    uint32_t wanted = kHands | kBody | kFullBody | kFace | kEyes;
+    double waitSeconds = 30.0;
+    double seconds = 20.0;
+    for (int index = 1; index < argc; ++index) {
+        if (std::strcmp(argv[index], "--features") == 0 && index + 1 < argc) {
+            wanted = 0;
+            std::string list = argv[++index];
+            for (const Feature& feature : kFeatures) {
+                size_t at = 0;
+                while ((at = list.find(feature.word, at)) != std::string::npos) {
+                    const size_t end = at + std::strlen(feature.word);
+                    const bool startsWord = at == 0 || list[at - 1] == ',';
+                    const bool endsWord = end == list.size() || list[end] == ',';
+                    if (startsWord && endsWord) {
+                        wanted |= feature.bit;
+                    }
+                    at = end;
+                }
+            }
+        } else if (std::strcmp(argv[index], "--wait-seconds") == 0 && index + 1 < argc) {
+            waitSeconds = std::atof(argv[++index]);
+        } else if (std::strcmp(argv[index], "--seconds") == 0 && index + 1 < argc) {
+            seconds = std::atof(argv[++index]);
+        } else {
+            std::fputs("usage: tracking_smoke [--features LIST] [--wait-seconds N] [--seconds N]\n", stderr);
+            return 2;
+        }
+    }
+
+    // The headset's features show in the runtime's list once the host has the headset's offer
+    const char* handName = XR_EXT_HAND_TRACKING_EXTENSION_NAME;
+    const char* bodyName = XR_FB_BODY_TRACKING_EXTENSION_NAME;
+    const char* fullBodyName = XR_META_BODY_TRACKING_FULL_BODY_EXTENSION_NAME;
+    const char* faceName = XR_FB_FACE_TRACKING2_EXTENSION_NAME;
+    const char* eyeName = XR_EXT_EYE_GAZE_INTERACTION_EXTENSION_NAME;
+    const uint64_t waitStart = unixMilliseconds();
+    std::vector<std::string> names;
+    for (;;) {
+        names = instanceExtensions();
+        const bool all = listed(names, XR_KHR_D3D11_ENABLE_EXTENSION_NAME) &&
+                         ((wanted & kHands) == 0 || listed(names, handName)) &&
+                         ((wanted & kBody) == 0 || listed(names, bodyName)) &&
+                         ((wanted & kFullBody) == 0 || listed(names, fullBodyName)) &&
+                         ((wanted & kFace) == 0 || listed(names, faceName)) &&
+                         ((wanted & kEyes) == 0 || listed(names, eyeName));
+        if (all) {
+            break;
+        }
+        if ((unixMilliseconds() - waitStart) / 1000.0 > waitSeconds) {
+            std::string have;
+            for (const std::string& name : names) {
+                have += name + " ";
+            }
+            std::printf("tracking_smoke: the runtime lists: %s\n", have.c_str());
+            return finish("the runtime did not list the extensions of the headset's features");
+        }
+        Sleep(250);
+    }
+    {
+        std::string have;
+        for (const std::string& name : names) {
+            have += name + " ";
+        }
+        std::printf("tracking_smoke: the runtime lists: %s\n", have.c_str());
+    }
+    // A feature that the test does not ask for must not be listed unless the headset offers it, and
+    // the runtime lists nothing else that it does not know
+    report(!listed(names, "XR_FB_hand_tracking_aim"), "no extension that the runtime does not implement");
+
+    std::vector<const char*> enabled = {XR_KHR_D3D11_ENABLE_EXTENSION_NAME};
+    if ((wanted & kHands) != 0) enabled.push_back(handName);
+    if ((wanted & (kBody | kFullBody)) != 0) enabled.push_back(bodyName);
+    if ((wanted & kFullBody) != 0) enabled.push_back(fullBodyName);
+    if ((wanted & kFace) != 0) enabled.push_back(faceName);
+    if ((wanted & kEyes) != 0) enabled.push_back(eyeName);
+
+    XrInstanceCreateInfo instanceInfo{};
+    instanceInfo.type = XR_TYPE_INSTANCE_CREATE_INFO;
+    instanceInfo.enabledExtensionCount = static_cast<uint32_t>(enabled.size());
+    instanceInfo.enabledExtensionNames = enabled.data();
+    instanceInfo.applicationInfo.apiVersion = XR_API_VERSION_1_0;
+    std::strncpy(instanceInfo.applicationInfo.applicationName, "cranvr tracking smoke",
+                 XR_MAX_APPLICATION_NAME_SIZE - 1);
+    XrInstance instance = XR_NULL_HANDLE;
+    CHECK_XR(xrCreateInstance(&instanceInfo, &instance));
+
+    XrSystemGetInfo systemInfo{};
+    systemInfo.type = XR_TYPE_SYSTEM_GET_INFO;
+    systemInfo.formFactor = XR_FORM_FACTOR_HEAD_MOUNTED_DISPLAY;
+    XrSystemId systemId = XR_NULL_SYSTEM_ID;
+    CHECK_XR(xrGetSystem(instance, &systemInfo, &systemId));
+
+    // The support structures of the extensions say yes
+    XrSystemHandTrackingPropertiesEXT handSupport = make<XrSystemHandTrackingPropertiesEXT>(XR_TYPE_SYSTEM_HAND_TRACKING_PROPERTIES_EXT);
+    XrSystemBodyTrackingPropertiesFB bodySupport = make<XrSystemBodyTrackingPropertiesFB>(XR_TYPE_SYSTEM_BODY_TRACKING_PROPERTIES_FB);
+    XrSystemPropertiesBodyTrackingFullBodyMETA fullSupport = make<XrSystemPropertiesBodyTrackingFullBodyMETA>(XR_TYPE_SYSTEM_PROPERTIES_BODY_TRACKING_FULL_BODY_META);
+    XrSystemFaceTrackingProperties2FB faceSupport = make<XrSystemFaceTrackingProperties2FB>(XR_TYPE_SYSTEM_FACE_TRACKING_PROPERTIES2_FB);
+    XrSystemEyeGazeInteractionPropertiesEXT eyeSupport = make<XrSystemEyeGazeInteractionPropertiesEXT>(XR_TYPE_SYSTEM_EYE_GAZE_INTERACTION_PROPERTIES_EXT);
+    void* chain = nullptr;
+    auto link = [&chain](auto& structure) {
+        structure.next = chain;
+        chain = &structure;
+    };
+    if ((wanted & kHands) != 0) link(handSupport);
+    if ((wanted & (kBody | kFullBody)) != 0) link(bodySupport);
+    if ((wanted & kFullBody) != 0) link(fullSupport);
+    if ((wanted & kFace) != 0) link(faceSupport);
+    if ((wanted & kEyes) != 0) link(eyeSupport);
+    XrSystemProperties systemProperties = make<XrSystemProperties>(XR_TYPE_SYSTEM_PROPERTIES);
+    systemProperties.next = chain;
+    CHECK_XR(xrGetSystemProperties(instance, systemId, &systemProperties));
+    if ((wanted & kHands) != 0) report(handSupport.supportsHandTracking == XR_TRUE, "the system supports hand tracking");
+    if ((wanted & (kBody | kFullBody)) != 0) report(bodySupport.supportsBodyTracking == XR_TRUE, "the system supports body tracking");
+    if ((wanted & kFullBody) != 0) report(fullSupport.supportsFullBodyTracking == XR_TRUE, "the system supports full body tracking");
+    if ((wanted & kFace) != 0) report(faceSupport.supportsVisualFaceTracking == XR_TRUE, "the system supports visual face tracking");
+    if ((wanted & kEyes) != 0) report(eyeSupport.supportsEyeGazeInteraction == XR_TRUE, "the system supports eye gaze interaction");
+
+    // The tracking functions answer only for enabled extensions
+    PFN_xrVoidFunction unlisted = nullptr;
+    if ((wanted & kHands) == 0) {
+        report(XR_FAILED(xrGetInstanceProcAddr(instance, "xrCreateHandTrackerEXT", &unlisted)) || unlisted == nullptr,
+               "xrCreateHandTrackerEXT is absent while its extension is off");
+    }
+
+    auto createHand = procedure<PFN_xrCreateHandTrackerEXT>(instance, "xrCreateHandTrackerEXT");
+    auto destroyHand = procedure<PFN_xrDestroyHandTrackerEXT>(instance, "xrDestroyHandTrackerEXT");
+    auto locateHand = procedure<PFN_xrLocateHandJointsEXT>(instance, "xrLocateHandJointsEXT");
+    auto createBody = procedure<PFN_xrCreateBodyTrackerFB>(instance, "xrCreateBodyTrackerFB");
+    auto destroyBody = procedure<PFN_xrDestroyBodyTrackerFB>(instance, "xrDestroyBodyTrackerFB");
+    auto locateBody = procedure<PFN_xrLocateBodyJointsFB>(instance, "xrLocateBodyJointsFB");
+    auto bodySkeleton = procedure<PFN_xrGetBodySkeletonFB>(instance, "xrGetBodySkeletonFB");
+    auto createFace = procedure<PFN_xrCreateFaceTracker2FB>(instance, "xrCreateFaceTracker2FB");
+    auto destroyFace = procedure<PFN_xrDestroyFaceTracker2FB>(instance, "xrDestroyFaceTracker2FB");
+    auto faceWeights = procedure<PFN_xrGetFaceExpressionWeights2FB>(instance, "xrGetFaceExpressionWeights2FB");
+
+    // A session on DXMT's device, as a game has it
+    auto getRequirements = procedure<PFN_xrGetD3D11GraphicsRequirementsKHR>(instance, "xrGetD3D11GraphicsRequirementsKHR");
+    if (getRequirements == nullptr) {
+        return finish("no D3D11 requirements function");
+    }
+    XrGraphicsRequirementsD3D11KHR requirements = make<XrGraphicsRequirementsD3D11KHR>(XR_TYPE_GRAPHICS_REQUIREMENTS_D3D11_KHR);
+    CHECK_XR(getRequirements(instance, systemId, &requirements));
+    IDXGIFactory1* factory = nullptr;
+    IDXGIAdapter1* adapter = nullptr;
+    if (FAILED(CreateDXGIFactory1(__uuidof(IDXGIFactory1), reinterpret_cast<void**>(&factory))) ||
+        FAILED(factory->EnumAdapters1(0, &adapter))) {
+        return finish("no DXGI adapter");
+    }
+    const D3D_FEATURE_LEVEL levels[] = {D3D_FEATURE_LEVEL_11_0};
+    ID3D11Device* device = nullptr;
+    ID3D11DeviceContext* context = nullptr;
+    D3D_FEATURE_LEVEL level{};
+    if (FAILED(D3D11CreateDevice(adapter, D3D_DRIVER_TYPE_UNKNOWN, nullptr, D3D11_CREATE_DEVICE_BGRA_SUPPORT,
+                                 levels, 1, D3D11_SDK_VERSION, &device, &level, &context))) {
+        return finish("no D3D11 device");
+    }
+    XrGraphicsBindingD3D11KHR binding = make<XrGraphicsBindingD3D11KHR>(XR_TYPE_GRAPHICS_BINDING_D3D11_KHR);
+    binding.device = device;
+    XrSessionCreateInfo sessionInfo = make<XrSessionCreateInfo>(XR_TYPE_SESSION_CREATE_INFO);
+    sessionInfo.next = &binding;
+    sessionInfo.systemId = systemId;
+    XrSession session = XR_NULL_HANDLE;
+    CHECK_XR(xrCreateSession(instance, &sessionInfo, &session));
+
+    XrReferenceSpaceCreateInfo spaceInfo = make<XrReferenceSpaceCreateInfo>(XR_TYPE_REFERENCE_SPACE_CREATE_INFO);
+    spaceInfo.referenceSpaceType = XR_REFERENCE_SPACE_TYPE_LOCAL;
+    spaceInfo.poseInReferenceSpace = {{0, 0, 0, 1}, {0, 0, 0}};
+    XrSpace localSpace = XR_NULL_HANDLE;
+    CHECK_XR(xrCreateReferenceSpace(session, &spaceInfo, &localSpace));
+    spaceInfo.referenceSpaceType = XR_REFERENCE_SPACE_TYPE_VIEW;
+    XrSpace viewSpace = XR_NULL_HANDLE;
+    CHECK_XR(xrCreateReferenceSpace(session, &spaceInfo, &viewSpace));
+
+    // The trackers come after the session has run for a moment, as in a game, so the host's wish for
+    // the headset's tracking starts after this line
+    std::printf("tracking_smoke: creating the trackers at unix %llu ms\n",
+                static_cast<unsigned long long>(unixMilliseconds()));
+    std::fflush(stdout);
+
+    XrHandTrackerEXT hands[2]{};
+    if ((wanted & kHands) != 0) {
+        for (int side = 0; side < 2; ++side) {
+            XrHandTrackerCreateInfoEXT info = make<XrHandTrackerCreateInfoEXT>(XR_TYPE_HAND_TRACKER_CREATE_INFO_EXT);
+            info.hand = side == 0 ? XR_HAND_LEFT_EXT : XR_HAND_RIGHT_EXT;
+            info.handJointSet = XR_HAND_JOINT_SET_DEFAULT_EXT;
+            CHECK_XR(createHand(session, &info, &hands[side]));
+        }
+        XrHandTrackerCreateInfoEXT bad = make<XrHandTrackerCreateInfoEXT>(XR_TYPE_HAND_TRACKER_CREATE_INFO_EXT);
+        bad.hand = XR_HAND_LEFT_EXT;
+        bad.handJointSet = XR_HAND_JOINT_SET_HAND_WITH_FOREARM_ULTRALEAP;
+        XrHandTrackerEXT none = XR_NULL_HANDLE;
+        report(createHand(session, &bad, &none) == XR_ERROR_FEATURE_UNSUPPORTED, "a hand joint set that the runtime lacks is refused");
+    }
+    XrBodyTrackerFB bodies[2]{};
+    uint32_t bodyJoints[2] = {XR_BODY_JOINT_COUNT_FB, XR_FULL_BODY_JOINT_COUNT_META};
+    const bool wantBody = (wanted & kBody) != 0 || (wanted & kFullBody) != 0;
+    if (wantBody) {
+        XrBodyTrackerCreateInfoFB info = make<XrBodyTrackerCreateInfoFB>(XR_TYPE_BODY_TRACKER_CREATE_INFO_FB);
+        info.bodyJointSet = XR_BODY_JOINT_SET_DEFAULT_FB;
+        CHECK_XR(createBody(session, &info, &bodies[0]));
+        if ((wanted & kFullBody) != 0) {
+            info.bodyJointSet = XR_BODY_JOINT_SET_FULL_BODY_META;
+            CHECK_XR(createBody(session, &info, &bodies[1]));
+        }
+    }
+    XrFaceTracker2FB face = XR_NULL_HANDLE;
+    if ((wanted & kFace) != 0) {
+        XrFaceTrackingDataSource2FB sources[1] = {XR_FACE_TRACKING_DATA_SOURCE2_VISUAL_FB};
+        XrFaceTrackerCreateInfo2FB info = make<XrFaceTrackerCreateInfo2FB>(XR_TYPE_FACE_TRACKER_CREATE_INFO2_FB);
+        info.faceExpressionSet = XR_FACE_EXPRESSION_SET2_DEFAULT_FB;
+        info.requestedDataSourceCount = 1;
+        info.requestedDataSources = sources;
+        CHECK_XR(createFace(session, &info, &face));
+    }
+
+    // The eyes: an action on /user/eyes_ext/input/gaze_ext/pose
+    XrActionSet gazeSet = XR_NULL_HANDLE;
+    XrAction gazeAction = XR_NULL_HANDLE;
+    XrSpace gazeSpace = XR_NULL_HANDLE;
+    XrPath eyesPath = XR_NULL_PATH;
+    if ((wanted & kEyes) != 0) {
+        XrPath gazePath = XR_NULL_PATH;
+        XrPath profilePath = XR_NULL_PATH;
+        CHECK_XR(xrStringToPath(instance, "/user/eyes_ext", &eyesPath));
+        CHECK_XR(xrStringToPath(instance, "/user/eyes_ext/input/gaze_ext/pose", &gazePath));
+        CHECK_XR(xrStringToPath(instance, "/interaction_profiles/ext/eye_gaze_interaction", &profilePath));
+        XrActionSetCreateInfo setInfo = make<XrActionSetCreateInfo>(XR_TYPE_ACTION_SET_CREATE_INFO);
+        std::strcpy(setInfo.actionSetName, "gaze");
+        std::strcpy(setInfo.localizedActionSetName, "Gaze");
+        CHECK_XR(xrCreateActionSet(instance, &setInfo, &gazeSet));
+        XrActionCreateInfo actionInfo = make<XrActionCreateInfo>(XR_TYPE_ACTION_CREATE_INFO);
+        std::strcpy(actionInfo.actionName, "gaze_pose");
+        std::strcpy(actionInfo.localizedActionName, "Gaze pose");
+        actionInfo.actionType = XR_ACTION_TYPE_POSE_INPUT;
+        actionInfo.countSubactionPaths = 1;
+        actionInfo.subactionPaths = &eyesPath;
+        CHECK_XR(xrCreateAction(gazeSet, &actionInfo, &gazeAction));
+        XrActionSuggestedBinding suggested{gazeAction, gazePath};
+        XrInteractionProfileSuggestedBinding bindings = make<XrInteractionProfileSuggestedBinding>(XR_TYPE_INTERACTION_PROFILE_SUGGESTED_BINDING);
+        bindings.interactionProfile = profilePath;
+        bindings.countSuggestedBindings = 1;
+        bindings.suggestedBindings = &suggested;
+        CHECK_XR(xrSuggestInteractionProfileBindings(instance, &bindings));
+        XrSessionActionSetsAttachInfo attach = make<XrSessionActionSetsAttachInfo>(XR_TYPE_SESSION_ACTION_SETS_ATTACH_INFO);
+        attach.countActionSets = 1;
+        attach.actionSets = &gazeSet;
+        CHECK_XR(xrAttachSessionActionSets(session, &attach));
+        XrActionSpaceCreateInfo gazeSpaceInfo = make<XrActionSpaceCreateInfo>(XR_TYPE_ACTION_SPACE_CREATE_INFO);
+        gazeSpaceInfo.action = gazeAction;
+        gazeSpaceInfo.subactionPath = eyesPath;
+        gazeSpaceInfo.poseInActionSpace = {{0, 0, 0, 1}, {0, 0, 0}};
+        CHECK_XR(xrCreateActionSpace(session, &gazeSpaceInfo, &gazeSpace));
+    }
+
+    // Skeletons of the body trackers
+    for (int set = 0; set < 2; ++set) {
+        if (bodies[set] == XR_NULL_HANDLE) {
+            continue;
+        }
+        std::vector<XrBodySkeletonJointFB> joints(bodyJoints[set]);
+        XrBodySkeletonFB skeleton = make<XrBodySkeletonFB>(XR_TYPE_BODY_SKELETON_FB);
+        skeleton.jointCount = bodyJoints[set];
+        skeleton.joints = joints.data();
+        CHECK_XR(bodySkeleton(bodies[set], &skeleton));
+        const int32_t none = set == 0 ? static_cast<int32_t>(XR_BODY_JOINT_NONE_FB)
+                                      : static_cast<int32_t>(XR_FULL_BODY_JOINT_NONE_META);
+        bool orderOk = joints[0].parentJoint == none;
+        for (uint32_t i = 0; i < bodyJoints[set]; ++i) {
+            orderOk = orderOk && joints[i].joint == static_cast<int32_t>(i) &&
+                      (i == 0 || (joints[i].parentJoint >= 0 && joints[i].parentJoint < static_cast<int32_t>(i)));
+        }
+        report(orderOk, "the %u joint skeleton has a root and parents before children", bodyJoints[set]);
+        const bool symmetric =
+            std::fabs(joints[XR_BODY_JOINT_LEFT_ARM_UPPER_FB].pose.position.x +
+                      joints[XR_BODY_JOINT_RIGHT_ARM_UPPER_FB].pose.position.x) < 1e-4f &&
+            joints[XR_BODY_JOINT_HEAD_FB].pose.position.y > 1.4f &&
+            joints[XR_BODY_JOINT_HEAD_FB].pose.position.y < 2.0f;
+        report(symmetric, "the %u joint skeleton stands, with arms to both sides (head at %.2f m)", bodyJoints[set],
+               joints[XR_BODY_JOINT_HEAD_FB].pose.position.y);
+    }
+
+    // The session runs: ready, begin, frames until it is focused
+    XrEventDataBuffer event = make<XrEventDataBuffer>(XR_TYPE_EVENT_DATA_BUFFER);
+    bool ready = false;
+    for (int attempt = 0; attempt < 200 && !ready; ++attempt) {
+        event.type = XR_TYPE_EVENT_DATA_BUFFER;
+        if (xrPollEvent(instance, &event) == XR_SUCCESS && event.type == XR_TYPE_EVENT_DATA_SESSION_STATE_CHANGED &&
+            reinterpret_cast<XrEventDataSessionStateChanged*>(&event)->state == XR_SESSION_STATE_READY) {
+            ready = true;
+        } else {
+            Sleep(10);
+        }
+    }
+    if (!ready) {
+        return finish("the session did not become ready");
+    }
+    XrSessionBeginInfo beginInfo = make<XrSessionBeginInfo>(XR_TYPE_SESSION_BEGIN_INFO);
+    beginInfo.primaryViewConfigurationType = XR_VIEW_CONFIGURATION_TYPE_PRIMARY_STEREO;
+    CHECK_XR(xrBeginSession(session, &beginInfo));
+
+    // Every feature that the test uses must show its data, once, in the end
+    bool handsOk[2] = {false, false};
+    bool bodyOk[2] = {false, false};
+    bool faceOk = false;
+    bool eyesOk = false;
+    bool velocitiesOk = false;
+    const uint64_t dataStart = unixMilliseconds();
+    for (;;) {
+        XrFrameState frameState = make<XrFrameState>(XR_TYPE_FRAME_STATE);
+        CHECK_XR(xrWaitFrame(session, nullptr, &frameState));
+        CHECK_XR(xrBeginFrame(session, nullptr));
+        const XrTime time = frameState.predictedDisplayTime;
+
+        if (gazeAction != XR_NULL_HANDLE) {
+            XrActiveActionSet active{gazeSet, XR_NULL_PATH};
+            XrActionsSyncInfo sync = make<XrActionsSyncInfo>(XR_TYPE_ACTIONS_SYNC_INFO);
+            sync.countActiveActionSets = 1;
+            sync.activeActionSets = &active;
+            xrSyncActions(session, &sync);
+        }
+
+        for (int side = 0; side < 2 && (wanted & kHands) != 0 && !handsOk[side]; ++side) {
+            XrHandJointLocationEXT locations[XR_HAND_JOINT_COUNT_EXT]{};
+            XrHandJointVelocityEXT velocities[XR_HAND_JOINT_COUNT_EXT]{};
+            XrHandJointVelocitiesEXT velocityChain = make<XrHandJointVelocitiesEXT>(XR_TYPE_HAND_JOINT_VELOCITIES_EXT);
+            velocityChain.jointCount = XR_HAND_JOINT_COUNT_EXT;
+            velocityChain.jointVelocities = velocities;
+            XrHandJointLocationsEXT result = make<XrHandJointLocationsEXT>(XR_TYPE_HAND_JOINT_LOCATIONS_EXT);
+            result.next = &velocityChain;
+            result.jointCount = XR_HAND_JOINT_COUNT_EXT;
+            result.jointLocations = locations;
+            XrHandJointsLocateInfoEXT info = make<XrHandJointsLocateInfoEXT>(XR_TYPE_HAND_JOINTS_LOCATE_INFO_EXT);
+            info.baseSpace = localSpace;
+            info.time = time;
+            CHECK_XR(locateHand(hands[side], &info, &result));
+            if (result.isActive != XR_TRUE) {
+                continue;
+            }
+            // The right wrist moves at 0.2 m/s along +x in the script. The runtime moves the hand
+            // forward from the sample's arrival to this time, up to 50 ms: 0 to 10 mm, the same for
+            // every joint. The left hand stands still and must not move.
+            const Pose zeroJoint = handJoint(side, 0);
+            const float shift = locations[0].pose.position.x - zeroJoint.p.x;
+            const float maxShift = side == 1 ? 0.2f * 0.05f + 5e-4f : 5e-4f;
+            const bool shiftOk = shift >= -5e-4f && shift <= maxShift &&
+                                 std::fabs(locations[0].pose.position.y - zeroJoint.p.y) < 5e-4f &&
+                                 std::fabs(locations[0].pose.position.z - zeroJoint.p.z) < 5e-4f;
+            float worstPosition = 0.0f;
+            float worstAngle = 0.0f;
+            bool flagsOk = true;
+            bool radiiOk = true;
+            for (int joint = 0; joint < XR_HAND_JOINT_COUNT_EXT; ++joint) {
+                Pose expected = handJoint(side, joint);
+                expected.p.x += shift;
+                worstPosition = std::max(worstPosition, distance(expected.p, locations[joint].pose.position));
+                worstAngle = std::max(worstAngle, angleBetween(expected.q, locations[joint].pose.orientation));
+                flagsOk = flagsOk && (locations[joint].locationFlags & kAllFlags) == kAllFlags;
+                radiiOk = radiiOk && locations[joint].radius > 0.0f;
+            }
+            handsOk[side] = worstPosition < 5e-4f && worstAngle < 2e-3f && flagsOk && radiiOk && shiftOk;
+            report(shiftOk, "%s hand moved forward by %.2f mm for its velocity (at most %.1f mm)", side == 0 ? "left" : "right",
+                   shift * 1000.0f, maxShift * 1000.0f);
+            const XrPosef& first = locations[XR_HAND_JOINT_PALM_EXT].pose;
+            report(handsOk[side],
+                   "%s hand: 26 joints within %.3f mm and %.3f degrees of the script, flags %s, radii %s; joint 0 at (%.4f %.4f %.4f) "
+                   "turned (%.4f %.4f %.4f %.4f)",
+                   side == 0 ? "left" : "right", worstPosition * 1000.0f, worstAngle * 57.29578f, flagsOk ? "valid" : "WRONG",
+                   radiiOk ? "set" : "MISSING", first.position.x, first.position.y, first.position.z,
+                   first.orientation.x, first.orientation.y, first.orientation.z, first.orientation.w);
+            {
+                // The joints' velocities are the wrist's: 0.2 m/s along +x for the right hand, none for the left
+                const float wanted = side == 1 ? 0.2f : 0.0f;
+                velocitiesOk = (velocities[0].velocityFlags &
+                                (XR_SPACE_VELOCITY_LINEAR_VALID_BIT | XR_SPACE_VELOCITY_ANGULAR_VALID_BIT)) ==
+                                   (XR_SPACE_VELOCITY_LINEAR_VALID_BIT | XR_SPACE_VELOCITY_ANGULAR_VALID_BIT) &&
+                               std::fabs(velocities[0].linearVelocity.x - wanted) < 1e-3f &&
+                               std::fabs(velocities[0].linearVelocity.y) < 1e-3f &&
+                               std::fabs(velocities[0].angularVelocity.y) < 1e-3f;
+                report(velocitiesOk, "%s hand joint velocities are valid and %.1f m/s along x (got %.3f)",
+                       side == 0 ? "left" : "right", wanted, velocities[0].linearVelocity.x);
+            }
+            if (side == 1) {
+                // The shift grows with the time that the game asks for, to the limit of 50 ms, which is
+                // 10 mm at 0.2 m/s: 30 ms later gives at least 6 mm, 500 ms later gives the limit
+                XrHandJointLocationEXT later[XR_HAND_JOINT_COUNT_EXT]{};
+                XrHandJointLocationsEXT laterResult = make<XrHandJointLocationsEXT>(XR_TYPE_HAND_JOINT_LOCATIONS_EXT);
+                laterResult.jointCount = XR_HAND_JOINT_COUNT_EXT;
+                laterResult.jointLocations = later;
+                float shifts[2] = {-1.0f, -1.0f};
+                const XrTime offsets[2] = {30'000'000, 500'000'000};
+                for (int step = 0; step < 2; ++step) {
+                    info.time = time + offsets[step];
+                    if (XR_SUCCEEDED(locateHand(hands[side], &info, &laterResult)) && laterResult.isActive == XR_TRUE) {
+                        shifts[step] = later[0].pose.position.x - zeroJoint.p.x;
+                    }
+                }
+                info.time = time;
+                report(shifts[0] >= 0.0059f && shifts[0] <= 0.0105f && shifts[1] >= 0.0097f && shifts[1] <= 0.0103f &&
+                           shifts[0] < shifts[1],
+                       "the right hand moves forward by %.2f mm for 30 ms and %.2f mm for 500 ms, which stops at 50 ms (10 mm)",
+                       shifts[0] * 1000.0f, shifts[1] * 1000.0f);
+            }
+            // The base space matters: the same joints in the view space differ by the head's pose
+            XrHandJointLocationEXT inView[XR_HAND_JOINT_COUNT_EXT]{};
+            XrHandJointLocationsEXT viewResult = make<XrHandJointLocationsEXT>(XR_TYPE_HAND_JOINT_LOCATIONS_EXT);
+            viewResult.jointCount = XR_HAND_JOINT_COUNT_EXT;
+            viewResult.jointLocations = inView;
+            info.baseSpace = viewSpace;
+            if (XR_SUCCEEDED(locateHand(hands[side], &info, &viewResult)) && viewResult.isActive == XR_TRUE && side == 0) {
+                // The probe's head is at (0, 1.6 + 0.3, 0) looking along -z: a point at the room's
+                // (x, y, z) is at (x, y - 1.9, z) in the view space
+                const Pose expected = handJoint(0, 0);
+                const XrVector3f seen = inView[0].pose.position;
+                const bool inViewOk = std::fabs(seen.x - expected.p.x) < 1e-3f && std::fabs(seen.y - (expected.p.y - 1.9f)) < 1e-3f &&
+                                      std::fabs(seen.z - expected.p.z) < 1e-3f;
+                report(inViewOk, "the left hand in the view space is where the head's pose puts it: (%.3f %.3f %.3f)", seen.x, seen.y, seen.z);
+            }
+        }
+
+        for (int set = 0; set < 2 && wantBody; ++set) {
+            if (bodies[set] == XR_NULL_HANDLE || bodyOk[set]) {
+                continue;
+            }
+            std::vector<XrBodyJointLocationFB> locations(bodyJoints[set]);
+            XrBodyJointLocationsFB result = make<XrBodyJointLocationsFB>(XR_TYPE_BODY_JOINT_LOCATIONS_FB);
+            result.jointCount = bodyJoints[set];
+            result.jointLocations = locations.data();
+            XrBodyJointsLocateInfoFB info = make<XrBodyJointsLocateInfoFB>(XR_TYPE_BODY_JOINTS_LOCATE_INFO_FB);
+            info.baseSpace = localSpace;
+            info.time = time;
+            CHECK_XR(locateBody(bodies[set], &info, &result));
+            if (result.isActive != XR_TRUE) {
+                continue;
+            }
+            float worstPosition = 0.0f;
+            float worstAngle = 0.0f;
+            bool flagsOk = true;
+            for (uint32_t joint = 0; joint < bodyJoints[set]; ++joint) {
+                const Pose expected = bodyJoint(static_cast<int>(joint));
+                worstPosition = std::max(worstPosition, distance(expected.p, locations[joint].pose.position));
+                worstAngle = std::max(worstAngle, angleBetween(expected.q, locations[joint].pose.orientation));
+                flagsOk = flagsOk && (locations[joint].locationFlags & kAllFlags) == kAllFlags;
+            }
+            const bool confidenceOk = std::fabs(result.confidence - 0.9f) < 1e-5f && result.time == time;
+            bodyOk[set] = worstPosition < 5e-4f && worstAngle < 2e-3f && flagsOk && confidenceOk;
+            report(bodyOk[set], "%u joint body: within %.3f mm and %.3f degrees of the script, flags %s, confidence %.2f",
+                   bodyJoints[set], worstPosition * 1000.0f, worstAngle * 57.29578f, flagsOk ? "valid" : "WRONG", result.confidence);
+        }
+
+        if (face != XR_NULL_HANDLE && !faceOk) {
+            float weights[XR_FACE_EXPRESSION2_COUNT_FB]{};
+            float confidences[XR_FACE_CONFIDENCE2_COUNT_FB]{};
+            XrFaceExpressionWeights2FB result = make<XrFaceExpressionWeights2FB>(XR_TYPE_FACE_EXPRESSION_WEIGHTS2_FB);
+            result.weightCount = XR_FACE_EXPRESSION2_COUNT_FB;
+            result.weights = weights;
+            result.confidenceCount = XR_FACE_CONFIDENCE2_COUNT_FB;
+            result.confidences = confidences;
+            XrFaceExpressionInfo2FB info = make<XrFaceExpressionInfo2FB>(XR_TYPE_FACE_EXPRESSION_INFO2_FB);
+            info.time = time;
+            CHECK_XR(faceWeights(face, &info, &result));
+            if (result.isValid == XR_TRUE) {
+                float worst = 0.0f;
+                for (int i = 0; i < XR_FACE_EXPRESSION2_COUNT_FB; ++i) {
+                    worst = std::max(worst, std::fabs(weights[i] - faceWeight(i)));
+                }
+                faceOk = worst < 0.003f && std::fabs(confidences[0] - 0.25f) < 0.003f &&
+                         std::fabs(confidences[1] - 0.75f) < 0.003f &&
+                         result.dataSource == XR_FACE_TRACKING_DATA_SOURCE2_VISUAL_FB;
+                report(faceOk, "face: 70 weights within %.4f of the script, confidences %.2f and %.2f, visual source", worst,
+                       confidences[0], confidences[1]);
+            }
+        }
+
+        if (gazeSpace != XR_NULL_HANDLE && !eyesOk) {
+            XrActionStateGetInfo stateInfo = make<XrActionStateGetInfo>(XR_TYPE_ACTION_STATE_GET_INFO);
+            stateInfo.action = gazeAction;
+            stateInfo.subactionPath = eyesPath;
+            XrActionStatePose state = make<XrActionStatePose>(XR_TYPE_ACTION_STATE_POSE);
+            xrGetActionStatePose(session, &stateInfo, &state);
+            if (state.isActive == XR_TRUE) {
+                XrEyeGazeSampleTimeEXT sampleTime = make<XrEyeGazeSampleTimeEXT>(XR_TYPE_EYE_GAZE_SAMPLE_TIME_EXT);
+                XrSpaceLocation location = make<XrSpaceLocation>(XR_TYPE_SPACE_LOCATION);
+                location.next = &sampleTime;
+                CHECK_XR(xrLocateSpace(gazeSpace, localSpace, time, &location));
+                const Pose expected = gazePose();
+                const bool flagsOk = (location.locationFlags & kAllFlags) == kAllFlags;
+                eyesOk = flagsOk && distance(expected.p, location.pose.position) < 5e-4f &&
+                         angleBetween(expected.q, location.pose.orientation) < 2e-3f && sampleTime.time == time;
+                report(eyesOk, "eye gaze at (%.3f %.3f %.3f) turned (%.4f %.4f %.4f %.4f), within %.3f degrees of the script",
+                       location.pose.position.x, location.pose.position.y, location.pose.position.z,
+                       location.pose.orientation.x, location.pose.orientation.y, location.pose.orientation.z,
+                       location.pose.orientation.w, angleBetween(expected.q, location.pose.orientation) * 57.29578f);
+                XrInteractionProfileState profile = make<XrInteractionProfileState>(XR_TYPE_INTERACTION_PROFILE_STATE);
+                xrGetCurrentInteractionProfile(session, eyesPath, &profile);
+                report(profile.interactionProfile != XR_NULL_PATH, "the eyes have an interaction profile");
+            }
+        }
+
+        XrFrameEndInfo endInfo = make<XrFrameEndInfo>(XR_TYPE_FRAME_END_INFO);
+        endInfo.displayTime = time;
+        endInfo.environmentBlendMode = XR_ENVIRONMENT_BLEND_MODE_OPAQUE;
+        CHECK_XR(xrEndFrame(session, &endInfo));
+
+        const bool allDone = ((wanted & kHands) == 0 || (handsOk[0] && handsOk[1])) &&
+                             (!wantBody || ((bodyOk[0] || bodies[0] == XR_NULL_HANDLE) && (bodyOk[1] || bodies[1] == XR_NULL_HANDLE))) &&
+                             ((wanted & kFace) == 0 || faceOk) && ((wanted & kEyes) == 0 || eyesOk);
+        if (allDone) {
+            break;
+        }
+        if ((unixMilliseconds() - dataStart) / 1000.0 > seconds) {
+            report(false, "not every feature's data arrived in %.0f seconds (hands %d %d, body %d %d, face %d, eyes %d)", seconds,
+                   handsOk[0], handsOk[1], bodyOk[0], bodyOk[1], faceOk, eyesOk);
+            break;
+        }
+    }
+
+    // A tracker for a hand that nobody tracks: its data goes away with the host's wish. Destroy the
+    // trackers and keep the session a moment: the host then asks the headset for nothing.
+    std::printf("tracking_smoke: destroying the trackers at unix %llu ms\n",
+                static_cast<unsigned long long>(unixMilliseconds()));
+    std::fflush(stdout);
+    for (XrHandTrackerEXT hand : hands) {
+        if (hand != XR_NULL_HANDLE) destroyHand(hand);
+    }
+    for (XrBodyTrackerFB body : bodies) {
+        if (body != XR_NULL_HANDLE) destroyBody(body);
+    }
+    if (face != XR_NULL_HANDLE) destroyFace(face);
+    report(destroyHand != nullptr && (wanted & kHands) == 0 ? true : (wanted & kHands) == 0 || destroyHand(hands[0]) == XR_ERROR_HANDLE_INVALID,
+           "a destroyed tracker's handle is invalid");
+    Sleep(1500);
+    xrDestroySession(session);
+    xrDestroyInstance(instance);
+    std::printf("tracking_smoke: %s\n", gProblems == 0 ? "PASS" : "FAIL");
+    return gProblems == 0 ? 0 : 1;
+}
