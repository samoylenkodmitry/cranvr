-	ERR("unknown/unsupported interface " + string(interfaceVersion));
+	// cranvr: SteamVR answers an interface that it lacks with an error, and a game that asks for an optional
+	// interface goes on without it. Half-Life: Alyx (OpenVR SDK 2.16) asks for IVRIPCResourceManagerClient_004
+	// at its start. A message box here stopped the game until someone closed it on the Mac's screen.
+	OOVR_LOGF("The application asked for %s, which OpenComposite lacks: it gets VRInitError_Init_InterfaceNotFound", interfaceVersion);
+	if (error)
+		*error = VRInitError_Init_InterfaceNotFound;
+	return nullptr;
 #undef INTERFACE
 }
 
