+namespace {
+
+// --- IOSurface textures -----------------------------------------------------------------------
+//
+// winemetal keeps a Mach send right to each IOSurface that it makes, and that right holds the
+// surface until the game ends: a released texture does not free its IOSurface. A game recreates
+// its swapchains at each session restart (OpenComposite restarts twice at a game's start). The
+// runtime therefore keeps every texture that it made and gives it to the next swapchain of the same
+// size and format. The memory stays at the largest set of swapchains that the game had at a time.
+
+struct PooledTexture {
+    uint32_t width = 0;
+    uint32_t height = 0;
+    uint32_t pixelFormat = 0;
+    uint32_t usage = 0;
+    ObjHandle texture = 0;
+    uint32_t iosurfaceId = 0;
+    bool inUse = false;
+};
+
+// Four swapchains of three images with two slices each are 24 textures at a time. The runtime has
+// no exceptions: a fixed pool, and a swapchain that finds it full fails.
+constexpr size_t kPoolCapacity = 64;
+SRWLOCK gPoolLock = SRWLOCK_INIT;
+std::array<PooledTexture, kPoolCapacity> gPool{};
+size_t gPoolCount = 0;
+
+// A texture on an IOSurface, from the pool or new. Returns the pool index or SIZE_MAX.
+size_t takeTexture(uint32_t width, uint32_t height, uint32_t pixelFormat, uint32_t usage) {
+    AcquireSRWLockExclusive(&gPoolLock);
+    for (size_t index = 0; index < gPoolCount; ++index) {
+        PooledTexture& pooled = gPool[index];
+        if (!pooled.inUse && pooled.width == width && pooled.height == height &&
+            pooled.pixelFormat == pixelFormat && (pooled.usage & usage) == usage) {
+            pooled.inUse = true;
+            ReleaseSRWLockExclusive(&gPoolLock);
+            return index;
+        }
+    }
+    const bool full = gPoolCount == kPoolCapacity;
+    ReleaseSRWLockExclusive(&gPoolLock);
+    if (full) {
+        return SIZE_MAX;
+    }
+
+    WmtTextureInfo info{};
+    info.pixelFormat = pixelFormat;
+    info.width = width;
+    info.height = height;
+    info.depth = 1;
+    info.arrayLength = 1;
+    info.type = kWmtTextureType2D;
+    info.mipmapLevelCount = 1;
+    info.sampleCount = 1;
+    info.usage = usage;
+    info.options = kWmtStorageModeShared;
+    const ObjHandle texture = gMetal.newTextureFromIOSurface(gMetal.device, &info);
+    if (texture == 0 || info.reserved == 0) {
+        return SIZE_MAX;
+    }
+    AcquireSRWLockExclusive(&gPoolLock);
+    if (gPoolCount == kPoolCapacity) {
+        // Another thread took the last place: the texture stays alive with its IOSurface
+        ReleaseSRWLockExclusive(&gPoolLock);
+        return SIZE_MAX;
+    }
+    const size_t index = gPoolCount++;
+    gPool[index] = {width, height, pixelFormat, usage, texture, info.reserved, true};
+    ReleaseSRWLockExclusive(&gPoolLock);
+    return index;
+}
+
+PooledTexture pooledTexture(size_t index) {
+    AcquireSRWLockShared(&gPoolLock);
+    const PooledTexture pooled = gPool[index];
+    ReleaseSRWLockShared(&gPoolLock);
+    return pooled;
+}
+
+void returnTexture(size_t index) {
+    AcquireSRWLockExclusive(&gPoolLock);
+    gPool[index].inUse = false;
+    ReleaseSRWLockExclusive(&gPoolLock);
+}
+
+template <typename Function>
+bool loadDevice(PFN_vkGetDeviceProcAddr getDeviceProcAddr, VkDevice device, const char* name, Function* function) {
+    *function = reinterpret_cast<Function>(getDeviceProcAddr(device, name));
+    return *function != nullptr;
+}
+
+uint32_t memoryType(const VkPhysicalDeviceMemoryProperties& memory, uint32_t bits) {
+    // Device memory that the CPU cannot see: MoltenVK allocates nothing for an image on its own texture
+    const VkMemoryPropertyFlags unwantedFlags[] = {VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT, 0};
+    for (VkMemoryPropertyFlags unwanted : unwantedFlags) {
+        for (uint32_t index = 0; index < memory.memoryTypeCount; ++index) {
+            const VkMemoryPropertyFlags flags = memory.memoryTypes[index].propertyFlags;
+            if ((bits & (1u << index)) != 0 && (flags & VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT) != 0 &&
+                (flags & unwanted) == 0) {
+                return index;
+            }
+        }
+    }
+    return UINT32_MAX;
+}
+
+bool bindMemory(basalt::VulkanSession* session, VkImage image, VkDeviceMemory* memory) {
+    VkMemoryRequirements requirements{};
+    session->getImageMemoryRequirements(session->device, image, &requirements);
+    auto allocateInfo = vkStruct<VkMemoryAllocateInfo>(VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO);
+    allocateInfo.allocationSize = requirements.size;
+    allocateInfo.memoryTypeIndex = memoryType(session->memory, requirements.memoryTypeBits);
+    if (allocateInfo.memoryTypeIndex == UINT32_MAX ||
+        session->allocateMemory(session->device, &allocateInfo, nullptr, memory) != VK_SUCCESS) {
+        *memory = VK_NULL_HANDLE;
+        return false;
+    }
+    return session->bindImageMemory(session->device, image, *memory, 0) == VK_SUCCESS;
+}
+
+VkImageUsageFlags imageUsage(XrSwapchainUsageFlags usage) {
+    VkImageUsageFlags flags = VK_IMAGE_USAGE_TRANSFER_SRC_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT;
+    if ((usage & XR_SWAPCHAIN_USAGE_COLOR_ATTACHMENT_BIT) != 0) {
+        flags |= VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT;
+    }
+    if ((usage & XR_SWAPCHAIN_USAGE_UNORDERED_ACCESS_BIT) != 0) {
+        flags |= VK_IMAGE_USAGE_STORAGE_BIT;
+    }
+    if ((usage & XR_SWAPCHAIN_USAGE_SAMPLED_BIT) != 0) {
+        flags |= VK_IMAGE_USAGE_SAMPLED_BIT;
+    }
+    if ((usage & XR_SWAPCHAIN_USAGE_INPUT_ATTACHMENT_BIT_KHR) != 0) {
+        flags |= VK_IMAGE_USAGE_INPUT_ATTACHMENT_BIT;
+    }
+    return flags;
+}
+
+// An image on an IOSurface texture of the pool. Its Vulkan usage follows the Metal texture's
+// usage, which MoltenVK reads from the texture.
+bool createSurfaceImage(
+    basalt::VulkanSession* session,
+    const XrSwapchainCreateInfo* createInfo,
+    VkImageUsageFlags usage,
+    VkImageCreateFlags flags,
+    basalt::VulkanSwapchainImages* owner,
+    VkImage* image,
+    VkDeviceMemory* memory,
+    uint32_t* iosurfaceId) {
+    uint32_t metalUsage = kWmtUsageShaderRead | kWmtUsageRenderTarget | kWmtUsagePixelFormatView;
+    if ((usage & VK_IMAGE_USAGE_STORAGE_BIT) != 0) {
+        metalUsage |= kWmtUsageShaderWrite;
+    }
+    const uint32_t pixelFormat = createInfo->format == VK_FORMAT_B8G8R8A8_SRGB
+        ? kWmtPixelFormatBgra8UnormSrgb : kWmtPixelFormatBgra8Unorm;
+    const size_t index = takeTexture(createInfo->width, createInfo->height, pixelFormat, metalUsage);
+    if (index == SIZE_MAX) {
+        return false;
+    }
+    owner->pooledTextures[owner->pooledCount++] = index;
+    const PooledTexture texture = pooledTexture(index);
+
+    auto import = vkStruct<VkImportMetalTextureInfoEXT>(VK_STRUCTURE_TYPE_IMPORT_METAL_TEXTURE_INFO_EXT);
+    import.plane = VK_IMAGE_ASPECT_PLANE_0_BIT;
+    import.mtlTexture = reinterpret_cast<MTLTexture_id>(static_cast<uintptr_t>(texture.texture));
+    auto imageInfo = vkStruct<VkImageCreateInfo>(VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO);
+    imageInfo.pNext = &import;
+    imageInfo.flags = flags;
+    imageInfo.imageType = VK_IMAGE_TYPE_2D;
+    imageInfo.format = static_cast<VkFormat>(createInfo->format);
+    imageInfo.extent = {createInfo->width, createInfo->height, 1};
+    imageInfo.mipLevels = 1;
+    imageInfo.arrayLayers = 1;
+    imageInfo.samples = VK_SAMPLE_COUNT_1_BIT;
+    imageInfo.tiling = VK_IMAGE_TILING_OPTIMAL;
+    imageInfo.usage = usage;
+    imageInfo.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+    imageInfo.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+    if (session->createImage(session->device, &imageInfo, nullptr, image) != VK_SUCCESS) {
+        *image = VK_NULL_HANDLE;
+        return false;
+    }
+    *iosurfaceId = texture.iosurfaceId;
+    return bindMemory(session, *image, memory);
+}
+
+// --- the frame handoff ------------------------------------------------------------------------
+
+// A plain struct with the functions of basalt::FrameSync (see control.hpp for why not a class)
+struct FrameSlot {
+    VkCommandBuffer commands;
+    VkFence fence;
+    bool submitted;
+    // Set by the waiter once it has passed the slot's frame
+    volatile LONG waited;
+    uint64_t frameNumber;
+    LARGE_INTEGER signaledAt;
+};
+
+// Eight slots: the frame budget keeps at most three frames unconsumed, so the slot of a frame
+// eight frames back is always free
+constexpr uint32_t kFrameSlots = 8;
+
+struct VulkanFrameSync {
+    basalt::FrameSync base;
+    basalt::VulkanSession* session;
+    VkCommandPool pool;
+    FrameSlot slots[kFrameSlots];
+    uint64_t next;
+    bool recording;
+    // The waiter's counts for the note; submitSeconds comes from the xrEndFrame thread and is read
+    // without a lock, as a rough figure
+    uint64_t waitedFrames;
+    double submitSeconds;
+    double gpuSum;
+    double gpuMax;
+};
+
+LARGE_INTEGER counterNow() {
+    LARGE_INTEGER counter{};
+    QueryPerformanceCounter(&counter);
+    return counter;
+}
+
+double secondsBetween(LARGE_INTEGER from, LARGE_INTEGER to) {
+    LARGE_INTEGER frequency{};
+    QueryPerformanceFrequency(&frequency);
+    return static_cast<double>(to.QuadPart - from.QuadPart) / static_cast<double>(frequency.QuadPart);
+}
+
+bool slotReusable(FrameSlot& slot) {
+    return !slot.submitted || InterlockedCompareExchange(&slot.waited, 0, 0) != 0;
+}
+
+// One slice of the game's private two-slice image into its IOSurface image. The game releases
+// the image as a color attachment, and gets it back the same way.
+void recordSliceCopy(basalt::VulkanSession* session, VkCommandBuffer commands,
+                     const basalt::VulkanSwapchainImages& images, uint32_t image, uint32_t slice) {
+    VkImageMemoryBarrier barriers[2] = {vkStruct<VkImageMemoryBarrier>(VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER),
+                                        vkStruct<VkImageMemoryBarrier>(VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER)};
+    barriers[0].srcAccessMask = VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT;
+    barriers[0].dstAccessMask = VK_ACCESS_TRANSFER_READ_BIT;
+    barriers[0].oldLayout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+    barriers[0].newLayout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL;
+    barriers[0].srcQueueFamilyIndex = barriers[0].dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    barriers[0].image = images.images[image];
+    barriers[0].subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, slice, 1};
+    barriers[1].srcAccessMask = 0;
+    barriers[1].dstAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+    barriers[1].oldLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+    barriers[1].newLayout = VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL;
+    barriers[1].srcQueueFamilyIndex = barriers[1].dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    barriers[1].image = images.exports[image][slice];
+    barriers[1].subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1};
+    session->cmdPipelineBarrier(commands, VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT,
+                                VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 0, nullptr, 0, nullptr, 2, barriers);
+    VkImageCopy region{};
+    region.srcSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, slice, 1};
+    region.dstSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+    region.extent = {images.width, images.height, 1};
+    session->cmdCopyImage(commands, images.images[image], VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+                          images.exports[image][slice], VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &region);
+    VkImageMemoryBarrier back = barriers[0];
+    back.srcAccessMask = VK_ACCESS_TRANSFER_READ_BIT;
+    back.dstAccessMask = VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT;
+    back.oldLayout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL;
+    back.newLayout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+    session->cmdPipelineBarrier(commands, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                                VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT, 0, 0, nullptr, 0, nullptr, 1, &back);
+}
+
+bool vulkanPrepareView(basalt::FrameSync* base, basalt::ControlFrameView* view) {
+    auto* sync = reinterpret_cast<VulkanFrameSync*>(base);
+    basalt::VulkanSwapchainImages* images = nullptr;
+    uint32_t image = 0;
+    uint32_t slice = 0;
+    if (!basalt::vulkanSwapchainViewForExport(view, &images, &image, &slice)) {
+        return false;
+    }
+    if (images == nullptr || images->arraySize == 1) {
+        return true;
+    }
+    FrameSlot& slot = sync->slots[sync->next % kFrameSlots];
+    if (!slotReusable(slot)) {
+        return false;
+    }
+    basalt::VulkanSession* session = sync->session;
+    if (!sync->recording) {
+        auto beginInfo = vkStruct<VkCommandBufferBeginInfo>(VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO);
+        beginInfo.flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT;
+        if (session->resetCommandBuffer(slot.commands, 0) != VK_SUCCESS ||
+            session->beginCommandBuffer(slot.commands, &beginInfo) != VK_SUCCESS) {
+            return false;
+        }
+        sync->recording = true;
+    }
+    recordSliceCopy(session, slot.commands, *images, image, slice);
+    return true;
+}
+
+bool vulkanSignal(basalt::FrameSync* base, uint64_t frameNumber) {
+    auto* sync = reinterpret_cast<VulkanFrameSync*>(base);
+    basalt::VulkanSession* session = sync->session;
+    if (frameNumber != sync->next) {
+        return false;
+    }
+    FrameSlot& slot = sync->slots[sync->next % kFrameSlots];
+    if (!slotReusable(slot)) {
+        return false;
+    }
+    const LARGE_INTEGER start = counterNow();
+    if (slot.submitted && session->resetFences(session->device, 1, &slot.fence) != VK_SUCCESS) {
+        return false;
+    }
+    auto submitInfo = vkStruct<VkSubmitInfo>(VK_STRUCTURE_TYPE_SUBMIT_INFO);
+    if (sync->recording) {
+        sync->recording = false;
+        if (session->endCommandBuffer(slot.commands) != VK_SUCCESS) {
+            return false;
+        }
+        submitInfo.commandBufferCount = 1;
+        submitInfo.pCommandBuffers = &slot.commands;
+    }
+    // A submission without command buffers signals its fence once every earlier submission to the
+    // queue has finished: the game's commands for this frame
+    const VkResult result = session->queueSubmit(
+        session->queue, submitInfo.commandBufferCount == 0 ? 0 : 1, &submitInfo, slot.fence);
+    InterlockedExchange(&slot.waited, 0);
+    slot.submitted = true;
+    slot.frameNumber = frameNumber;
+    slot.signaledAt = counterNow();
+    sync->submitSeconds += secondsBetween(start, slot.signaledAt);
+    ++sync->next;
+    return result == VK_SUCCESS;
+}
+
+bool vulkanWait(basalt::FrameSync* base, uint64_t frameNumber, DWORD milliseconds) {
+    auto* sync = reinterpret_cast<VulkanFrameSync*>(base);
+    basalt::VulkanSession* session = sync->session;
+    FrameSlot& slot = sync->slots[frameNumber % kFrameSlots];
+    if (!slot.submitted || slot.frameNumber != frameNumber) {
+        return false;
+    }
+    const VkResult result = session->waitForFences(
+        session->device, 1, &slot.fence, VK_TRUE, static_cast<uint64_t>(milliseconds) * 1000000ull);
+    const double gpuSeconds = secondsBetween(slot.signaledAt, counterNow());
+    InterlockedExchange(&slot.waited, 1);
+    if (result != VK_SUCCESS) {
+        return false;
+    }
+    // The cost of the handoff, every 600 frames: the CPU time of the fence's submission in
+    // xrEndFrame, and how long after it the GPU finished the frame
+    sync->gpuSum += gpuSeconds;
+    sync->gpuMax = gpuSeconds > sync->gpuMax ? gpuSeconds : sync->gpuMax;
+    if (++sync->waitedFrames % 600 == 0) {
+        basalt::note(
+            "Basalt OpenXR: Vulkan frames: %llu sent; in the last 600 the fence's submission took %.3f ms on average, and the GPU "
+            "finished a frame %.2f ms after xrEndFrame on average (%.2f ms at most)\n",
+            static_cast<unsigned long long>(sync->waitedFrames), sync->submitSeconds / 600.0 * 1000.0,
+            sync->gpuSum / 600.0 * 1000.0, sync->gpuMax * 1000.0);
+        sync->submitSeconds = 0.0;
+        sync->gpuSum = 0.0;
+        sync->gpuMax = 0.0;
+    }
+    return true;
+}
+
+void vulkanDestroy(basalt::FrameSync* base) {
+    auto* sync = reinterpret_cast<VulkanFrameSync*>(base);
+    basalt::VulkanSession* session = sync->session;
+    for (FrameSlot& slot : sync->slots) {
+        if (slot.fence == VK_NULL_HANDLE) {
+            continue;
+        }
+        // A fence must not be destroyed while its submission runs
+        if (slot.submitted) {
+            session->waitForFences(session->device, 1, &slot.fence, VK_TRUE, 1000000000ull);
+        }
+        session->destroyFence(session->device, slot.fence, nullptr);
+    }
+    if (sync->pool != VK_NULL_HANDLE) {
+        // The pool frees its command buffers
+        session->destroyCommandPool(session->device, sync->pool, nullptr);
+    }
+    std::free(sync);
+}
+
+basalt::FrameSync* makeVulkanFrameSync(basalt::VulkanSession* session) {
+    auto* sync = static_cast<VulkanFrameSync*>(std::calloc(1, sizeof(VulkanFrameSync)));
+    if (sync == nullptr) {
+        return nullptr;
+    }
+    sync->base = {vulkanPrepareView, vulkanSignal, vulkanWait, vulkanDestroy};
+    sync->session = session;
+    sync->next = 1;
+    auto poolInfo = vkStruct<VkCommandPoolCreateInfo>(VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO);
+    poolInfo.flags = VK_COMMAND_POOL_CREATE_RESET_COMMAND_BUFFER_BIT;
+    poolInfo.queueFamilyIndex = session->queueFamilyIndex;
+    bool ok = session->createCommandPool(session->device, &poolInfo, nullptr, &sync->pool) == VK_SUCCESS;
+    for (FrameSlot& slot : sync->slots) {
+        auto bufferInfo = vkStruct<VkCommandBufferAllocateInfo>(VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO);
+        bufferInfo.commandPool = sync->pool;
+        bufferInfo.level = VK_COMMAND_BUFFER_LEVEL_PRIMARY;
+        bufferInfo.commandBufferCount = 1;
+        auto fenceInfo = vkStruct<VkFenceCreateInfo>(VK_STRUCTURE_TYPE_FENCE_CREATE_INFO);
+        slot.waited = 1;
+        ok = ok && session->allocateCommandBuffers(session->device, &bufferInfo, &slot.commands) == VK_SUCCESS &&
+             session->createFence(session->device, &fenceInfo, nullptr, &slot.fence) == VK_SUCCESS;
+    }
+    if (!ok) {
+        vulkanDestroy(&sync->base);
+        return nullptr;
+    }
+    return &sync->base;
+}
+
