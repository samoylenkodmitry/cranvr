+// cranvr: the mailbox messages that wait for a daemon. OpenComposite restarts its session at the game's first frame, and
+// the connection to the daemon ends with the old session: a message of the gap waits for the new connection. The
+// newest messages wait, the oldest go when more come.
+constexpr size_t kMailboxCapacity = BASALT_CONTROL_MAX_MESSAGE_LENGTH - sizeof(uint16_t);
+constexpr uint32_t kHeldMailboxMessages = 8;
+struct HeldMailboxMessage {
+    size_t length;
+    uint8_t payload[kMailboxCapacity];
+};
+SRWLOCK gMailboxLock = SRWLOCK_INIT;
+HeldMailboxMessage gHeldMailbox[kHeldMailboxMessages];
+uint32_t gHeldMailboxFirst = 0;
+uint32_t gHeldMailboxCount = 0;
+
+// The socket of a connected daemon, or INVALID_SOCKET
+SOCKET mailboxSocket() {
+    AcquireSRWLockShared(&gControlLock);
+    const SOCKET socket = gSocket != INVALID_SOCKET && !gReceiverFailed ? gSocket : INVALID_SOCKET;
+    ReleaseSRWLockShared(&gControlLock);
+    return socket;
+}
+
+// Sends the messages that wait, in their order. The caller holds gMailboxLock.
+void sendHeldMailboxMessagesLocked(SOCKET socket) {
+    while (gHeldMailboxCount > 0) {
+        const HeldMailboxMessage& held = gHeldMailbox[gHeldMailboxFirst];
+        if (!sendMessage(socket, BASALT_MSG_MAILBOX_MESSAGE, held.payload, held.length)) {
+            return;
+        }
+        gHeldMailboxFirst = (gHeldMailboxFirst + 1) % kHeldMailboxMessages;
+        --gHeldMailboxCount;
+    }
+}
