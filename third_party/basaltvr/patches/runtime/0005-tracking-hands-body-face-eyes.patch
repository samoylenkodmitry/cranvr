+uint32_t controlTrackingOffered() {
+    if (!basaltGateEnabled()) {
+        return 0;
+    }
+    char path[MAX_PATH]{};
+    char program[MAX_PATH]{};
+    if (!siblingAndProgram("tracking-features.txt", path, program)) {
+        return 0;
+    }
+    FILE* file = std::fopen(path, "r");
+    if (file == nullptr) {
+        return 0;
+    }
+    char text[128]{};
+    const size_t length = std::fread(text, 1, sizeof(text) - 1, file);
+    std::fclose(file);
+    text[length] = '\0';
+    uint32_t offered = 0;
+    for (char* word = std::strtok(text, " \t\r\n"); word != nullptr;
+         word = std::strtok(nullptr, " \t\r\n")) {
+        if (std::strcmp(word, "hands") == 0) {
+            offered |= BASALT_TRACKING_HANDS;
+        } else if (std::strcmp(word, "body") == 0) {
+            offered |= BASALT_TRACKING_BODY;
+        } else if (std::strcmp(word, "full_body") == 0) {
+            offered |= BASALT_TRACKING_FULL_BODY;
+        } else if (std::strcmp(word, "face") == 0) {
+            offered |= BASALT_TRACKING_FACE;
+        } else if (std::strcmp(word, "eyes") == 0) {
+            offered |= BASALT_TRACKING_EYES;
+        }
+    }
+    return offered;
+}
