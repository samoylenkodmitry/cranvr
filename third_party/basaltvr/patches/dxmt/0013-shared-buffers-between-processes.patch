diff --git a/src/d3d11/d3d11_shared_buffer.hpp b/src/d3d11/d3d11_shared_buffer.hpp
new file mode 100644
index 0000000..3285323
--- /dev/null
+++ b/src/d3d11/d3d11_shared_buffer.hpp
@@ -0,0 +1,110 @@
+#pragma once
+/*
+ * cranvr: a buffer created with D3D11_RESOURCE_MISC_SHARED is shared with other processes.
+ *
+ * SteamVR's compositor creates a constant buffer with each frame's information as a shared resource and stops
+ * when it gets no handle ("Failed to create shared frame info constant buffer!"). Each OpenVR program opens the
+ * buffer and copies it into a buffer that its CPU reads ("Failed to open frame info buffer"). DXMT shared
+ * textures only.
+ *
+ * The memory of such a buffer is a Windows file mapping, which Wine maps into each process that opens it. The
+ * Metal buffer of each process lies on that memory (newBufferWithBytesNoCopy), so the GPU of one process
+ * writes what the other process reads: Apple's GPUs share the memory with the CPU. The buffer has a D3DKMT
+ * allocation like a shared texture. Its private data names the mapping and holds the buffer's description,
+ * and its size (96 bytes) tells an open that the handle names a buffer.
+ */
+#include "d3d11_device.hpp"
+#include "util_win32_compat.h"
+#include <atomic>
+#include <cstdio>
+#include <cstring>
+
+namespace dxmt {
+
+struct SharedBufferData {
+  char magic[8];
+  D3D11_BUFFER_DESC desc;
+  uint32_t mapped_size;
+  char mapping[60];
+};
+// ImportSharedTexture in d3d11_texture_device.cpp tells a buffer by this size
+static_assert(sizeof(SharedBufferData) == 96);
+
+/* The memory of a shared buffer in this process. The view stays mapped while the process lives: a command buffer
+ * may still use the Metal buffer that lies on it after the D3D11 buffer is gone. */
+struct SharedBufferMemory {
+  HANDLE mapping = nullptr;
+  void *view = nullptr;
+  uint32_t size = 0;
+};
+
+/* Makes the file mapping of a new shared buffer and fills in its private data. */
+inline bool
+MakeSharedBufferMemory(const D3D11_BUFFER_DESC &desc, SharedBufferData &data, SharedBufferMemory &memory) {
+  static std::atomic<uint32_t> counter{0};
+  memset(&data, 0, sizeof(data));
+  memcpy(data.magic, "dxmtbuf", 8);
+  data.desc = desc;
+  // Metal wants whole pages under a buffer that lies on memory of its caller
+  data.mapped_size = (std::max(desc.ByteWidth, 256u) + 0xffffu) & ~0xffffu;
+  snprintf(data.mapping, sizeof(data.mapping), "Local\\dxmt-shared-buffer-%lu-%u", GetCurrentProcessId(), counter++);
+  memory.mapping = CreateFileMappingA(INVALID_HANDLE_VALUE, nullptr, PAGE_READWRITE, 0, data.mapped_size, data.mapping);
+  if (!memory.mapping)
+    return false;
+  memory.view = MapViewOfFile(memory.mapping, FILE_MAP_ALL_ACCESS, 0, 0, data.mapped_size);
+  if (!memory.view) {
+    CloseHandle(memory.mapping);
+    memory.mapping = nullptr;
+    return false;
+  }
+  memory.size = data.mapped_size;
+  return true;
+}
+
+/* Maps the memory of a buffer that another process shared. */
+inline bool
+OpenSharedBufferMemory(const SharedBufferData &data, SharedBufferMemory &memory) {
+  char name[sizeof(data.mapping) + 1] = {};
+  memcpy(name, data.mapping, sizeof(data.mapping));
+  memory.mapping = OpenFileMappingA(FILE_MAP_ALL_ACCESS, FALSE, name);
+  if (!memory.mapping)
+    return false;
+  memory.view = MapViewOfFile(memory.mapping, FILE_MAP_ALL_ACCESS, 0, 0, data.mapped_size);
+  if (!memory.view) {
+    CloseHandle(memory.mapping);
+    memory.mapping = nullptr;
+    return false;
+  }
+  memory.size = data.mapped_size;
+  return true;
+}
+
+/* Makes the D3DKMT allocation that gives a shared buffer its global handle. */
+inline bool
+ShareBuffer(MTLD3D11Device *pDevice, SharedBufferData &data, D3DKMT_HANDLE *local, D3DKMT_HANDLE *global) {
+  if (!(pDevice->GetLocalD3DKMT() & 0xc0000000))
+    return false;
+  D3DKMT_CREATEALLOCATION create = {};
+  create.hDevice = pDevice->GetLocalD3DKMT();
+  create.pPrivateRuntimeData = &data;
+  create.PrivateRuntimeDataSize = sizeof(data);
+  create.Flags.StandardAllocation = 1;
+  create.NumAllocations = 1;
+  D3DDDI_ALLOCATIONINFO2 allocationInfo = {};
+  create.pAllocationInfo2 = &allocationInfo;
+  D3DKMT_CREATESTANDARDALLOCATION standardAllocation = {};
+  create.pStandardAllocation = &standardAllocation;
+  standardAllocation.Type = D3DKMT_STANDARDALLOCATIONTYPE_EXISTINGHEAP;
+  create.Flags.ExistingSysMem = 1;
+  D3DDDI_ALLOCATIONINFO systemMem = {};
+  allocationInfo.pSystemMem = &systemMem;
+  create.Flags.CreateResource = 1;
+  create.Flags.CreateShared = 1;
+  if (D3DKMTCreateAllocation2(&create))
+    return false;
+  *local = create.hResource;
+  *global = create.hGlobalShare;
+  return true;
+}
+
+} // namespace dxmt
