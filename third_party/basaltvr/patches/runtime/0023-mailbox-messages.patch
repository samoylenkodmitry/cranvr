+bool controlSendMailboxMessage(const char* address, const char* message) {
+    const size_t addressLength = std::strlen(address);
+    const size_t messageLength = std::strlen(message);
+    if (2 * sizeof(uint16_t) + addressLength + messageLength > kMailboxCapacity) {
+        note("cranvr: a mailbox message to %s has %zu bytes, more than the daemon takes: it is dropped\n", address, messageLength);
+        return false;
+    }
+    AcquireSRWLockExclusive(&gMailboxLock);
+    const SOCKET socket = mailboxSocket();
+    if (socket != INVALID_SOCKET) {
+        sendHeldMailboxMessagesLocked(socket);
+    }
+    HeldMailboxMessage* slot = nullptr;
+    if (socket == INVALID_SOCKET || gHeldMailboxCount > 0) {
+        if (gHeldMailboxCount == kHeldMailboxMessages) {
+            gHeldMailboxFirst = (gHeldMailboxFirst + 1) % kHeldMailboxMessages;
+            --gHeldMailboxCount;
+        }
+        slot = &gHeldMailbox[(gHeldMailboxFirst + gHeldMailboxCount) % kHeldMailboxMessages];
+        ++gHeldMailboxCount;
+        note("cranvr: no daemon is connected: a mailbox message to %s waits for the next connection\n", address);
+    }
+    static uint8_t sending[kMailboxCapacity];
+    uint8_t* payload = slot != nullptr ? slot->payload : sending;
+    MessageWriter writer(payload, kMailboxCapacity);
+    writer.u16(static_cast<uint16_t>(addressLength));
+    writer.bytes(address, addressLength);
+    writer.u16(static_cast<uint16_t>(messageLength));
+    writer.bytes(message, messageLength);
+    bool sent = false;
+    if (slot != nullptr) {
+        slot->length = writer.length();
+    } else {
+        sent = writer.ok() && sendMessage(socket, BASALT_MSG_MAILBOX_MESSAGE, payload, writer.length());
+    }
+    ReleaseSRWLockExclusive(&gMailboxLock);
+    return sent;
+}
