Subject: [PATCH] d3d11: an optional skip of the Mac window present (cranvr)

DXMT_SKIP_PRESENT=1 flushes each frame without drawing it into the game's
Mac window, as DXMT does for a minimized window, but reports success. A VR
game shows its picture in the headset; its mirror window on the Mac costs
GPU time for nothing.
---
diff --git a/src/d3d11/d3d11_swapchain.cpp b/src/d3d11/d3d11_swapchain.cpp
index 5e9404d..d47ca29 100644
--- a/src/d3d11/d3d11_swapchain.cpp
+++ b/src/d3d11/d3d11_swapchain.cpp
@@ -758,6 +758,16 @@ public:
       device_context_->Commit();
       return hr;
     }
+    // cranvr: DXMT_SKIP_PRESENT=1 flushes the frame without drawing it into the
+    // Mac window, as for a minimized window, but reports success: a VR game
+    // shows its picture in the headset, and its mirror window on the Mac costs
+    // GPU time for nothing. The waitable object still counts the frame.
+    static const bool skip_present = env::getEnvVar("DXMT_SKIP_PRESENT") == "1";
+    if (skip_present) {
+      device_context_->Commit();
+      ReleaseSemaphore(present_semaphore_, 1, nullptr);
+      return S_OK;
+    }
 
     double vsync_duration =
         std::max(SyncInterval * 1.0 /
