diff --git i/src/d3d11/d3d11_fence.hpp w/src/d3d11/d3d11_fence.hpp
index f98d37e..6fafb32 100644
--- i/src/d3d11/d3d11_fence.hpp
+++ w/src/d3d11/d3d11_fence.hpp
@@ -1,12 +1,26 @@
 #pragma once
 #include "d3d11_device.hpp"
 #include "util_d3dkmt.h"
+#include <atomic>
 
 namespace dxmt {
 
 struct MTLD3D11Fence : public ID3D11Fence {
   WMT::Reference<WMT::SharedEvent> event;
   D3DKMT_HANDLE local_kmt = 0;
+  /* cranvr: the fence came from another process (OpenSharedFence). Its first wait of each kind gets a log line, so a
+     run tells which process waits on a fence that another process signals. */
+  bool opened = false;
+  std::atomic<bool> waited_on_cpu{false};
+  std::atomic<bool> waited_on_gpu{false};
+
+  void NoteWait(bool gpu, UINT64 Value) {
+    if (!opened || (gpu ? waited_on_gpu : waited_on_cpu).exchange(true))
+      return;
+    Logger::info(str::format("D3D11Fence: process ", GetCurrentProcessId(), " waits for the first time on the ",
+                             gpu ? "GPU" : "CPU", " for value ", Value, " of a fence that another process shared (now ",
+                             event.signaledValue(), ")"));
+  }
 };
 
