new file mode 100644
index 0000000..a3f308a
--- /dev/null
+++ w/runtime/tests/hand_interaction_smoke.cpp
@@ -0,0 +1,695 @@
+// cranvr: reads the hand interaction profile of XR_EXT_hand_interaction while it drives cranvr-host's
+// test hand (host/src/test_input.rs) through the host's words file. The program binds that profile
+// alone, as a game with hand code and no controller bindings does, or with the Touch controller's
+// profile (--profiles both). It creates no hand tracker. The probe's head stands still, so the
+// expected poses come from the head's pose and the words.
+//
+// Usage: hand_interaction_smoke.exe --words FILE [--profiles hand|both] [--seconds N]
+//   --words     the file that the host reads its test hand from (CRANVR_TEST_INPUT), as a Windows
+//               path (Z:\... in Wine). The program writes it at each step.
+//   --profiles  hand (default): only /interaction_profiles/ext/hand_interaction_ext. The right hand
+//               is the test hand, the left hand is the probe's controller, which the runtime maps
+//               onto the profile. both: the Touch controller's profile as well. The right hand
+//               then switches between the two profiles when the test hand comes and goes.
+//   --seconds   the longest time for each step (default 6)
+//
+// The axes that the checks expect come from the extension's text for the test hand's pose, not from
+// the formulas of the host. It prints one line for each check and ends with
+// "hand_interaction_smoke: PASS" or "hand_interaction_smoke: FAIL". scripts/e2e.sh --hand-interaction
+// runs it.
+
+#include <windows.h>
+
+#include <d3d11_1.h>
+#include <dxgi1_2.h>
+
+#include <openxr/openxr.h>
+#include <openxr/openxr_platform.h>
+
+#include <algorithm>
+#include <cmath>
+#include <cstdarg>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <functional>
+#include <string>
+#include <vector>
+
+namespace {
+
+int gProblems = 0;
+
+template <typename T>
+T make(XrStructureType type) {
+    T value{};
+    value.type = type;
+    return value;
+}
+
+void report(bool ok, const char* format, ...) {
+    char text[640];
+    va_list arguments;
+    va_start(arguments, format);
+    std::vsnprintf(text, sizeof(text), format, arguments);
+    va_end(arguments);
+    std::printf("hand_interaction_smoke: %s %s\n", ok ? "ok  " : "FAIL", text);
+    std::fflush(stdout);
+    if (!ok) {
+        ++gProblems;
+    }
+}
+
+int finish(const char* reason) {
+    std::printf("hand_interaction_smoke: %s\n", reason);
+    std::printf("hand_interaction_smoke: FAIL\n");
+    std::fflush(stdout);
+    return 1;
+}
+
+uint64_t unixMilliseconds() {
+    FILETIME time{};
+    GetSystemTimeAsFileTime(&time);
+    const uint64_t ticks = (static_cast<uint64_t>(time.dwHighDateTime) << 32) | time.dwLowDateTime;
+    return (ticks - 116444736000000000ULL) / 10000ULL;
+}
+
+XrVector3f rotate(const XrQuaternionf& q, const XrVector3f& v) {
+    const XrVector3f u{q.x, q.y, q.z};
+    const XrVector3f t{2.0f * (u.y * v.z - u.z * v.y), 2.0f * (u.z * v.x - u.x * v.z), 2.0f * (u.x * v.y - u.y * v.x)};
+    return {v.x + q.w * t.x + (u.y * t.z - u.z * t.y), v.y + q.w * t.y + (u.z * t.x - u.x * t.z),
+            v.z + q.w * t.z + (u.x * t.y - u.y * t.x)};
+}
+
+XrVector3f add(const XrVector3f& a, const XrVector3f& b) {
+    return {a.x + b.x, a.y + b.y, a.z + b.z};
+}
+
+XrVector3f subtract(const XrVector3f& a, const XrVector3f& b) {
+    return {a.x - b.x, a.y - b.y, a.z - b.z};
+}
+
+float dot(const XrVector3f& a, const XrVector3f& b) {
+    return a.x * b.x + a.y * b.y + a.z * b.z;
+}
+
+float length(const XrVector3f& a) {
+    return std::sqrt(dot(a, a));
+}
+
+// The direction of one axis of a pose
+XrVector3f axis(const XrPosef& pose, float x, float y, float z) {
+    return rotate(pose.orientation, {x, y, z});
+}
+
+bool writeWords(const std::string& path, const char* words) {
+    const std::string temporary = path + ".new";
+    FILE* file = std::fopen(temporary.c_str(), "w");
+    if (file == nullptr) {
+        return false;
+    }
+    std::fputs(words, file);
+    std::fputs("\n", file);
+    std::fclose(file);
+    // The host reads the file every 30 ms: a rename gives it the whole words at once
+    return MoveFileExA(temporary.c_str(), path.c_str(), MOVEFILE_REPLACE_EXISTING) != 0;
+}
+
+template <typename F>
+F procedure(XrInstance instance, const char* name) {
+    PFN_xrVoidFunction function = nullptr;
+    if (XR_FAILED(xrGetInstanceProcAddr(instance, name, &function))) {
+        return nullptr;
+    }
+    return reinterpret_cast<F>(function);
+}
+
+#define CHECK_XR(call)                                                                                 \
+    do {                                                                                               \
+        const XrResult checked = (call);                                                               \
+        if (XR_FAILED(checked)) {                                                                      \
+            std::printf("hand_interaction_smoke: %s returned %d\n", #call, static_cast<int>(checked)); \
+            return finish("an OpenXR call failed");                                                    \
+        }                                                                                              \
+    } while (false)
+
+// The poses of the profile, in the order of the actions
+enum PoseIndex { kGrip = 0, kAim = 1, kPinch = 2, kPoke = 3, kPoseCount = 4 };
+const char* const kPoseNames[kPoseCount] = {"grip", "aim", "pinch", "poke"};
+const char* const kPosePaths[kPoseCount] = {"/input/grip/pose", "/input/aim/pose", "/input/pinch_ext/pose",
+                                           "/input/poke_ext/pose"};
+// The gestures: a value and its ready path each
+enum GestureIndex { kPinchGesture = 0, kAimActivate = 1, kGrasp = 2, kGestureCount = 3 };
+const char* const kGestureNames[kGestureCount] = {"pinch", "aim_activate", "grasp"};
+
+struct HandReading {
+    XrPath profile = XR_NULL_PATH;
+    bool valueActive[kGestureCount]{};
+    float value[kGestureCount]{};
+    bool readyActive[kGestureCount]{};
+    bool ready[kGestureCount]{};
+    bool poseValid[kPoseCount]{};
+    XrPosef pose[kPoseCount]{};
+
+    bool allReady() const {
+        return ready[0] && ready[1] && ready[2];
+    }
+    bool allPoses() const {
+        return poseValid[0] && poseValid[1] && poseValid[2] && poseValid[3];
+    }
+};
+
+struct Reading {
+    bool focused = false;
+    bool headValid = false;
+    XrPosef head{};
+    HandReading hands[2];
+};
+
+}  // namespace
+
+int main(int argc, char** argv) {
+    std::string wordsPath;
+    bool both = false;
+    double stepSeconds = 6.0;
+    for (int index = 1; index < argc; ++index) {
+        if (std::strcmp(argv[index], "--words") == 0 && index + 1 < argc) {
+            wordsPath = argv[++index];
+        } else if (std::strcmp(argv[index], "--profiles") == 0 && index + 1 < argc) {
+            const char* value = argv[++index];
+            if (std::strcmp(value, "both") == 0) {
+                both = true;
+            } else if (std::strcmp(value, "hand") != 0) {
+                std::fputs("hand_interaction_smoke: --profiles takes hand or both\n", stderr);
+                return 2;
+            }
+        } else if (std::strcmp(argv[index], "--seconds") == 0 && index + 1 < argc) {
+            stepSeconds = std::atof(argv[++index]);
+        } else {
+            std::fputs("usage: hand_interaction_smoke --words FILE [--profiles hand|both] [--seconds N]\n", stderr);
+            return 2;
+        }
+    }
+    if (wordsPath.empty()) {
+        std::fputs("hand_interaction_smoke: --words FILE is required\n", stderr);
+        return 2;
+    }
+    // No test hand at the start: both hands are the probe's controllers
+    if (!writeWords(wordsPath, both ? "hand=0" : "")) {
+        return finish("the words file cannot be written");
+    }
+
+    // The runtime lists the extension with its graphics extension
+    uint32_t count = 0;
+    CHECK_XR(xrEnumerateInstanceExtensionProperties(nullptr, 0, &count, nullptr));
+    std::vector<XrExtensionProperties> properties(count, make<XrExtensionProperties>(XR_TYPE_EXTENSION_PROPERTIES));
+    CHECK_XR(xrEnumerateInstanceExtensionProperties(nullptr, count, &count, properties.data()));
+    uint32_t listedVersion = 0;
+    for (const XrExtensionProperties& property : properties) {
+        if (std::strcmp(property.extensionName, XR_EXT_HAND_INTERACTION_EXTENSION_NAME) == 0) {
+            listedVersion = property.extensionVersion;
+        }
+    }
+    report(listedVersion == XR_EXT_hand_interaction_SPEC_VERSION, "the runtime lists %s version %u",
+           XR_EXT_HAND_INTERACTION_EXTENSION_NAME, listedVersion);
+    if (listedVersion == 0) {
+        return finish("the extension is not listed");
+    }
+
+    const char* enabled[] = {XR_KHR_D3D11_ENABLE_EXTENSION_NAME, XR_EXT_HAND_INTERACTION_EXTENSION_NAME};
+    XrInstanceCreateInfo instanceInfo = make<XrInstanceCreateInfo>(XR_TYPE_INSTANCE_CREATE_INFO);
+    instanceInfo.enabledExtensionCount = 2;
+    instanceInfo.enabledExtensionNames = enabled;
+    instanceInfo.applicationInfo.apiVersion = XR_API_VERSION_1_0;
+    std::strncpy(instanceInfo.applicationInfo.applicationName, "cranvr hand interaction smoke",
+                 XR_MAX_APPLICATION_NAME_SIZE - 1);
+    XrInstance instance = XR_NULL_HANDLE;
+    CHECK_XR(xrCreateInstance(&instanceInfo, &instance));
+    XrSystemGetInfo systemInfo = make<XrSystemGetInfo>(XR_TYPE_SYSTEM_GET_INFO);
+    systemInfo.formFactor = XR_FORM_FACTOR_HEAD_MOUNTED_DISPLAY;
+    XrSystemId systemId = XR_NULL_SYSTEM_ID;
+    CHECK_XR(xrGetSystem(instance, &systemInfo, &systemId));
+
+    auto getRequirements = procedure<PFN_xrGetD3D11GraphicsRequirementsKHR>(instance, "xrGetD3D11GraphicsRequirementsKHR");
+    if (getRequirements == nullptr) {
+        return finish("no D3D11 requirements function");
+    }
+    XrGraphicsRequirementsD3D11KHR requirements = make<XrGraphicsRequirementsD3D11KHR>(XR_TYPE_GRAPHICS_REQUIREMENTS_D3D11_KHR);
+    CHECK_XR(getRequirements(instance, systemId, &requirements));
+    IDXGIFactory1* factory = nullptr;
+    IDXGIAdapter1* adapter = nullptr;
+    if (FAILED(CreateDXGIFactory1(__uuidof(IDXGIFactory1), reinterpret_cast<void**>(&factory))) ||
+        FAILED(factory->EnumAdapters1(0, &adapter))) {
+        return finish("no DXGI adapter");
+    }
+    const D3D_FEATURE_LEVEL levels[] = {D3D_FEATURE_LEVEL_11_0};
+    ID3D11Device* device = nullptr;
+    ID3D11DeviceContext* context = nullptr;
+    D3D_FEATURE_LEVEL level{};
+    if (FAILED(D3D11CreateDevice(adapter, D3D_DRIVER_TYPE_UNKNOWN, nullptr, D3D11_CREATE_DEVICE_BGRA_SUPPORT, levels, 1,
+                                 D3D11_SDK_VERSION, &device, &level, &context))) {
+        return finish("no D3D11 device");
+    }
+    XrGraphicsBindingD3D11KHR binding = make<XrGraphicsBindingD3D11KHR>(XR_TYPE_GRAPHICS_BINDING_D3D11_KHR);
+    binding.device = device;
+    XrSessionCreateInfo sessionInfo = make<XrSessionCreateInfo>(XR_TYPE_SESSION_CREATE_INFO);
+    sessionInfo.next = &binding;
+    sessionInfo.systemId = systemId;
+    XrSession session = XR_NULL_HANDLE;
+    CHECK_XR(xrCreateSession(instance, &sessionInfo, &session));
+
+    XrReferenceSpaceCreateInfo spaceInfo = make<XrReferenceSpaceCreateInfo>(XR_TYPE_REFERENCE_SPACE_CREATE_INFO);
+    spaceInfo.referenceSpaceType = XR_REFERENCE_SPACE_TYPE_LOCAL;
+    spaceInfo.poseInReferenceSpace = {{0, 0, 0, 1}, {0, 0, 0}};
+    XrSpace localSpace = XR_NULL_HANDLE;
+    CHECK_XR(xrCreateReferenceSpace(session, &spaceInfo, &localSpace));
+    spaceInfo.referenceSpaceType = XR_REFERENCE_SPACE_TYPE_VIEW;
+    XrSpace viewSpace = XR_NULL_HANDLE;
+    CHECK_XR(xrCreateReferenceSpace(session, &spaceInfo, &viewSpace));
+
+    // The paths
+    auto path = [&](const char* text) {
+        XrPath out = XR_NULL_PATH;
+        xrStringToPath(instance, text, &out);
+        return out;
+    };
+    const XrPath handPaths[2] = {path("/user/hand/left"), path("/user/hand/right")};
+    const char* const handNames[2] = {"/user/hand/left", "/user/hand/right"};
+    const XrPath handProfile = path("/interaction_profiles/ext/hand_interaction_ext");
+    const XrPath touchProfile = path("/interaction_profiles/oculus/touch_controller");
+    auto full = [&](int hand, const char* subpath) {
+        return path((std::string(handNames[hand]) + subpath).c_str());
+    };
+
+    // The actions: a value and a ready flag for each gesture, and the four poses
+    XrActionSetCreateInfo setInfo = make<XrActionSetCreateInfo>(XR_TYPE_ACTION_SET_CREATE_INFO);
+    std::strcpy(setInfo.actionSetName, "hands");
+    std::strcpy(setInfo.localizedActionSetName, "Hands");
+    XrActionSet actionSet = XR_NULL_HANDLE;
+    CHECK_XR(xrCreateActionSet(instance, &setInfo, &actionSet));
+    auto createAction = [&](const char* name, XrActionType type, XrAction* action) {
+        XrActionCreateInfo info = make<XrActionCreateInfo>(XR_TYPE_ACTION_CREATE_INFO);
+        std::strncpy(info.actionName, name, XR_MAX_ACTION_NAME_SIZE - 1);
+        std::strncpy(info.localizedActionName, name, XR_MAX_LOCALIZED_ACTION_NAME_SIZE - 1);
+        info.actionType = type;
+        info.countSubactionPaths = 2;
+        info.subactionPaths = handPaths;
+        return xrCreateAction(actionSet, &info, action);
+    };
+    XrAction valueActions[kGestureCount]{};
+    XrAction readyActions[kGestureCount]{};
+    XrAction poseActions[kPoseCount]{};
+    for (int gesture = 0; gesture < kGestureCount; ++gesture) {
+        CHECK_XR(createAction((std::string(kGestureNames[gesture]) + "_value").c_str(), XR_ACTION_TYPE_FLOAT_INPUT,
+                              &valueActions[gesture]));
+        CHECK_XR(createAction((std::string(kGestureNames[gesture]) + "_ready").c_str(), XR_ACTION_TYPE_BOOLEAN_INPUT,
+                              &readyActions[gesture]));
+    }
+    for (int pose = 0; pose < kPoseCount; ++pose) {
+        CHECK_XR(createAction((std::string(kPoseNames[pose]) + "_pose").c_str(), XR_ACTION_TYPE_POSE_INPUT,
+                              &poseActions[pose]));
+    }
+
+    // The bindings of the hand interaction profile: every path that the extension lists
+    std::vector<XrActionSuggestedBinding> handBindings;
+    const char* const gesturePaths[kGestureCount] = {"/input/pinch_ext", "/input/aim_activate_ext", "/input/grasp_ext"};
+    for (int hand = 0; hand < 2; ++hand) {
+        for (int gesture = 0; gesture < kGestureCount; ++gesture) {
+            handBindings.push_back({valueActions[gesture], full(hand, (std::string(gesturePaths[gesture]) + "/value").c_str())});
+            handBindings.push_back({readyActions[gesture], full(hand, (std::string(gesturePaths[gesture]) + "/ready_ext").c_str())});
+        }
+        for (int pose = 0; pose < kPoseCount; ++pose) {
+            handBindings.push_back({poseActions[pose], full(hand, kPosePaths[pose])});
+        }
+    }
+    XrInteractionProfileSuggestedBinding suggestion = make<XrInteractionProfileSuggestedBinding>(XR_TYPE_INTERACTION_PROFILE_SUGGESTED_BINDING);
+    suggestion.interactionProfile = handProfile;
+    suggestion.countSuggestedBindings = static_cast<uint32_t>(handBindings.size());
+    suggestion.suggestedBindings = handBindings.data();
+    report(xrSuggestInteractionProfileBindings(instance, &suggestion) == XR_SUCCESS,
+           "the runtime takes %zu bindings of the hand interaction profile", handBindings.size());
+
+    // A value path of the extension belongs to its own profile only; the pinch and poke poses
+    // belong to every profile of the hands
+    XrActionSuggestedBinding wrong{valueActions[kPinchGesture], full(0, "/input/pinch_ext/value")};
+    suggestion.interactionProfile = touchProfile;
+    suggestion.countSuggestedBindings = 1;
+    suggestion.suggestedBindings = &wrong;
+    report(xrSuggestInteractionProfileBindings(instance, &suggestion) == XR_ERROR_PATH_UNSUPPORTED,
+           "the Touch controller's profile refuses pinch_ext/value");
+    if (both) {
+        std::vector<XrActionSuggestedBinding> touchBindings;
+        for (int hand = 0; hand < 2; ++hand) {
+            touchBindings.push_back({valueActions[kPinchGesture], full(hand, "/input/trigger/value")});
+            touchBindings.push_back({valueActions[kAimActivate], full(hand, "/input/trigger/value")});
+            touchBindings.push_back({valueActions[kGrasp], full(hand, "/input/squeeze/value")});
+            for (int pose = 0; pose < kPoseCount; ++pose) {
+                touchBindings.push_back({poseActions[pose], full(hand, kPosePaths[pose])});
+            }
+        }
+        suggestion.countSuggestedBindings = static_cast<uint32_t>(touchBindings.size());
+        suggestion.suggestedBindings = touchBindings.data();
+        report(xrSuggestInteractionProfileBindings(instance, &suggestion) == XR_SUCCESS,
+               "the Touch controller's profile takes pinch_ext/pose and poke_ext/pose");
+    }
+    XrSessionActionSetsAttachInfo attach = make<XrSessionActionSetsAttachInfo>(XR_TYPE_SESSION_ACTION_SETS_ATTACH_INFO);
+    attach.countActionSets = 1;
+    attach.actionSets = &actionSet;
+    CHECK_XR(xrAttachSessionActionSets(session, &attach));
+
+    XrSpace poseSpaces[2][kPoseCount]{};
+    for (int hand = 0; hand < 2; ++hand) {
+        for (int pose = 0; pose < kPoseCount; ++pose) {
+            XrActionSpaceCreateInfo info = make<XrActionSpaceCreateInfo>(XR_TYPE_ACTION_SPACE_CREATE_INFO);
+            info.action = poseActions[pose];
+            info.subactionPath = handPaths[hand];
+            info.poseInActionSpace = {{0, 0, 0, 1}, {0, 0, 0}};
+            CHECK_XR(xrCreateActionSpace(session, &info, &poseSpaces[hand][pose]));
+        }
+    }
+
+    // The session runs: ready, begin, frames until it is focused
+    XrSessionState state = XR_SESSION_STATE_UNKNOWN;
+    int profileEvents = 0;
+    auto pollEvents = [&]() {
+        XrEventDataBuffer event = make<XrEventDataBuffer>(XR_TYPE_EVENT_DATA_BUFFER);
+        while (xrPollEvent(instance, &event) == XR_SUCCESS) {
+            if (event.type == XR_TYPE_EVENT_DATA_SESSION_STATE_CHANGED) {
+                state = reinterpret_cast<XrEventDataSessionStateChanged*>(&event)->state;
+            } else if (event.type == XR_TYPE_EVENT_DATA_INTERACTION_PROFILE_CHANGED) {
+                ++profileEvents;
+            }
+            event = make<XrEventDataBuffer>(XR_TYPE_EVENT_DATA_BUFFER);
+        }
+    };
+    for (int attempt = 0; attempt < 500 && state != XR_SESSION_STATE_READY; ++attempt) {
+        pollEvents();
+        Sleep(10);
+    }
+    if (state != XR_SESSION_STATE_READY) {
+        return finish("the session did not become ready");
+    }
+    XrSessionBeginInfo beginInfo = make<XrSessionBeginInfo>(XR_TYPE_SESSION_BEGIN_INFO);
+    beginInfo.primaryViewConfigurationType = XR_VIEW_CONFIGURATION_TYPE_PRIMARY_STEREO;
+    CHECK_XR(xrBeginSession(session, &beginInfo));
+
+    // One frame: sync, read every action and locate every pose at the frame's display time
+    XrResult frameResult = XR_SUCCESS;
+    auto frame = [&]() {
+        Reading reading;
+        XrFrameState frameState = make<XrFrameState>(XR_TYPE_FRAME_STATE);
+        frameResult = xrWaitFrame(session, nullptr, &frameState);
+        if (XR_FAILED(frameResult) || XR_FAILED(frameResult = xrBeginFrame(session, nullptr))) {
+            return reading;
+        }
+        const XrTime time = frameState.predictedDisplayTime;
+        pollEvents();
+        reading.focused = state == XR_SESSION_STATE_FOCUSED;
+        XrActiveActionSet active{actionSet, XR_NULL_PATH};
+        XrActionsSyncInfo sync = make<XrActionsSyncInfo>(XR_TYPE_ACTIONS_SYNC_INFO);
+        sync.countActiveActionSets = 1;
+        sync.activeActionSets = &active;
+        xrSyncActions(session, &sync);
+        XrSpaceLocation head = make<XrSpaceLocation>(XR_TYPE_SPACE_LOCATION);
+        xrLocateSpace(viewSpace, localSpace, time, &head);
+        reading.headValid = (head.locationFlags & XR_SPACE_LOCATION_POSITION_VALID_BIT) != 0;
+        reading.head = head.pose;
+        for (int hand = 0; hand < 2; ++hand) {
+            HandReading& out = reading.hands[hand];
+            XrInteractionProfileState profile = make<XrInteractionProfileState>(XR_TYPE_INTERACTION_PROFILE_STATE);
+            if (XR_SUCCEEDED(xrGetCurrentInteractionProfile(session, handPaths[hand], &profile))) {
+                out.profile = profile.interactionProfile;
+            }
+            for (int gesture = 0; gesture < kGestureCount; ++gesture) {
+                XrActionStateGetInfo get = make<XrActionStateGetInfo>(XR_TYPE_ACTION_STATE_GET_INFO);
+                get.subactionPath = handPaths[hand];
+                get.action = valueActions[gesture];
+                XrActionStateFloat value = make<XrActionStateFloat>(XR_TYPE_ACTION_STATE_FLOAT);
+                xrGetActionStateFloat(session, &get, &value);
+                out.valueActive[gesture] = value.isActive == XR_TRUE;
+                out.value[gesture] = value.currentState;
+                get.action = readyActions[gesture];
+                XrActionStateBoolean ready = make<XrActionStateBoolean>(XR_TYPE_ACTION_STATE_BOOLEAN);
+                xrGetActionStateBoolean(session, &get, &ready);
+                out.readyActive[gesture] = ready.isActive == XR_TRUE;
+                out.ready[gesture] = ready.currentState == XR_TRUE;
+            }
+            for (int pose = 0; pose < kPoseCount; ++pose) {
+                XrSpaceLocation location = make<XrSpaceLocation>(XR_TYPE_SPACE_LOCATION);
+                xrLocateSpace(poseSpaces[hand][pose], localSpace, time, &location);
+                out.poseValid[pose] = (location.locationFlags & (XR_SPACE_LOCATION_POSITION_VALID_BIT |
+                                                                  XR_SPACE_LOCATION_ORIENTATION_VALID_BIT)) ==
+                                      (XR_SPACE_LOCATION_POSITION_VALID_BIT | XR_SPACE_LOCATION_ORIENTATION_VALID_BIT);
+                out.pose[pose] = location.pose;
+            }
+        }
+        XrFrameEndInfo endInfo = make<XrFrameEndInfo>(XR_TYPE_FRAME_END_INFO);
+        endInfo.displayTime = time;
+        endInfo.environmentBlendMode = XR_ENVIRONMENT_BLEND_MODE_OPAQUE;
+        frameResult = xrEndFrame(session, &endInfo);
+        return reading;
+    };
+
+    // The left hand is the probe's controller through the whole run: what it showed
+    bool leftReadySeen = false;
+    bool leftGraspSeen = false;
+    bool leftPinchAheadOk = false;
+    float leftPinchAhead = -1.0f;
+    auto watchLeft = [&](const Reading& reading) {
+        const HandReading& left = reading.hands[0];
+        leftReadySeen = leftReadySeen || left.allReady();
+        leftGraspSeen = leftGraspSeen || left.value[kGrasp] > 0.98f;
+        if (left.poseValid[kPinch] && left.poseValid[kAim]) {
+            // A controller's pinch pose lies 3 cm ahead of its aim pose, with the aim's orientation
+            const XrVector3f ahead = subtract(left.pose[kPinch].position, left.pose[kAim].position);
+            leftPinchAhead = dot(ahead, axis(left.pose[kAim], 0, 0, -1));
+            leftPinchAheadOk = std::fabs(leftPinchAhead - 0.03f) < 1e-3f && std::fabs(length(ahead) - 0.03f) < 1e-3f;
+        }
+    };
+    // Frames until `done` holds or the step's time runs out
+    auto waitFor = [&](const char* what, const std::function<bool(const Reading&)>& done, double seconds = -1.0) {
+        const uint64_t start = unixMilliseconds();
+        const double limit = seconds > 0.0 ? seconds : stepSeconds;
+        Reading reading;
+        for (;;) {
+            reading = frame();
+            if (XR_FAILED(frameResult)) {
+                report(false, "a frame failed with %d while waiting for %s", static_cast<int>(frameResult), what);
+                return reading;
+            }
+            watchLeft(reading);
+            if (reading.focused && done(reading)) {
+                std::printf("hand_interaction_smoke: %s after %llu ms\n", what,
+                            static_cast<unsigned long long>(unixMilliseconds() - start));
+                std::fflush(stdout);
+                return reading;
+            }
+            if ((unixMilliseconds() - start) / 1000.0 > limit) {
+                report(false, "%s did not happen in %.0f s", what, limit);
+                return reading;
+            }
+        }
+    };
+    auto setWords = [&](const char* words) {
+        std::printf("hand_interaction_smoke: words \"%s\" at unix %llu ms\n", words,
+                    static_cast<unsigned long long>(unixMilliseconds()));
+        std::fflush(stdout);
+        if (!writeWords(wordsPath, words)) {
+            report(false, "the words file cannot be written");
+        }
+    };
+    // Where a point of the test hand lies: `offset` in the head's axes from the head (right, up, back)
+    auto fromHead = [](const Reading& reading, float x, float y, float z) {
+        return add(reading.head.position, rotate(reading.head.orientation, {x, y, z}));
+    };
+    auto inHead = [](const Reading& reading, float x, float y, float z) {
+        return rotate(reading.head.orientation, {x, y, z});
+    };
+    auto within = [](const XrVector3f& a, const XrVector3f& b, float meters) {
+        return length(subtract(a, b)) < meters;
+    };
+    auto describe = [](const XrVector3f& v) {
+        static char text[4][64];
+        static int next = 0;
+        char* out = text[next++ % 4];
+        std::snprintf(out, 64, "(%.3f %.3f %.3f)", v.x, v.y, v.z);
+        return out;
+    };
+
+    {
+        const Reading focused = waitFor("the session is focused", [](const Reading& r) { return r.focused; }, 15.0);
+        if (!focused.focused) {
+            return finish("the session did not become focused");
+        }
+    }
+
+    if (both) {
+        // Both controllers: the Touch profile on both sides
+        Reading reading = waitFor("both hands use the Touch controller's profile", [&](const Reading& r) {
+            return r.hands[0].profile == touchProfile && r.hands[1].profile == touchProfile;
+        });
+        report(reading.hands[1].profile == touchProfile && reading.hands[0].profile == touchProfile,
+               "with both controllers held, both hands use the Touch controller's profile");
+        const int eventsBefore = profileEvents;
+        setWords("hand=1 x=0.2 y=-0.35 z=0.3");
+        reading = waitFor("the right hand takes the hand interaction profile", [&](const Reading& r) {
+            return r.hands[1].profile == handProfile && profileEvents > eventsBefore && r.hands[1].allReady();
+        });
+        report(reading.hands[1].profile == handProfile && profileEvents > eventsBefore,
+               "the tracked right hand uses the hand interaction profile (%d profile events)", profileEvents - eventsBefore);
+        report(reading.hands[0].profile == touchProfile, "the left hand keeps the Touch controller's profile");
+        setWords("hand=1 x=0.2 y=-0.35 z=0.3 pinch=1");
+        reading = waitFor("the right hand pinches", [&](const Reading& r) { return r.hands[1].value[kPinchGesture] > 0.98f; });
+        report(reading.hands[1].value[kPinchGesture] > 0.98f, "the action bound to both profiles reads the hand's pinch: %.3f",
+               reading.hands[1].value[kPinchGesture]);
+        const int eventsAtHand = profileEvents;
+        setWords("hand=0");
+        reading = waitFor("the right hand takes the Touch controller's profile again", [&](const Reading& r) {
+            return r.hands[1].profile == touchProfile && profileEvents > eventsAtHand;
+        });
+        report(reading.hands[1].profile == touchProfile && profileEvents > eventsAtHand,
+               "the right controller takes the Touch controller's profile again (%d profile events)",
+               profileEvents - eventsAtHand);
+        report(reading.hands[1].allPoses(), "the right controller's four poses are valid in the Touch controller's profile");
+        report(leftPinchAheadOk, "the left controller's pinch pose lies 3 cm ahead of its aim pose (%.4f m)", leftPinchAhead);
+    } else {
+        // The test hand, open, palm down, fingers forward
+        setWords("hand=1 x=0.2 y=-0.35 z=0.3");
+        Reading open = waitFor("the right hand is tracked and ready", [&](const Reading& r) {
+            return r.hands[1].allReady() && r.hands[1].allPoses() && r.headValid;
+        });
+        const HandReading& right = open.hands[1];
+        report(right.profile == handProfile, "the tracked right hand uses the hand interaction profile");
+        report(open.hands[0].profile == handProfile, "the left controller serves the hand interaction profile");
+        report(right.allReady(), "pinch_ext, aim_activate_ext and grasp_ext are ready while the hand is tracked");
+        report(right.value[kPinchGesture] < 0.02f && right.value[kAimActivate] < 0.02f && right.value[kGrasp] < 0.02f,
+               "an open hand reads pinch %.3f, aim_activate %.3f, grasp %.3f", right.value[kPinchGesture],
+               right.value[kAimActivate], right.value[kGrasp]);
+        // The palm joint lies where the words put it. The extension: the grip's -Z goes from the
+        // little finger to the index finger, which is to the left for a right palm facing down, and
+        // its +X enters the right palm, which is up.
+        const XrVector3f palm = fromHead(open, 0.2f, -0.35f, -0.3f);
+        report(within(right.pose[kGrip].position, palm, 0.003f), "the grip pose lies at the palm: %s, expected %s",
+               describe(right.pose[kGrip].position), describe(palm));
+        report(dot(axis(right.pose[kGrip], 0, 0, -1), inHead(open, -1, 0, 0)) > 0.99f &&
+                   dot(axis(right.pose[kGrip], 1, 0, 0), inHead(open, 0, 1, 0)) > 0.99f,
+               "the grip pose's -Z points from the little finger to the index finger %s and its +X into the palm %s",
+               describe(axis(right.pose[kGrip], 0, 0, -1)), describe(axis(right.pose[kGrip], 1, 0, 0)));
+        // The index fingertip is 2 cm to the left of the palm joint and 11.5 cm ahead (test_input.rs);
+        // the poke pose lies on its skin, 6 mm further, +Y up for a palm facing down, +Z to the knuckle
+        const XrVector3f poke = fromHead(open, 0.18f, -0.35f, -0.3f - 0.115f - 0.006f);
+        report(within(right.pose[kPoke].position, poke, 0.003f) &&
+                   dot(axis(right.pose[kPoke], 0, 1, 0), inHead(open, 0, 1, 0)) > 0.99f &&
+                   dot(axis(right.pose[kPoke], 0, 0, 1), inHead(open, 0, 0, 1)) > 0.99f,
+               "the poke pose lies on the index fingertip at %s (expected %s), +Y up, +Z to the knuckle",
+               describe(right.pose[kPoke].position), describe(poke));
+        // The pinch pose lies between the tips (6 cm apart when open): +Z back toward the proximal
+        // joints, +Y toward the thumb, which points up when the palms face each other
+        const XrVector3f pinchPlace = fromHead(open, 0.18f, -0.35f - 0.03f, -0.3f - 0.115f);
+        report(within(right.pose[kPinch].position, pinchPlace, 0.003f) &&
+                   dot(axis(right.pose[kPinch], 0, 0, 1), inHead(open, 0, 0, 1)) > 0.95f,
+               "the pinch pose lies between the tips at %s (expected %s), +Z back %s",
+               describe(right.pose[kPinch].position), describe(pinchPlace), describe(axis(right.pose[kPinch], 0, 0, 1)));
+        // The aim pose starts at the pinch and points ahead, away from the shoulder
+        report(within(right.pose[kAim].position, right.pose[kPinch].position, 0.003f) &&
+                   dot(axis(right.pose[kAim], 0, 0, -1), inHead(open, 0, 0, -1)) > 0.5f &&
+                   dot(axis(right.pose[kAim], 0, 1, 0), inHead(open, 0, 1, 0)) > 0.5f,
+               "the aim pose starts at the pinch and points ahead %s with +Y up", describe(axis(right.pose[kAim], 0, 0, -1)));
+
+        // The pinch from 0 to 1 and back, in the value and in the aim activation
+        std::string pinches;
+        auto pinchTo = [&](const char* words, float target) {
+            setWords(words);
+            char what[96];
+            std::snprintf(what, sizeof(what), "the pinch reads %.1f", target);
+            const Reading r = waitFor(what, [&](const Reading& x) {
+                return std::fabs(x.hands[1].value[kPinchGesture] - target) < 0.02f &&
+                       std::fabs(x.hands[1].value[kAimActivate] - target) < 0.02f;
+            });
+            char value[24];
+            std::snprintf(value, sizeof(value), "%s%.3f", pinches.empty() ? "" : " -> ", r.hands[1].value[kPinchGesture]);
+            pinches += value;
+            report(std::fabs(r.hands[1].value[kPinchGesture] - target) < 0.02f && r.hands[1].allReady(),
+                   "pinch %.1f reads pinch_ext/value %.3f and aim_activate_ext/value %.3f, ready %d", target,
+                   r.hands[1].value[kPinchGesture], r.hands[1].value[kAimActivate], r.hands[1].allReady());
+            return r;
+        };
+        pinchTo("hand=1 x=0.2 y=-0.35 z=0.3 pinch=0.5", 0.5f);
+        const Reading pinched = pinchTo("hand=1 x=0.2 y=-0.35 z=0.3 pinch=1", 1.0f);
+        report(within(pinched.hands[1].pose[kPinch].position, fromHead(pinched, 0.18f, -0.35f - 0.009f, -0.415f), 0.003f),
+               "a closed pinch moves the pinch pose to the touching tips: %s", describe(pinched.hands[1].pose[kPinch].position));
+        pinchTo("hand=1 x=0.2 y=-0.35 z=0.3 pinch=0", 0.0f);
+        report(true, "pinch_ext/value went %s", pinches.c_str());
+
+        // The fist
+        setWords("hand=1 x=0.2 y=-0.35 z=0.3 grip=1");
+        Reading fist = waitFor("the grasp reads 1", [](const Reading& r) { return r.hands[1].value[kGrasp] > 0.98f; });
+        report(fist.hands[1].value[kGrasp] > 0.98f, "a fist reads grasp_ext/value %.3f", fist.hands[1].value[kGrasp]);
+        setWords("hand=1 x=0.2 y=-0.35 z=0.3 grip=0");
+        fist = waitFor("the grasp reads 0", [](const Reading& r) { return r.hands[1].value[kGrasp] < 0.02f; });
+        report(fist.hands[1].value[kGrasp] < 0.02f, "an open hand reads grasp_ext/value %.3f again", fist.hands[1].value[kGrasp]);
+
+        // The hand moves 10 cm to the right: every pose follows
+        setWords("hand=1 x=0.3 y=-0.35 z=0.3");
+        const Reading moved = waitFor("the hand moved", [&](const Reading& r) {
+            return within(r.hands[1].pose[kGrip].position, fromHead(r, 0.3f, -0.35f, -0.3f), 0.003f);
+        });
+        for (int pose = 0; pose < kPoseCount; ++pose) {
+            const XrVector3f shift = subtract(moved.hands[1].pose[pose].position, right.pose[pose].position);
+            // The aim pose turns about the shoulder as the hand moves; its start moves with the fingers
+            report(within(shift, inHead(moved, 0.1f, 0.0f, 0.0f), 0.003f), "the %s pose moved with the hand by %s",
+                   kPoseNames[pose], describe(shift));
+        }
+
+        // The extension's own example: palms facing each other, fingers forward. The right palm
+        // faces left, the thumb is up: the grip's +X points to the right, its -Z from the little
+        // finger up to the index finger, and the pinch's +Y points up.
+        setWords("hand=1 x=0.3 y=-0.35 z=0.3 roll=90");
+        const Reading rolled = waitFor("the hand rolled", [&](const Reading& r) {
+            return dot(axis(r.hands[1].pose[kGrip], 1, 0, 0), inHead(r, 1, 0, 0)) > 0.99f;
+        });
+        const HandReading& turned = rolled.hands[1];
+        report(dot(axis(turned.pose[kGrip], 1, 0, 0), inHead(rolled, 1, 0, 0)) > 0.99f &&
+                   dot(axis(turned.pose[kGrip], 0, 0, -1), inHead(rolled, 0, 1, 0)) > 0.99f,
+               "with the palm facing left the grip's +X points right %s and its -Z up %s",
+               describe(axis(turned.pose[kGrip], 1, 0, 0)), describe(axis(turned.pose[kGrip], 0, 0, -1)));
+        report(dot(axis(turned.pose[kPinch], 0, 1, 0), inHead(rolled, 0, 1, 0)) > 0.95f,
+               "with the palms facing each other the pinch's +Y points up %s", describe(axis(turned.pose[kPinch], 0, 1, 0)));
+
+        // The cameras lose the hand: not ready, value 0, and no change of profile
+        const int eventsBefore = profileEvents;
+        setWords("hand=1 x=0.3 y=-0.35 z=0.3 lost=1");
+        const Reading lost = waitFor("the lost hand is not ready", [](const Reading& r) {
+            return !r.hands[1].ready[kPinchGesture] && !r.hands[1].ready[kAimActivate] && !r.hands[1].ready[kGrasp];
+        });
+        report(!lost.hands[1].ready[kPinchGesture] && lost.hands[1].value[kPinchGesture] == 0.0f &&
+                   !lost.hands[1].poseValid[kGrip],
+               "a lost hand reads ready false, pinch %.1f and no grip pose", lost.hands[1].value[kPinchGesture]);
+        report(lost.hands[1].profile == handProfile && profileEvents == eventsBefore,
+               "a lost hand keeps the hand interaction profile with no profile event (%d events)", profileEvents - eventsBefore);
+        setWords("hand=1 x=0.3 y=-0.35 z=0.3");
+        const Reading back = waitFor("the hand is back", [](const Reading& r) { return r.hands[1].allReady(); });
+        report(back.hands[1].allReady() && back.hands[1].allPoses(), "the hand is ready again when the cameras see it");
+
+        report(leftReadySeen, "the left controller's gestures are ready");
+        report(leftGraspSeen, "the left controller's squeeze reads as grasp_ext/value 1");
+        report(leftPinchAheadOk, "the left controller's pinch pose lies 3 cm ahead of its aim pose (%.4f m)", leftPinchAhead);
+    }
+
+    // The controller comes back for the next test
+    writeWords(wordsPath, "");
+    for (XrSpace* row : poseSpaces) {
+        for (int pose = 0; pose < kPoseCount; ++pose) {
+            xrDestroySpace(row[pose]);
+        }
+    }
+    xrDestroySession(session);
+    xrDestroyInstance(instance);
+    context->Release();
+    device->Release();
+    adapter->Release();
+    factory->Release();
+    std::printf("hand_interaction_smoke: %s\n", gProblems == 0 ? "PASS" : "FAIL");
+    return gProblems == 0 ? 0 : 1;
+}
