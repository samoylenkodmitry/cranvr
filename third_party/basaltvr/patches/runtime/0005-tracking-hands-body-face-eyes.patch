@@ -157,7 +218,20 @@ void resetSystemButtonLocked() {
     gSystemButtonRecentered = false;
 }
 
+bool trackedFresh(bool active, XrTime arrival, XrTime now) {
+    return active && arrival > 0 && now >= arrival && now - arrival <= kTrackedPoseFreshness;
+}
+
+void resetTrackedLocked() {
+    gHands[0] = {};
+    gHands[1] = {};
+    gBody = {};
+    gFace = {};
+    gEyeGaze = {};
+}
