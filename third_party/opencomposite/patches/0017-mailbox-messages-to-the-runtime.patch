+
 typedef BaseMailbox::MboxErr MboxErr;
 
 MboxErr BaseMailbox::RegisterMailbox(const char* name, OOVR_mbox_handle* handle)
@@ -22,9 +25,21 @@ MboxErr BaseMailbox::UnregisterMailbox(OOVR_mbox_handle mbox)
 	return VR_MBox_None;
 }
 
-MboxErr BaseMailbox::SendMessage(OOVR_mbox_handle mbox, const char* type, const char* message)
+// cranvr: the second argument is the address of the mailbox that the message goes to, such as "hlvr/interstitials". The
+// runtime passes the message to cranvr-host, which shows a game's loading screen and its messages in the headset.
+MboxErr BaseMailbox::SendMessage(OOVR_mbox_handle mbox, const char* address, const char* message)
 {
-	OOVR_LOGF("Pretending to send mailbox message, type '%s' contents '%s'", type, message);
+	if (address == nullptr || message == nullptr)
+		return VR_MBox_None;
+	if (xr_ext == nullptr || !xr_ext->xrSendMailboxMessageCRANVR_Available()) {
+		OOVR_LOGF("The runtime takes no mailbox messages: ignoring a message to '%s', contents '%s'", address, message);
+		return VR_MBox_None;
+	}
+	const XrResult result = xr_ext->xrSendMailboxMessageCRANVR(xr_instance, address, message);
+	if (XR_FAILED(result))
+		OOVR_LOGF("The runtime refused a mailbox message to '%s' with %d, contents '%s'", address, (int)result, message);
+	else
+		OOVR_LOGF("Handed a mailbox message to '%s' to the runtime, contents '%s'", address, message);
 	return VR_MBox_None;
 }
 
