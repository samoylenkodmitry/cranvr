diff --git a/dlls/ntdll/unix/virtual.c b/dlls/ntdll/unix/virtual.c
index a2ea524..4437c2f 100644
--- a/dlls/ntdll/unix/virtual.c
+++ b/dlls/ntdll/unix/virtual.c
@@ -199,6 +199,13 @@ static void *working_set_limit   = (void *)0x7fff0000;
 
 static void *host_addr_space_limit;  /* top of the host virtual address space */
 
+#if defined(__APPLE__) && defined(_WIN64)
+/* where memory at no fixed address starts for a process with high-entropy addresses (see map_view) */
+static void *high_entropy_start;
+/* set by virtual_alloc_thread_stack while it holds virtual_mutex: a thread stack keeps the low area (see map_view) */
+static BOOL thread_stack_view;
+#endif
+
 static struct file_view *arm64ec_view;
 
 ULONG_PTR user_space_wow_limit = 0;
@@ -2298,17 +2305,36 @@ static NTSTATUS map_view( struct file_view **view_ret, void *base, size_t size,
         void *end = min( user_space_limit, host_addr_space_limit );
         size_t host_size = ROUND_SIZE( 0, size, host_page_mask );
         size_t unmap_size, view_size = host_size + align_mask + 1;
+        BOOL low_area = TRUE;
 
         if (limit_low && (void *)limit_low > start) start = (void *)limit_low;
         if (limit_high && (void *)limit_high < end) end = (char *)limit_high + 1;
 
+#if defined(__APPLE__) && defined(_WIN64)
+        /* macOS keeps the reserved area at the bottom of the address space, so a process would get its memory
+         * there first. Windows gives a process with high-entropy addresses memory above 4 GB. Code that looks
+         * for free pages near its own memory relies on that. MonoMod's detours walk down from the code. A walk
+         * that reaches page 0 makes VirtualAlloc place the jump's cell anywhere. Such a process gets the reserved
+         * area above 4 GB first, then the host's free space. It never gets the low area.
+         * Thread stacks stay in the low area. The Unix-side stack of each thread lies above 4 GB. The context of
+         * a thread that is suspended on its way out of a system call reports a stack pointer in it. A sampling
+         * profiler copies the stack from that pointer up to the stack's top. With the thread stack right above
+         * the Unix-side stack, the copy reads the no-access page at the bottom of the thread stack and faults.
+         * With the thread stack below, the pointer lies above the stack's top. The profiler then drops the sample. */
+        if (high_entropy_start && !thread_stack_view && !top_down && !limit_low && !limit_high)
+        {
+            start = high_entropy_start;
+            low_area = FALSE;
+        }
+#endif
+
         if ((ptr = map_reserved_area( start, end, host_size, top_down, unix_prot, align_mask )))
         {
             TRACE( "got mem in reserved area %p-%p\n", ptr, (char *)ptr + size );
             goto done;
         }
 
-        if (start > address_space_start || end < host_addr_space_limit || top_down)
+        if (low_area && (start > address_space_start || end < host_addr_space_limit || top_down))
         {
             if (!(ptr = map_free_area( start, end, host_size, top_down, unix_prot, align_mask )))
                 return STATUS_NO_MEMORY;
@@ -4413,8 +4439,14 @@ NTSTATUS virtual_alloc_thread_stack( INITIAL_TEB *stack, ULONG_PTR limit_low, UL
 
     server_enter_uninterrupted_section( &virtual_mutex, &sigset );
 
+#if defined(__APPLE__) && defined(_WIN64)
+    thread_stack_view = TRUE;
+#endif
     status = map_view( &view, NULL, size, 0, VPROT_READ | VPROT_WRITE | VPROT_COMMITTED,
                        limit_low, limit_high, 0 );
+#if defined(__APPLE__) && defined(_WIN64)
+    thread_stack_view = FALSE;
+#endif
     if (status != STATUS_SUCCESS) goto done;
 
 #ifdef VALGRIND_STACK_REGISTER
@@ -5090,6 +5122,11 @@ void virtual_set_large_address_space(void)
             if ((main_image_info.DllCharacteristics & IMAGE_DLLCHARACTERISTICS_HIGH_ENTROPY_VA) &&
                 (main_image_info.DllCharacteristics & IMAGE_DLLCHARACTERISTICS_DYNAMIC_BASE))
                 free_reserved_memory( 0, (char *)0x7ffe0000 );
+#else
+            /* the zerofill section stays: memory at no fixed address starts above 4 GB instead */
+            if ((main_image_info.DllCharacteristics & IMAGE_DLLCHARACTERISTICS_HIGH_ENTROPY_VA) &&
+                (main_image_info.DllCharacteristics & IMAGE_DLLCHARACTERISTICS_DYNAMIC_BASE))
+                high_entropy_start = (void *)0x100000000;
 #endif
         }
         else user_space_wow_limit = ((main_image_info.ImageCharacteristics & IMAGE_FILE_LARGE_ADDRESS_AWARE) ? limit_4g : limit_2g) - 1;
