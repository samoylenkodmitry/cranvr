+bool isMailboxEnabled(XrInstance instance) {
+    if (instance == XR_NULL_HANDLE) {
+        return false;
+    }
+    AcquireSRWLockShared(&gInstanceLock);
+    const bool enabled = instance == gLiveInstance && gMailboxEnabled;
+    ReleaseSRWLockShared(&gInstanceLock);
+    return enabled;
+}
+
+XrResult XRAPI_CALL sendMailboxMessage(XrInstance instance, const char* address, const char* message) {
+    if (!isMailboxEnabled(instance)) {
+        return XR_ERROR_HANDLE_INVALID;
+    }
+    if (address == nullptr || message == nullptr) {
+        return XR_ERROR_VALIDATION_FAILURE;
+    }
+    controlSendMailboxMessage(address, message);
+    return XR_SUCCESS;
+}
