+// cranvr: the game's log (stderr, which the cranvr app keeps as the game's log) tells what reached the
+// game: the first time that each action of each hand is active and its first two changes. A game
+// that binds no action, or binds one that no controller input reaches, shows nothing here. The
+// lines of the first kind stop after 80, and so do the lines of the second kind.
+uint32_t gActiveLogLines = 0;
+uint32_t gChangeLogLines = 0;
+constexpr uint32_t kMaxActionLogLines = 80;
+
+void logActionState(const ActionRecord& action, const SyncedActionState& state, const char* what, uint32_t& lines) {
+    if (lines >= kMaxActionLogLines) {
+        return;
+    }
+    ++lines;
+    const char* hand = state.selectedHandMask == 1u   ? "left hand"
+                       : state.selectedHandMask == 2u ? "right hand"
+                       : state.selectedHandMask == 4u ? "eyes"
+                                                      : "both hands";
+    char value[64] = "";
+    switch (action.actionType) {
+    case XR_ACTION_TYPE_BOOLEAN_INPUT:
+        std::snprintf(value, sizeof(value), "%s", state.booleanValue ? "pressed" : "released");
+        break;
+    case XR_ACTION_TYPE_FLOAT_INPUT:
+        std::snprintf(value, sizeof(value), "%.2f", state.floatValue);
+        break;
+    case XR_ACTION_TYPE_VECTOR2F_INPUT:
+        std::snprintf(value, sizeof(value), "(%.2f, %.2f)", state.vectorValue.x, state.vectorValue.y);
+        break;
+    case XR_ACTION_TYPE_POSE_INPUT:
+        std::snprintf(value, sizeof(value), "pose of the %s is tracked", hand);
+        break;
+    default:
+        break;
+    }
+    std::fprintf(stderr, "Basalt OpenXR: action %s (%s) %s %s\n", action.name, hand, what, value);
+}
+
