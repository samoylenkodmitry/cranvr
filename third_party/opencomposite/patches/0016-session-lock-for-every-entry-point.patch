 #include <openxr/openxr.h>
 #include <shared_mutex>
@@ -103,9 +104,24 @@ private:
 
 class SessionLock;
 // A wrapper around the XrSession to prevent session destruction while it's being accessed
+//
+// cranvr: every OpenVR entry point holds the shared lock (the generated stubs take it), so a game's other threads
+// never see the session or xr_gbl while a restart destroys and remakes them. A restart takes the exclusive lock.
+// The restart at a game's first submit runs inside IVRCompositor::Submit, which holds the shared lock: the thread
+// gives up its share while it waits for the exclusive lock, and it turns the exclusive lock back into its share in
+// one step, so no other restart runs before Submit returns. Both locks are reentrant for one thread. A thread that
+// waits for the exclusive lock keeps new readers out, so a game that calls OpenVR all the time cannot starve it.
 class SessionWrapper {
 
-	std::shared_mutex mutex;
+	std::mutex mutex;
+	std::condition_variable changed;
+	// The fields below change under mutex only.
+	// The number of threads that hold the shared lock
+	int readers = 0;
+	// A thread holds the exclusive lock
+	bool writer = false;
+	// The number of threads that wait for the exclusive lock
+	int waitingWriters = 0;
 	XrSession session = XR_NULL_HANDLE;
 	friend SessionLock;
 
@@ -118,7 +134,7 @@ public:
 	/*
 	 * Provides a RAII-style lock on accesses to the XrSession. Prevents any other thread from obtaining get() or lock_shared().
 	 */
-	SessionLock lock();
+	[[nodiscard]] SessionLock lock();
 
 	/*
 	 * Provides a RAII-style lock on modification to the XrSession. Prevents any other thread from obtaining lock().
@@ -135,15 +151,18 @@ public:
 // It gets a shared_lock or lock on the session mutex and the mutex gets unlocked (on destruction)
 // after whatever function call needs the session completes.
 class SessionLock {
-	std::shared_lock<std::shared_mutex> shared_lock;
-	std::unique_lock<std::shared_mutex> lock;
 	SessionWrapper& parent;
-	bool owner = false;
-	inline static thread_local bool thread_owns_lock = false;
+	bool exclusive;
+	// The number of live locks of each kind on this thread. The thread holds the exclusive lock while
+	// exclusiveDepth > 0, else the shared lock while sharedDepth > 0.
+	inline static thread_local int sharedDepth = 0;
+	inline static thread_local int exclusiveDepth = 0;
 
 public:
 	SessionLock(SessionWrapper& p, bool exclusive);
 	~SessionLock();
+	SessionLock(const SessionLock&) = delete;
+	SessionLock& operator=(const SessionLock&) = delete;
 	operator XrSession&();
 };
 
