 }
 
+// cranvr: a reader over a received payload, the counterpart of MessageWriter.
+class PayloadReader {
+public:
+    PayloadReader(const uint8_t* data, size_t length) : data_(data), length_(length) {}
+
+    bool bytes(void* out, size_t size) {
+        if (failed_ || size > length_ - offset_) {
+            failed_ = true;
+            return false;
+        }
+        std::memcpy(out, data_ + offset_, size);
+        offset_ += size;
+        return true;
+    }
+    uint32_t u32() { uint32_t v = 0; bytes(&v, sizeof(v)); return v; }
+    uint64_t u64() { uint64_t v = 0; bytes(&v, sizeof(v)); return v; }
+    uint8_t u8() { uint8_t v = 0; bytes(&v, sizeof(v)); return v; }
+    float f32() { float v = 0.0f; bytes(&v, sizeof(v)); return v; }
+
+    // A pose of 7 floats: the orientation (normalized here, within 0.5 and 1.5
+    // of unit length) and the position. False when a value is not a number.
+    bool pose(XrPosef* out) {
+        float v[7]{};
+        for (float& value : v) {
+            value = f32();
+        }
+        if (failed_) {
+            return false;
+        }
+        for (float value : v) {
+            if (!std::isfinite(value)) {
+                failed_ = true;
+                return false;
+            }
+        }
+        const double norm = quaternionNorm(v);
+        if (norm < 0.5 || norm > 1.5) {
+            failed_ = true;
+            return false;
+        }
+        out->orientation = normalizedQuaternion(v, norm);
+        out->position = {v[4], v[5], v[6]};
+        return true;
+    }
+
+    bool vector(XrVector3f* out) {
+        float v[3]{f32(), f32(), f32()};
+        if (failed_ || !std::isfinite(v[0]) || !std::isfinite(v[1]) || !std::isfinite(v[2])) {
+            failed_ = true;
+            return false;
+        }
+        *out = {v[0], v[1], v[2]};
+        return true;
+    }
+
+    bool ok() const { return !failed_; }
+    size_t remaining() const { return length_ - offset_; }
+
+private:
+    const uint8_t* data_;
+    size_t length_;
+    size_t offset_ = 0;
+    bool failed_ = false;
+};
+
+bool readRoot(PayloadReader& reader, TrackedRootRecord* root) {
+    return reader.pose(&root->pose) && reader.vector(&root->linearVelocity) &&
+           reader.vector(&root->angularVelocity);
+}
+
+// Joints: a pose each, then one flag byte each.
+bool readJoints(PayloadReader& reader, TrackedJointRecord* joints, uint32_t count) {
+    for (uint32_t index = 0; index < count; ++index) {
+        if (!reader.pose(&joints[index].pose)) {
+            return false;
+        }
+    }
+    for (uint32_t index = 0; index < count; ++index) {
+        joints[index].flags = static_cast<uint8_t>(reader.u8() & 0x0f);
+    }
+    return reader.ok();
+}
+
+bool parseHandTracking(const uint8_t* payload, size_t payloadLength) {
+    if (payloadLength < kHandInactivePayloadLength) {
+        return false;
+    }
+    PayloadReader reader(payload, payloadLength);
+    const uint64_t timestamp = reader.u64();
+    const uint32_t hand = reader.u32();
+    const uint32_t flags = reader.u32();
+    const bool tracked = (flags & 1u) != 0;
+    if (hand > 1 || (flags & ~1u) != 0 ||
+        payloadLength != (tracked ? kHandActivePayloadLength : kHandInactivePayloadLength)) {
+        return false;
+    }
+    HandRecord next{};
+    if (tracked && (!readRoot(reader, &next.root) ||
+                    !readJoints(reader, next.joints, basalt::kTrackedHandJoints))) {
+        return false;
+    }
+    HandRecord& record = gHands[hand];
+    if (timestamp < record.questTimestamp || !gLocalOriginValid) {
+        return true;
+    }
+    record = next;
+    record.active = tracked;
+    record.questTimestamp = timestamp;
+    record.arrival = monotonicTime();
+    return true;
+}
+
+bool parseBodyTracking(const uint8_t* payload, size_t payloadLength) {
+    if (payloadLength < kBodyHeaderLength) {
+        return false;
+    }
+    PayloadReader reader(payload, payloadLength);
+    const uint64_t timestamp = reader.u64();
+    const uint32_t jointCount = reader.u32();
+    const uint32_t flags = reader.u32();
+    const float confidence = reader.f32();
+    if ((jointCount != basalt::kTrackedBodyJoints && jointCount != basalt::kTrackedFullBodyJoints) ||
+        (flags & ~1u) != 0 || !std::isfinite(confidence) ||
+        payloadLength != kBodyHeaderLength + jointCount * (7 * sizeof(float) + 1)) {
+        return false;
+    }
+    BodyRecord next{};
+    if (!readRoot(reader, &next.root) || !readJoints(reader, next.joints, jointCount)) {
+        return false;
+    }
+    if (timestamp < gBody.questTimestamp || !gLocalOriginValid) {
+        return true;
+    }
+    gBody = next;
+    gBody.active = (flags & 1u) != 0;
+    gBody.confidence = confidence < 0.0f ? 0.0f : (confidence > 1.0f ? 1.0f : confidence);
+    gBody.jointCount = jointCount;
+    gBody.questTimestamp = timestamp;
+    gBody.arrival = monotonicTime();
+    return true;
+}
+
+bool parseFaceTracking(const uint8_t* payload, size_t payloadLength) {
+    if (payloadLength != kFacePayloadLength) {
+        return false;
+    }
+    PayloadReader reader(payload, payloadLength);
+    const uint64_t timestamp = reader.u64();
+    const uint32_t flags = reader.u32();
+    FaceRecord next{};
+    for (float& value : next.confidences) {
+        value = reader.f32();
+    }
+    for (float& value : next.weights) {
+        value = reader.f32();
+    }
+    if (!reader.ok() || (flags & ~7u) != 0) {
+        return false;
+    }
+    for (float value : next.confidences) {
+        if (!std::isfinite(value)) {
+            return false;
+        }
+    }
+    for (float& value : next.weights) {
+        if (!std::isfinite(value)) {
+            return false;
+        }
+        value = value < 0.0f ? 0.0f : (value > 1.0f ? 1.0f : value);
+    }
+    if (timestamp < gFace.questTimestamp) {
+        return true;
+    }
+    gFace = next;
+    gFace.active = (flags & 1u) != 0;
+    gFace.flags = flags;
+    gFace.questTimestamp = timestamp;
+    gFace.arrival = monotonicTime();
+    return true;
+}
+
+bool parseEyeGaze(const uint8_t* payload, size_t payloadLength) {
+    if (payloadLength != kEyeGazePayloadLength) {
+        return false;
+    }
+    PayloadReader reader(payload, payloadLength);
+    const uint64_t timestamp = reader.u64();
+    const uint32_t flags = reader.u32();
+    XrPosef pose{};
+    if ((flags & ~1u) != 0 || !reader.pose(&pose)) {
+        return false;
+    }
+    if (timestamp < gEyeGaze.questTimestamp || !gLocalOriginValid) {
+        return true;
+    }
+    gEyeGaze.pose = pose;
+    gEyeGaze.active = (flags & 1u) != 0;
+    gEyeGaze.questTimestamp = timestamp;
+    gEyeGaze.arrival = monotonicTime();
+    return true;
+}
