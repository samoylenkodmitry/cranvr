+// The frame handoff of a Direct3D 11 session: a D3D11 fence on the immediate context. A two-slice
+// swapchain's slice goes into its IOSurface texture with CopySubresourceRegion.
+struct D3D11FrameSync {
+    basalt::FrameSync base;
+    ID3D11DeviceContext4* context;
+    ID3D11Fence* fence;
+    HANDLE event;
+};
+
+bool d3d11PrepareView(basalt::FrameSync* sync, basalt::ControlFrameView* view) {
+    return basalt::prepareSwapchainViewForExport(reinterpret_cast<D3D11FrameSync*>(sync)->context, view);
+}
+
+bool d3d11Signal(basalt::FrameSync* sync, uint64_t frameNumber) {
+    auto* d3d = reinterpret_cast<D3D11FrameSync*>(sync);
+    const HRESULT result = d3d->context->Signal(d3d->fence, frameNumber);
+    d3d->context->Flush();
+    return SUCCEEDED(result);
+}
+
+bool d3d11Wait(basalt::FrameSync* sync, uint64_t frameNumber, DWORD milliseconds) {
+    auto* d3d = reinterpret_cast<D3D11FrameSync*>(sync);
+    return SUCCEEDED(d3d->fence->SetEventOnCompletion(frameNumber, d3d->event)) &&
+           WaitForSingleObject(d3d->event, milliseconds) == WAIT_OBJECT_0;
+}
+
+void d3d11Destroy(basalt::FrameSync* sync) {
+    auto* d3d = reinterpret_cast<D3D11FrameSync*>(sync);
+    CloseHandle(d3d->event);
+    release(d3d->fence);
+    release(d3d->context);
+    std::free(d3d);
+}
+
+basalt::FrameSync* makeD3D11FrameSync(ID3D11DeviceContext4* context, ID3D11Fence* fence, HANDLE event) {
+    auto* d3d = static_cast<D3D11FrameSync*>(std::calloc(1, sizeof(D3D11FrameSync)));
+    if (d3d == nullptr) {
+        CloseHandle(event);
+        release(fence);
+        release(context);
+        return nullptr;
+    }
+    d3d->base = {d3d11PrepareView, d3d11Signal, d3d11Wait, d3d11Destroy};
+    d3d->context = context;
+    d3d->fence = fence;
+    d3d->event = event;
+    return &d3d->base;
+}
+
