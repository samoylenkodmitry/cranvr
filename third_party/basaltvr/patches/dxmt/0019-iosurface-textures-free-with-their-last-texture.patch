Subject: [PATCH] winemetal, d3d11: an IOSurface texture frees its surface with its last texture (cranvr)

MTLDevice_newTextureFromIOSurface made a Mach send right of each new IOSurface and returned it in
WMTTextureInfo::mach_port. Nothing freed that right, so the surface stayed until the process ended. DXMT
also registered the right with launchd under the texture's shared name, for OpenSharedResource in another
process. launchd keeps a registered right until the user logs out, and refuses to remove the name, so every
swapchain image of every game stayed after the game had ended: on 2026-11-27, launchd held 206 such
surfaces (529 MB) of dead Wine processes on the owner's Mac.

The call now makes no Mach port. The texture holds the only reference of the process to the surface, and the
surface goes a few milliseconds after the last texture on it is released, in whichever process. A shared
IOSurface texture registers nothing with launchd: its runtime data carries the surface's global ID, and
OpenSharedResource and OpenSharedResource1 open the surface by that ID (info->reserved in). The unique name
stays in the runtime data, because the keyed mutex of patch 0014 names its section by it. A texture with
the stock shared path (MTLSharedTextureHandle) keeps its registration.

As on Windows with a legacy shared handle, an IOSurface texture whose last texture is gone no longer opens:
on Windows an NT handle keeps the resource alive, and here the open fails. DXMT had kept such a surface
alive until the user logged out.
---
diff --git a/src/d3d11/d3d11_texture_device.cpp b/src/d3d11/d3d11_texture_device.cpp
index a9304ae..d333516 100644
--- a/src/d3d11/d3d11_texture_device.cpp
+++ b/src/d3d11/d3d11_texture_device.cpp
@@ -359,9 +359,12 @@ public:
 };
 
 struct SharedResourceData {
+  // cranvr: an IOSurface texture keeps a unique name here (the keyed mutex names its section by it), but launchd has no
+  // port under it: another process opens the surface by iosurface_id
   char mach_port_name[54];
   D3D11_RESOURCE_DIMENSION dimension;
   uint32_t is_iosurface;
+  uint32_t iosurface_id;
   union {
     D3D11_TEXTURE1D_DESC desc1d;
     D3D11_TEXTURE2D_DESC1 desc2d;
@@ -426,15 +429,18 @@ HRESULT CreateDeviceTextureInternal(MTLD3D11Device *pDevice,
     auto allocation = texture->allocate(flags);
 
     mach_port_t mach_port = allocation->machPort;
-    if (!mach_port) {
-      ERR("DeviceTexture: Failed to get mach port for shared texture");
-      return E_FAIL;
-    }
     uint32_t iosurface_id = allocation->iosurfaceID;
+    if (iosurface_backed ? !iosurface_id : !mach_port) {
+      ERR("DeviceTexture: Failed to get mach port for shared texture");
+      return E_FAIL;
+    }
     SharedResourceData runtimeData;
     MakeUniqueSharedName(runtimeData.mach_port_name);
     runtimeData.is_iosurface = iosurface_backed ? 1 : 0;
-    if (!WMTBootstrapRegister(runtimeData.mach_port_name, mach_port)) {
+    runtimeData.iosurface_id = iosurface_backed ? iosurface_id : 0;
+    // cranvr: launchd keeps a registered port, and the IOSurface behind it, until the user logs out. An IOSurface
+    // texture therefore registers nothing: the surface lives while a texture on it lives in any process.
+    if (!iosurface_backed && !WMTBootstrapRegister(runtimeData.mach_port_name, mach_port)) {
       ERR("DeviceTexture: Failed to register mach port for shared texture");
       return E_FAIL;
     }
@@ -524,16 +530,17 @@ CreateDeviceTexture3D(MTLD3D11Device *pDevice,
 template <typename tag>
 HRESULT
 ImportSharedTextureInternal(
-    MTLD3D11Device *pDevice, const typename tag::DESC1 *pDescUnchecked, mach_port_t MachPort, bool IsIOSurface,
+    MTLD3D11Device *pDevice, const typename tag::DESC1 *pDescUnchecked, mach_port_t MachPort, uint32_t IOSurfaceID,
     REFIID riid, void **ppTexture
 ) {
+  bool IsIOSurface = IOSurfaceID != 0;
   WMTTextureInfo info;
   typename tag::DESC1 finalDesc;
   if (FAILED(CreateMTLTextureDescriptor(pDevice, pDescUnchecked, &finalDesc, &info)))
     return E_INVALIDARG;
 
   auto texture = Rc<Texture>(new Texture(info, pDevice->GetMTLDevice()));
-  auto allocation = IsIOSurface ? texture->importIOSurface(MachPort) : texture->import(MachPort);
+  auto allocation = IsIOSurface ? texture->importIOSurface(IOSurfaceID) : texture->import(MachPort);
   if (!allocation)
     return E_FAIL;
   uint32_t iosurface_id = allocation->iosurfaceID;
@@ -597,8 +604,10 @@ ImportSharedTexture(MTLD3D11Device *pDevice, HANDLE hResource, REFIID riid, void
   destroy.hResource = open.hResource;
   D3DKMTDestroyAllocation(&destroy);
 
-  mach_port_t mach_port;
-  if (!WMTBootstrapLookUp(runtimeData.mach_port_name, &mach_port)) {
+  // cranvr: an IOSurface texture opens by the surface's global ID, with no port from launchd
+  mach_port_t mach_port = 0;
+  uint32_t iosurface_id = runtimeData.is_iosurface ? runtimeData.iosurface_id : 0;
+  if (runtimeData.is_iosurface ? !iosurface_id : !WMTBootstrapLookUp(runtimeData.mach_port_name, &mach_port)) {
     ERR("ImportSharedTexture: Failed to look up mach port");
     return E_INVALIDARG;
   }
@@ -607,15 +616,15 @@ ImportSharedTexture(MTLD3D11Device *pDevice, HANDLE hResource, REFIID riid, void
   {
   case D3D11_RESOURCE_DIMENSION_TEXTURE1D:
     return ImportSharedTextureInternal<tag_texture_1d>(
-        pDevice, &runtimeData.desc.desc1d, mach_port, runtimeData.is_iosurface != 0, riid, ppTexture
+        pDevice, &runtimeData.desc.desc1d, mach_port, iosurface_id, riid, ppTexture
     );
   case D3D11_RESOURCE_DIMENSION_TEXTURE2D:
     return ImportSharedTextureInternal<tag_texture_2d>(
-        pDevice, &runtimeData.desc.desc2d, mach_port, runtimeData.is_iosurface != 0, riid, ppTexture
+        pDevice, &runtimeData.desc.desc2d, mach_port, iosurface_id, riid, ppTexture
     );
   case D3D11_RESOURCE_DIMENSION_TEXTURE3D:
     return ImportSharedTextureInternal<tag_texture_3d>(
-        pDevice, &runtimeData.desc.desc3d, mach_port, runtimeData.is_iosurface != 0, riid, ppTexture
+        pDevice, &runtimeData.desc.desc3d, mach_port, iosurface_id, riid, ppTexture
     );
   default:
     ERR("ImportSharedTexture: Unsupported resource dimension");
@@ -689,8 +698,10 @@ ImportSharedTextureFromNtHandle(MTLD3D11Device *pDevice, HANDLE hResource, REFII
     D3DKMTDestroyKeyedMutex(&destroyMutex);
   }
 
-  mach_port_t mach_port;
-  if (!WMTBootstrapLookUp(runtimeData.mach_port_name, &mach_port)) {
+  // cranvr: an IOSurface texture opens by the surface's global ID, with no port from launchd
+  mach_port_t mach_port = 0;
+  uint32_t iosurface_id = runtimeData.is_iosurface ? runtimeData.iosurface_id : 0;
+  if (runtimeData.is_iosurface ? !iosurface_id : !WMTBootstrapLookUp(runtimeData.mach_port_name, &mach_port)) {
     ERR("ImportSharedTexture: Failed to look up mach port");
     return E_INVALIDARG;
   }
@@ -699,15 +710,15 @@ ImportSharedTextureFromNtHandle(MTLD3D11Device *pDevice, HANDLE hResource, REFII
   {
   case D3D11_RESOURCE_DIMENSION_TEXTURE1D:
     return ImportSharedTextureInternal<tag_texture_1d>(
-        pDevice, &runtimeData.desc.desc1d, mach_port, runtimeData.is_iosurface != 0, riid, ppTexture
+        pDevice, &runtimeData.desc.desc1d, mach_port, iosurface_id, riid, ppTexture
     );
   case D3D11_RESOURCE_DIMENSION_TEXTURE2D:
     return ImportSharedTextureInternal<tag_texture_2d>(
-        pDevice, &runtimeData.desc.desc2d, mach_port, runtimeData.is_iosurface != 0, riid, ppTexture
+        pDevice, &runtimeData.desc.desc2d, mach_port, iosurface_id, riid, ppTexture
     );
   case D3D11_RESOURCE_DIMENSION_TEXTURE3D:
     return ImportSharedTextureInternal<tag_texture_3d>(
-        pDevice, &runtimeData.desc.desc3d, mach_port, runtimeData.is_iosurface != 0, riid, ppTexture
+        pDevice, &runtimeData.desc.desc3d, mach_port, iosurface_id, riid, ppTexture
     );
   default:
     ERR("ImportSharedTexture: Unsupported resource dimension");
diff --git a/src/dxmt/dxmt_texture.cpp b/src/dxmt/dxmt_texture.cpp
index dc8a812..2bb23d9 100644
--- a/src/dxmt/dxmt_texture.cpp
+++ b/src/dxmt/dxmt_texture.cpp
@@ -214,14 +214,15 @@ Texture::import(mach_port_t mach_port) {
 }
 
 Rc<TextureAllocation>
-Texture::importIOSurface(mach_port_t mach_port) {
+Texture::importIOSurface(uint32_t iosurface_id) {
   Flags<TextureAllocationFlag> flags;
   // Unlike import(), the descriptor must be sent: the texture is created from
   // the looked-up IOSurface rather than a MTLSharedTextureHandle.
   WMTTextureInfo info = info_; // copy
   info.options = WMTResourceHazardTrackingModeUntracked;
-  info.mach_port = mach_port;
-  info.reserved = 0;
+  // cranvr: the surface's global ID names it (winemetal opens it with IOSurfaceLookup)
+  info.mach_port = 0;
+  info.reserved = iosurface_id;
   auto texture = device_.newTextureFromIOSurface(info);
   if (texture) {
     if (info.options & WMTResourceStorageModeManaged)
diff --git a/src/dxmt/dxmt_texture.hpp b/src/dxmt/dxmt_texture.hpp
index 38f43fe..fb207b8 100644
--- a/src/dxmt/dxmt_texture.hpp
+++ b/src/dxmt/dxmt_texture.hpp
@@ -254,7 +254,7 @@ public:
 
   Rc<TextureAllocation> allocate(Flags<TextureAllocationFlag> flags);
   Rc<TextureAllocation> import(mach_port_t mach_port);
-  Rc<TextureAllocation> importIOSurface(mach_port_t mach_port);
+  Rc<TextureAllocation> importIOSurface(uint32_t iosurface_id);
 
   TextureView &view(TextureViewKey key);
   TextureView &view(TextureViewKey key, TextureAllocation *allocation);
diff --git a/src/winemetal/unix/winemetal_unix.c b/src/winemetal/unix/winemetal_unix.c
index e86df4e..fc4974e 100644
--- a/src/winemetal/unix/winemetal_unix.c
+++ b/src/winemetal/unix/winemetal_unix.c
@@ -2664,10 +2664,11 @@ _MTLDevice_newSharedTexture(void *obj) {
 }
 
 /*
- * Basalt extension. Create (mach_port == 0) or import (mach_port != 0) a
- * texture whose backing store is an IOSurface, so a non-Wine process can map
- * the same pixels via IOSurfaceLookup(info->reserved). A nil result is
- * reported as ret == 0 with STATUS_SUCCESS, matching _MTLDevice_newTexture.
+ * Basalt extension. Create (info->reserved == 0) or import (info->reserved is
+ * the IOSurfaceID of an existing surface) a texture whose backing store is an
+ * IOSurface, so a non-Wine process can map the same pixels via
+ * IOSurfaceLookup(info->reserved). A nil result is reported as ret == 0 with
+ * STATUS_SUCCESS, matching _MTLDevice_newTexture.
  */
 static NTSTATUS
 _MTLDevice_newTextureFromIOSurface(void *obj) {
@@ -2686,9 +2687,18 @@ _MTLDevice_newTextureFromIOSurface(void *obj) {
       info->array_length != 1 || info->sample_count != 1)
     return STATUS_SUCCESS;
 
+  /*
+   * cranvr: no Mach port of the surface. The port held the surface until the
+   * process ended, and DXMT registered it with launchd, which held it until the
+   * user logged out. Another texture opens the surface by its global ID
+   * (info->reserved in), so the texture is the surface's only owner here and
+   * the surface goes with the texture's last release.
+   */
   IOSurfaceRef surface = NULL;
-  if (info->mach_port) {
-    surface = IOSurfaceLookupFromMachPort(info->mach_port);
+  uint32_t import_id = info->reserved;
+  info->mach_port = 0;
+  if (import_id) {
+    surface = IOSurfaceLookup(import_id);
     if (!surface)
       return STATUS_SUCCESS;
   } else {
@@ -2744,9 +2754,7 @@ _MTLDevice_newTextureFromIOSurface(void *obj) {
   extract_texture_descriptor(ret, info);
   info->reserved = IOSurfaceGetID(surface);
   info->gpu_resource_id = [ret gpuResourceID]._impl;
-  if (!info->mach_port)
-    info->mach_port = IOSurfaceCreateMachPort(surface);
-  /* The texture and the mach port each hold their own surface reference. */
+  /* The texture holds its own reference to the surface. */
   CFRelease(surface);
   params->ret = (obj_handle_t)ret;
   return STATUS_SUCCESS;
