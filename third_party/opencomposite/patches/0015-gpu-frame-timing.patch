+/**
+ * cranvr: the GPU time of a game's frames on the game's own device, from the return of WaitGetPoses to the frame's
+ * last submit. IVRCompositor::GetFrameTiming reports it. A game that sizes its images by the frame time (Half-Life:
+ * Alyx's auto fidelity) read a fixed 9 ms before and stayed at its smallest size at 120 Hz.
+ */
+class FrameTimer {
+public:
+	virtual ~FrameTimer() = default;
+
+	/** The frame's GPU work begins: WaitGetPoses returned */
+	virtual void Begin() = 0;
+
+	/** The frame's GPU work ends: the game submitted both eyes */
+	virtual void End() = 0;
+
+	/** The GPU time of the newest frame that the GPU finished, in milliseconds, or none before the first */
+	virtual std::optional<float> LastMs() = 0;
+};
diff --git c/OpenOVR/Compositor/dx11compositor.cpp i/OpenOVR/Compositor/dx11compositor.cpp
index cbe7e78..1a12fda 100644
--- c/OpenOVR/Compositor/dx11compositor.cpp
+++ i/OpenOVR/Compositor/dx11compositor.cpp
@@ -746,3 +746,126 @@ bool DX11Compositor::GetFormatInfo(DXGI_FORMAT format, DX11Compositor::DxgiForma
 }
 
 #endif
+
+// cranvr: four frames of queries: the GPU finishes a frame one or two frames after its submit, and a frame whose
+// queries have no answer yet keeps its slot. GetData never waits (D3D11_ASYNC_GETDATA_DONOTFLUSH).
+class DX11FrameTimer : public FrameTimer {
+public:
+	explicit DX11FrameTimer(ID3D11Device* device)
+	    : device(device)
+	{
+		device->AddRef();
+		device->GetImmediateContext(&context);
+		for (Frame& frame : frames) {
+			D3D11_QUERY_DESC disjoint{ D3D11_QUERY_TIMESTAMP_DISJOINT, 0 };
+			D3D11_QUERY_DESC stamp{ D3D11_QUERY_TIMESTAMP, 0 };
+			if (FAILED(device->CreateQuery(&disjoint, &frame.disjoint)) || FAILED(device->CreateQuery(&stamp, &frame.begin))
+			    || FAILED(device->CreateQuery(&stamp, &frame.end))) {
+				OOVR_LOG("cranvr: no timestamp queries on the game's device: GetFrameTiming reports fixed times");
+				usable = false;
+				return;
+			}
+		}
+		OOVR_LOG("cranvr: GetFrameTiming reports the GPU time of the game's frames");
+	}
+
+	~DX11FrameTimer() override
+	{
+		for (Frame& frame : frames) {
+			for (ID3D11Query* query : { frame.disjoint, frame.begin, frame.end })
+				if (query)
+					query->Release();
+		}
+		context->Release();
+		device->Release();
+	}
+
+	void Begin() override
+	{
+		if (!usable || open)
+			return;
+		Collect();
+		Frame& frame = frames[current];
+		// The GPU has not answered for this slot yet: this frame goes untimed
+		if (frame.pending)
+			return;
+		context->Begin(frame.disjoint);
+		context->End(frame.begin);
+		open = true;
+	}
+
+	void End() override
+	{
+		if (!open)
+			return;
+		Frame& frame = frames[current];
+		context->End(frame.end);
+		context->End(frame.disjoint);
+		frame.pending = true;
+		frame.order = ++submitted;
+		current = (current + 1) % frameCount;
+		open = false;
+	}
+
+	std::optional<float> LastMs() override
+	{
+		Collect();
+		return lastMs;
+	}
+
+private:
+	struct Frame {
+		ID3D11Query* disjoint = nullptr;
+		ID3D11Query* begin = nullptr;
+		ID3D11Query* end = nullptr;
+		bool pending = false;
+		uint64_t order = 0;
+	};
+	static constexpr int frameCount = 4;
+
+	void Collect()
+	{
+		for (Frame& frame : frames) {
+			if (!frame.pending)
+				continue;
+			D3D11_QUERY_DATA_TIMESTAMP_DISJOINT disjoint{};
+			UINT64 begin = 0, end = 0;
+			constexpr UINT noFlush = D3D11_ASYNC_GETDATA_DONOTFLUSH;
+			if (context->GetData(frame.disjoint, &disjoint, sizeof(disjoint), noFlush) != S_OK
+			    || context->GetData(frame.begin, &begin, sizeof(begin), noFlush) != S_OK
+			    || context->GetData(frame.end, &end, sizeof(end), noFlush) != S_OK)
+				continue;
+			frame.pending = false;
+			if (disjoint.Disjoint || !disjoint.Frequency || end < begin || frame.order < newestOrder)
+				continue;
+			newestOrder = frame.order;
+			lastMs = (float)((double)(end - begin) * 1000.0 / (double)disjoint.Frequency);
+			sumMs += *lastMs;
+			maxMs = std::max(maxMs, *lastMs);
+			// A line every 600 timed frames (5 s at 120 Hz) says what the game reads
+			if (++timed % 600 == 0) {
+				OOVR_LOGF("cranvr: the game's frames took %.2f ms of GPU time on average, at most %.2f ms, in the last 600 timed frames", sumMs / 600.0f, maxMs);
+				sumMs = 0.0f;
+				maxMs = 0.0f;
+			}
+		}
+	}
+
+	ID3D11Device* device;
+	ID3D11DeviceContext* context = nullptr;
+	Frame frames[frameCount];
+	int current = 0;
+	bool open = false;
+	bool usable = true;
+	uint64_t submitted = 0;
+	uint64_t newestOrder = 0;
+	std::optional<float> lastMs;
+	uint64_t timed = 0;
+	float sumMs = 0.0f;
+	float maxMs = 0.0f;
+};
+
+std::unique_ptr<FrameTimer> CreateDX11FrameTimer(ID3D11Device* device)
+{
+	return std::make_unique<DX11FrameTimer>(device);
+}
