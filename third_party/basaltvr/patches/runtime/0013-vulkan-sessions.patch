diff --git a/runtime/pe/vulkan.cpp b/runtime/pe/vulkan.cpp
new file mode 100644
index 0000000..74533f6
--- /dev/null
+++ b/runtime/pe/vulkan.cpp
@@ -0,0 +1,1003 @@
+// cranvr: Vulkan sessions (XR_KHR_vulkan_enable and XR_KHR_vulkan_enable2).
+//
+// A Vulkan game under Wine renders through winevulkan and MoltenVK. Each swapchain image is a
+// VkImage on a Metal texture that lies on a global IOSurface: cranvr's DXMT fork makes the texture
+// (winemetal.dll, MTLDevice_newTextureFromIOSurface) and the game's device imports it with
+// VkImportMetalTextureInfoEXT, which cranvr's Wine patch 0009 passes to MoltenVK. The game renders
+// into the IOSurface itself, and cranvr-host reads it by its ID. No pixel goes through the CPU.
+//
+// A swapchain with two slices stays private to the game's device, as with Direct3D 11: at
+// xrEndFrame a GPU copy puts each slice into an IOSurface image of its own.
+//
+// The frame handoff: xrEndFrame submits a fence to the binding's queue after the game's commands.
+// The control waiter sends the frame to the host once the fence has signaled.
+
+#include "runtime.hpp"
+
+#include "control.hpp"
+
+#include <vulkan/vulkan_metal.h>
+
+#include <windows.h>
+
+#include <array>
+#include <cstddef>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <new>
+
+namespace {
+
+// A Vulkan structure with its type and every other member zero
+template <typename T>
+T vkStruct(VkStructureType type) {
+    T value{};
+    value.sType = type;
+    return value;
+}
+
+// --- winemetal.dll of cranvr's DXMT fork ------------------------------------------------------
+
+typedef uint64_t ObjHandle;
+
+// Mirrors struct WMTTextureInfo of DXMT v0.80 (src/winemetal/winemetal.h). The DXMT fork and
+// this runtime ship together in cranvr's game support.
+struct WmtTextureInfo {
+    uint32_t pixelFormat;
+    uint32_t width;
+    uint32_t height;
+    uint32_t depth;
+    uint32_t arrayLength;
+    uint32_t type : 8;
+    uint32_t mipmapLevelCount : 8;
+    uint32_t sampleCount : 8;
+    uint32_t usage : 8;
+    uint64_t options;
+    uint32_t reserved;  // out: the global IOSurfaceID
+    uint32_t machPort;  // in: 0 makes a new IOSurface
+    uint64_t gpuResourceId;
+};
+static_assert(sizeof(WmtTextureInfo) == 48, "WMTTextureInfo of DXMT v0.80");
+static_assert(offsetof(WmtTextureInfo, options) == 24, "WMTTextureInfo of DXMT v0.80");
+static_assert(offsetof(WmtTextureInfo, reserved) == 32, "WMTTextureInfo of DXMT v0.80");
+
+constexpr uint32_t kWmtPixelFormatBgra8Unorm = 80;
+constexpr uint32_t kWmtPixelFormatBgra8UnormSrgb = 81;
+constexpr uint32_t kWmtTextureType2D = 2;
+constexpr uint32_t kWmtUsageShaderRead = 1;
+constexpr uint32_t kWmtUsageShaderWrite = 2;
+constexpr uint32_t kWmtUsageRenderTarget = 4;
+constexpr uint32_t kWmtUsagePixelFormatView = 16;
+constexpr uint64_t kWmtStorageModeShared = 0;
+
+struct WineMetal {
+    ObjHandle (*copyAllDevices)() = nullptr;
+    ObjHandle (*arrayObject)(ObjHandle, uint64_t) = nullptr;
+    uint64_t (*arrayCount)(ObjHandle) = nullptr;
+    ObjHandle (*newTextureFromIOSurface)(ObjHandle, WmtTextureInfo*) = nullptr;
+    ObjHandle device = 0;
+};
+
+INIT_ONCE gLoadOnce = INIT_ONCE_STATIC_INIT;
+bool gLoaded = false;
+PFN_vkGetInstanceProcAddr gGetInstanceProcAddr = nullptr;
+WineMetal gMetal;
+
+// Loads vulkan-1.dll and winemetal.dll at the first Vulkan call, so a Direct3D 11 game loads
+// neither.
+BOOL CALLBACK loadLibraries(PINIT_ONCE, PVOID, PVOID*) {
+    HMODULE vulkan = LoadLibraryA("vulkan-1.dll");
+    HMODULE metal = LoadLibraryA("winemetal.dll");
+    if (vulkan == nullptr || metal == nullptr) {
+        std::fprintf(stderr, "Basalt OpenXR: Vulkan needs vulkan-1.dll and winemetal.dll (%s missing)\n",
+                     vulkan == nullptr ? "vulkan-1.dll" : "winemetal.dll");
+        return TRUE;
+    }
+    gGetInstanceProcAddr = reinterpret_cast<PFN_vkGetInstanceProcAddr>(
+        reinterpret_cast<void*>(GetProcAddress(vulkan, "vkGetInstanceProcAddr")));
+    gMetal.copyAllDevices = reinterpret_cast<ObjHandle (*)()>(
+        reinterpret_cast<void*>(GetProcAddress(metal, "WMTCopyAllDevices")));
+    gMetal.arrayObject = reinterpret_cast<ObjHandle (*)(ObjHandle, uint64_t)>(
+        reinterpret_cast<void*>(GetProcAddress(metal, "NSArray_object")));
+    gMetal.arrayCount = reinterpret_cast<uint64_t (*)(ObjHandle)>(
+        reinterpret_cast<void*>(GetProcAddress(metal, "NSArray_count")));
+    gMetal.newTextureFromIOSurface = reinterpret_cast<ObjHandle (*)(ObjHandle, WmtTextureInfo*)>(
+        reinterpret_cast<void*>(GetProcAddress(metal, "MTLDevice_newTextureFromIOSurface")));
+    if (gGetInstanceProcAddr == nullptr || gMetal.copyAllDevices == nullptr || gMetal.arrayObject == nullptr ||
+        gMetal.arrayCount == nullptr || gMetal.newTextureFromIOSurface == nullptr) {
+        std::fprintf(stderr, "Basalt OpenXR: winemetal.dll is not cranvr's DXMT fork, or vulkan-1.dll is broken\n");
+        return TRUE;
+    }
+    // A Mac with Apple silicon has one GPU: MoltenVK's device and DXMT's device are the same Metal device
+    const ObjHandle devices = gMetal.copyAllDevices();
+    if (devices == 0 || gMetal.arrayCount(devices) == 0) {
+        std::fprintf(stderr, "Basalt OpenXR: no Metal device\n");
+        return TRUE;
+    }
+    gMetal.device = gMetal.arrayObject(devices, 0);
+    gLoaded = gMetal.device != 0;
+    return TRUE;
+}
+
+bool librariesLoaded() {
+    InitOnceExecuteOnce(&gLoadOnce, loadLibraries, nullptr, nullptr);
+    return gLoaded;
+}
+
+// --- requirements and devices ----------------------------------------------------------------
+
+SRWLOCK gVulkanLock = SRWLOCK_INIT;
+XrInstance gRequirementsInstance = XR_NULL_HANDLE;
+// The Vulkan instance that the game asked a physical device for: xrCreateVulkanDeviceKHR finds
+// vkCreateDevice through it.
+VkInstance gGameVulkanInstance = VK_NULL_HANDLE;
+
+constexpr std::array<VkFormat, 2> kSwapchainFormats = {
+    // The same order and the same bytes as the Direct3D 11 formats: cranvr-host wraps BGRA IOSurfaces
+    VK_FORMAT_B8G8R8A8_UNORM,
+    VK_FORMAT_B8G8R8A8_SRGB,
+};
+
+XrResult checkInstanceAndSystem(XrInstance instance, XrSystemId systemId, bool enable2) {
+    if (!basalt::isValidInstance(instance)) {
+        return XR_ERROR_HANDLE_INVALID;
+    }
+    if (enable2 ? !basalt::isVulkanEnable2Enabled(instance) : !basalt::isVulkanEnableEnabled(instance)) {
+        return XR_ERROR_FUNCTION_UNSUPPORTED;
+    }
+    if (systemId != basalt::kSystemId) {
+        return XR_ERROR_SYSTEM_INVALID;
+    }
+    return XR_SUCCESS;
+}
+
+XrResult fillRequirements(XrInstance instance, XrGraphicsRequirementsVulkanKHR* requirements) {
+    if (requirements == nullptr || requirements->type != XR_TYPE_GRAPHICS_REQUIREMENTS_VULKAN_KHR) {
+        return XR_ERROR_VALIDATION_FAILURE;
+    }
+    if (!librariesLoaded()) {
+        return XR_ERROR_RUNTIME_FAILURE;
+    }
+    // MoltenVK 1.4 under Wine 11.10
+    requirements->minApiVersionSupported = XR_MAKE_VERSION(1, 0, 0);
+    requirements->maxApiVersionSupported = XR_MAKE_VERSION(1, 4, 0);
+    AcquireSRWLockExclusive(&gVulkanLock);
+    gRequirementsInstance = instance;
+    ReleaseSRWLockExclusive(&gVulkanLock);
+    return XR_SUCCESS;
+}
+
+// The first physical device of the game's instance: MoltenVK lists the Mac's one GPU
+XrResult firstPhysicalDevice(VkInstance vulkanInstance, VkPhysicalDevice* physicalDevice) {
+    if (vulkanInstance == VK_NULL_HANDLE || physicalDevice == nullptr) {
+        return XR_ERROR_VALIDATION_FAILURE;
+    }
+    if (!librariesLoaded()) {
+        return XR_ERROR_RUNTIME_FAILURE;
+    }
+    auto enumerate = reinterpret_cast<PFN_vkEnumeratePhysicalDevices>(
+        gGetInstanceProcAddr(vulkanInstance, "vkEnumeratePhysicalDevices"));
+    if (enumerate == nullptr) {
+        return XR_ERROR_RUNTIME_FAILURE;
+    }
+    uint32_t count = 1;
+    VkPhysicalDevice first = VK_NULL_HANDLE;
+    const VkResult result = enumerate(vulkanInstance, &count, &first);
+    if ((result != VK_SUCCESS && result != VK_INCOMPLETE) || count == 0 || first == VK_NULL_HANDLE) {
+        return XR_ERROR_RUNTIME_FAILURE;
+    }
+    AcquireSRWLockExclusive(&gVulkanLock);
+    gGameVulkanInstance = vulkanInstance;
+    ReleaseSRWLockExclusive(&gVulkanLock);
+    *physicalDevice = first;
+    return XR_SUCCESS;
+}
+
+// The runtime asks for no Vulkan extension: an empty space-separated list
+XrResult writeExtensionList(uint32_t capacity, uint32_t* countOutput, char* buffer) {
+    if (countOutput == nullptr) {
+        return XR_ERROR_VALIDATION_FAILURE;
+    }
+    *countOutput = 1;
+    if (capacity == 0) {
+        return XR_SUCCESS;
+    }
+    if (buffer == nullptr) {
+        return XR_ERROR_VALIDATION_FAILURE;
+    }
+    buffer[0] = '\0';
+    return XR_SUCCESS;
+}
