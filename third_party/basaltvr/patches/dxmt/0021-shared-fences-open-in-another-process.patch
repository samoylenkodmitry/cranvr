 namespace dxmt {
 
+/* cranvr: what the NT handle of a shared fence carries for another process: the name under which winemetal's broker
+   serves the fence's event. Wine 11.10 keeps private data for resources only. It shares a sync object together with a
+   resource only in a bundle of three objects (D3DKMTShareObjects: a resource, a keyed mutex and the sync object), as
+   for a texture with a keyed mutex. So the fence's handle shares such a bundle. The resource holds this data, and
+   nobody uses the keyed mutex. OpenSharedFence takes the data and the sync object with
+   D3DKMTOpenResourceFromNtHandle. The tag keeps the handle of a texture from opening as a fence and back: a texture's
+   data has another size. */
+struct SharedFenceData {
+  char tag[16];
+  char mach_port_name[54];
+};
+constexpr char kSharedFenceTag[16] = "cranvr fence 1";
+
+/* The D3DKMT objects of a shared fence in this process: the sync object, and the resource and the keyed mutex that
+   carry it in the handle's bundle */
+struct SharedFenceObjects {
+  D3DKMT_HANDLE sync = 0;
+  D3DKMT_HANDLE resource = 0;
+  D3DKMT_HANDLE mutex = 0;
+};
+
+static void
+DestroySharedFenceObjects(D3DKMT_HANDLE device, const SharedFenceObjects &objects) {
+  if (objects.resource) {
+    D3DKMT_DESTROYALLOCATION destroy = {};
+    destroy.hDevice = device;
+    destroy.hResource = objects.resource;
+    D3DKMTDestroyAllocation(&destroy);
+  }
+  if (objects.mutex) {
+    D3DKMT_DESTROYKEYEDMUTEX destroy = {};
+    destroy.hKeyedMutex = objects.mutex;
+    D3DKMTDestroyKeyedMutex(&destroy);
+  }
+  if (objects.sync) {
+    D3DKMT_DESTROYSYNCHRONIZATIONOBJECT destroy = {};
+    destroy.hSyncObject = objects.sync;
+    D3DKMTDestroySynchronizationObject(&destroy);
+  }
+}
+
 class MTLD3D11FenceImpl : public MTLD3D11DeviceChild<MTLD3D11Fence> {
 public:
   MTLD3D11FenceImpl(
-      MTLD3D11Device *pDevice, WMT::Reference<WMT::SharedEvent> event, D3DKMT_HANDLE handle,
+      MTLD3D11Device *pDevice, WMT::Reference<WMT::SharedEvent> event, SharedFenceObjects objects,
       const char *servedName = nullptr
   ) :
       MTLD3D11DeviceChild<MTLD3D11Fence>(pDevice) {
     this->event = std::move(event);
-    local_kmt = handle;
+    local_kmt = objects.sync;
+    bundle = objects;
