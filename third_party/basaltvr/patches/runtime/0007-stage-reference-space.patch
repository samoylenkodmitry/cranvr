diff --git a/runtime/pe/space.cpp b/runtime/pe/space.cpp
--- a/runtime/pe/space.cpp
+++ b/runtime/pe/space.cpp
@@ -20,9 +20,14 @@
 constexpr uintptr_t kFirstSpaceHandle = static_cast<uintptr_t>(0x40000);
 constexpr uintptr_t kSpaceHandleStride = static_cast<uintptr_t>(0x10);
 constexpr size_t kMaxSpaces = 64;
-constexpr std::array<XrReferenceSpaceType, 2> kSupportedReferenceSpaces = {
+// cranvr: STAGE is offered too. The poses that cranvr-host sends are in a room whose floor lies at
+// height 0 (the host raises the headset's room by the height of its floor), so LOCAL is already
+// the floor-level space that OpenXR calls STAGE. A game that asks for STAGE, as OpenComposite does for
+// the standing space of OpenVR, gets the same space.
+constexpr std::array<XrReferenceSpaceType, 3> kSupportedReferenceSpaces = {
     XR_REFERENCE_SPACE_TYPE_VIEW,
     XR_REFERENCE_SPACE_TYPE_LOCAL,
+    XR_REFERENCE_SPACE_TYPE_STAGE,
 };
 
 // The headset supplies LOCAL-from-HEAD. These eye values are conservative
@@ -204,7 +209,8 @@
         return XR_ERROR_VALIDATION_FAILURE;
     }
     if (createInfo->referenceSpaceType != XR_REFERENCE_SPACE_TYPE_VIEW &&
-        createInfo->referenceSpaceType != XR_REFERENCE_SPACE_TYPE_LOCAL) {
+        createInfo->referenceSpaceType != XR_REFERENCE_SPACE_TYPE_LOCAL &&
+        createInfo->referenceSpaceType != XR_REFERENCE_SPACE_TYPE_STAGE) {
         return XR_ERROR_REFERENCE_SPACE_UNSUPPORTED;
     }
     if (!poseValid(createInfo->poseInReferenceSpace)) {
@@ -228,7 +234,11 @@
     gNextSpaceHandle += kSpaceHandleStride;
     available->session = session;
     available->kind = SpaceKind::kReference;
-    available->referenceSpaceType = createInfo->referenceSpaceType;
+    // A STAGE space is a LOCAL space (see kSupportedReferenceSpaces): the runtime keeps one kind
+    available->referenceSpaceType =
+        createInfo->referenceSpaceType == XR_REFERENCE_SPACE_TYPE_STAGE
+            ? XR_REFERENCE_SPACE_TYPE_LOCAL
+            : createInfo->referenceSpaceType;
     available->action = XR_NULL_HANDLE;
     available->subactionPath = XR_NULL_PATH;
     available->pose = createInfo->poseInReferenceSpace;
@@ -632,7 +642,8 @@
         return XR_ERROR_VALIDATION_FAILURE;
     }
     if (referenceSpaceType != XR_REFERENCE_SPACE_TYPE_VIEW &&
-        referenceSpaceType != XR_REFERENCE_SPACE_TYPE_LOCAL) {
+        referenceSpaceType != XR_REFERENCE_SPACE_TYPE_LOCAL &&
+        referenceSpaceType != XR_REFERENCE_SPACE_TYPE_STAGE) {
         return XR_ERROR_REFERENCE_SPACE_UNSUPPORTED;
     }
 
