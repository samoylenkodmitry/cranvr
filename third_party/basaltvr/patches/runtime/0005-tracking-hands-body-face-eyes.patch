index ced3878..95c4480 100644
--- a/runtime/pe/basalt_control_protocol.h
+++ b/runtime/pe/basalt_control_protocol.h
@@ -80,6 +80,40 @@
  *     u32 reserved (zero)
  *   TEARDOWN (either direction)
  *     u32 reason (BASALT_TEARDOWN_*)
+ *
+ * cranvr: tracking of hands, body, face and eyes (messages 19 to 23). The runtime
+ * says that it takes them by writing the word "tracking" to runtime-features.txt
+ * next to the control file, as it does for "aim". A daemon must not send
+ * messages 20 to 23 to a runtime that did not: it closes the connection at a
+ * message that it does not know. The daemon also writes tracking-features.txt
+ * next to the control file: the features of the connected headset, as words
+ * (hands body full_body face eyes). The runtime reads it before a game lists its
+ * OpenXR extensions, and lists the extensions of those features only. A feature
+ * is a bit in TRACKING_REQUEST: 1 hands, 2 body, 4 full_body, 8 face, 16 eyes.
+ * Poses are in the headset's tracking space, like HEAD_POSE's. A joint's flags
+ * byte holds 1 position valid, 2 orientation valid, 4 position tracked,
+ * 8 orientation tracked.
+ *   TRACKING_REQUEST (runtime -> daemon; sent when the set changes)
+ *     u32 features    the features that the game uses now
+ *   HAND_TRACKING (daemon -> runtime; latest sample wins per hand)
+ *     u64 target_timestamp_ns, u32 hand (0 left, 1 right), u32 flags (bit 0: tracked),
+ *     only for a tracked hand:
+ *       f32 root_orientation[4] (xyzw), f32 root_position[3],
+ *       f32 root_linear_velocity[3], f32 root_angular_velocity[3],
+ *       then 26 joints of XR_EXT_hand_tracking in its order, each
+ *       f32 orientation[4], f32 position[3], then u8 flags[26]
+ *     The root is the wrist. Its velocities move the whole hand.
+ *   BODY_TRACKING (daemon -> runtime; latest sample wins)
+ *     u64 target_timestamp_ns, u32 joint_count (70 or 84), u32 flags (bit 0: tracked),
+ *     f32 confidence, the root's motion as in HAND_TRACKING, then joint_count joints
+ *     (f32 orientation[4], f32 position[3]) and joint_count flag bytes.
+ *     The 70 joints are XrBodyJointFB's, the 84 are XrFullBodyJointMETA's.
+ *   FACE_TRACKING (daemon -> runtime; latest sample wins)
+ *     u64 target_timestamp_ns, u32 flags (1 valid, 2 eye-following weights valid,
+ *     4 from audio), f32 confidences[2], f32 weights[70] from 0 to 1
+ *   EYE_GAZE (daemon -> runtime; latest sample wins)
+ *     u64 target_timestamp_ns, u32 flags (bit 0: tracked),
+ *     f32 orientation[4], f32 position[3]; the gaze runs along -Z
  */
 
 #define BASALT_CONTROL_PROTOCOL_VERSION 9u
@@ -113,6 +147,20 @@ enum {
