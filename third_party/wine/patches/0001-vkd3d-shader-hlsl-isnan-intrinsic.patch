+static bool intrinsic_isnan(struct hlsl_ctx *ctx,
+        const struct parse_initializer *params, const struct vkd3d_shader_location *loc)
+{
+    if (!elementwise_intrinsic_float_convert_args(ctx, params, loc))
+        return false;
+
+    /* NaN is the one value that differs from itself. The comparison is unordered, so it is true for NaN. */
+    return !!add_binary_comparison_expr(ctx, params->instrs, HLSL_OP2_NEQUAL,
+            params->args[0], params->args[0], loc);
+}
