+
+XrResult XRAPI_CALL createVulkanInstance(
+    XrInstance instance,
+    const XrVulkanInstanceCreateInfoKHR* createInfo,
+    VkInstance* vulkanInstance,
+    VkResult* vulkanResult) {
+    if (createInfo == nullptr || createInfo->type != XR_TYPE_VULKAN_INSTANCE_CREATE_INFO_KHR ||
+        createInfo->createFlags != 0 || createInfo->pfnGetInstanceProcAddr == nullptr ||
+        createInfo->vulkanCreateInfo == nullptr || vulkanInstance == nullptr || vulkanResult == nullptr) {
+        return XR_ERROR_VALIDATION_FAILURE;
+    }
+    const XrResult check = checkInstanceAndSystem(instance, createInfo->systemId, true);
+    if (XR_FAILED(check)) {
+        return check;
+    }
+    auto create = reinterpret_cast<PFN_vkCreateInstance>(
+        createInfo->pfnGetInstanceProcAddr(VK_NULL_HANDLE, "vkCreateInstance"));
+    if (create == nullptr) {
+        return XR_ERROR_RUNTIME_FAILURE;
+    }
+    // The runtime needs no instance extension: the game's own create info goes as it is
+    *vulkanResult = create(createInfo->vulkanCreateInfo, createInfo->vulkanAllocator, vulkanInstance);
+    return XR_SUCCESS;
+}
+
+XrResult XRAPI_CALL getVulkanGraphicsDevice2(
+    XrInstance instance, const XrVulkanGraphicsDeviceGetInfoKHR* getInfo, VkPhysicalDevice* physicalDevice) {
+    if (getInfo == nullptr || getInfo->type != XR_TYPE_VULKAN_GRAPHICS_DEVICE_GET_INFO_KHR) {
+        return XR_ERROR_VALIDATION_FAILURE;
+    }
+    const XrResult check = checkInstanceAndSystem(instance, getInfo->systemId, true);
+    return XR_FAILED(check) ? check : firstPhysicalDevice(getInfo->vulkanInstance, physicalDevice);
+}
+
+XrResult XRAPI_CALL createVulkanDevice(
+    XrInstance instance,
+    const XrVulkanDeviceCreateInfoKHR* createInfo,
+    VkDevice* vulkanDevice,
+    VkResult* vulkanResult) {
+    if (createInfo == nullptr || createInfo->type != XR_TYPE_VULKAN_DEVICE_CREATE_INFO_KHR ||
+        createInfo->createFlags != 0 || createInfo->pfnGetInstanceProcAddr == nullptr ||
+        createInfo->vulkanCreateInfo == nullptr || createInfo->vulkanPhysicalDevice == VK_NULL_HANDLE ||
+        vulkanDevice == nullptr || vulkanResult == nullptr) {
+        return XR_ERROR_VALIDATION_FAILURE;
+    }
+    const XrResult check = checkInstanceAndSystem(instance, createInfo->systemId, true);
+    if (XR_FAILED(check)) {
+        return check;
+    }
+    AcquireSRWLockShared(&gVulkanLock);
+    const VkInstance gameInstance = gGameVulkanInstance;
+    ReleaseSRWLockShared(&gVulkanLock);
+    if (gameInstance == VK_NULL_HANDLE) {
+        // The extension asks the game for xrGetVulkanGraphicsDevice2KHR first
+        return XR_ERROR_VALIDATION_FAILURE;
+    }
+    auto create = reinterpret_cast<PFN_vkCreateDevice>(
+        createInfo->pfnGetInstanceProcAddr(gameInstance, "vkCreateDevice"));
+    if (create == nullptr) {
+        return XR_ERROR_RUNTIME_FAILURE;
+    }
+    // The runtime needs no device extension: winevulkan passes the IOSurface import of patch 0009
+    // without one
+    *vulkanResult = create(createInfo->vulkanPhysicalDevice, createInfo->vulkanCreateInfo,
+                           createInfo->vulkanAllocator, vulkanDevice);
+    return XR_SUCCESS;
+}
+
+const XrGraphicsBindingVulkanKHR* findVulkanBinding(const void* next) {
+    const auto* structure = static_cast<const XrBaseInStructure*>(next);
+    while (structure != nullptr) {
+        if (structure->type == XR_TYPE_GRAPHICS_BINDING_VULKAN_KHR) {
+            return reinterpret_cast<const XrGraphicsBindingVulkanKHR*>(structure);
+        }
+        structure = structure->next;
+    }
+    return nullptr;
+}
+
+XrResult createVulkanSession(
+    XrInstance instance, const XrGraphicsBindingVulkanKHR* binding, VulkanSession** session) {
+    *session = nullptr;
+    AcquireSRWLockShared(&gVulkanLock);
+    const bool requirementsQueried = gRequirementsInstance == instance;
+    ReleaseSRWLockShared(&gVulkanLock);
+    if (!requirementsQueried) {
+        return XR_ERROR_GRAPHICS_REQUIREMENTS_CALL_MISSING;
+    }
+    if (binding->instance == VK_NULL_HANDLE || binding->physicalDevice == VK_NULL_HANDLE ||
+        binding->device == VK_NULL_HANDLE || !librariesLoaded()) {
+        return XR_ERROR_GRAPHICS_DEVICE_INVALID;
+    }
+    auto* state = static_cast<VulkanSession*>(std::calloc(1, sizeof(VulkanSession)));
+    if (state != nullptr) {
+        ::new (state) VulkanSession();
+    }
+    if (state == nullptr) {
+        return XR_ERROR_OUT_OF_MEMORY;
+    }
+    state->instance = binding->instance;
+    state->physicalDevice = binding->physicalDevice;
+    state->device = binding->device;
+    state->queueFamilyIndex = binding->queueFamilyIndex;
+
+    auto getDeviceProcAddr = reinterpret_cast<PFN_vkGetDeviceProcAddr>(
+        gGetInstanceProcAddr(binding->instance, "vkGetDeviceProcAddr"));
+    auto getMemoryProperties = reinterpret_cast<PFN_vkGetPhysicalDeviceMemoryProperties>(
+        gGetInstanceProcAddr(binding->instance, "vkGetPhysicalDeviceMemoryProperties"));
+    auto getProperties = reinterpret_cast<PFN_vkGetPhysicalDeviceProperties>(
+        gGetInstanceProcAddr(binding->instance, "vkGetPhysicalDeviceProperties"));
+    auto getQueueFamilies = reinterpret_cast<PFN_vkGetPhysicalDeviceQueueFamilyProperties>(
+        gGetInstanceProcAddr(binding->instance, "vkGetPhysicalDeviceQueueFamilyProperties"));
+    PFN_vkGetDeviceQueue getDeviceQueue = nullptr;
+    const VkDevice device = binding->device;
+    const bool loaded = getDeviceProcAddr != nullptr && getMemoryProperties != nullptr && getProperties != nullptr &&
+        getQueueFamilies != nullptr &&
+        loadDevice(getDeviceProcAddr, device, "vkGetDeviceQueue", &getDeviceQueue) &&
+        loadDevice(getDeviceProcAddr, device, "vkCreateImage", &state->createImage) &&
+        loadDevice(getDeviceProcAddr, device, "vkDestroyImage", &state->destroyImage) &&
+        loadDevice(getDeviceProcAddr, device, "vkGetImageMemoryRequirements", &state->getImageMemoryRequirements) &&
+        loadDevice(getDeviceProcAddr, device, "vkAllocateMemory", &state->allocateMemory) &&
+        loadDevice(getDeviceProcAddr, device, "vkFreeMemory", &state->freeMemory) &&
+        loadDevice(getDeviceProcAddr, device, "vkBindImageMemory", &state->bindImageMemory) &&
+        loadDevice(getDeviceProcAddr, device, "vkCreateCommandPool", &state->createCommandPool) &&
+        loadDevice(getDeviceProcAddr, device, "vkDestroyCommandPool", &state->destroyCommandPool) &&
+        loadDevice(getDeviceProcAddr, device, "vkAllocateCommandBuffers", &state->allocateCommandBuffers) &&
+        loadDevice(getDeviceProcAddr, device, "vkResetCommandBuffer", &state->resetCommandBuffer) &&
+        loadDevice(getDeviceProcAddr, device, "vkBeginCommandBuffer", &state->beginCommandBuffer) &&
+        loadDevice(getDeviceProcAddr, device, "vkEndCommandBuffer", &state->endCommandBuffer) &&
+        loadDevice(getDeviceProcAddr, device, "vkCmdPipelineBarrier", &state->cmdPipelineBarrier) &&
+        loadDevice(getDeviceProcAddr, device, "vkCmdCopyImage", &state->cmdCopyImage) &&
+        loadDevice(getDeviceProcAddr, device, "vkQueueSubmit", &state->queueSubmit) &&
+        loadDevice(getDeviceProcAddr, device, "vkCreateFence", &state->createFence) &&
+        loadDevice(getDeviceProcAddr, device, "vkDestroyFence", &state->destroyFence) &&
+        loadDevice(getDeviceProcAddr, device, "vkWaitForFences", &state->waitForFences) &&
+        loadDevice(getDeviceProcAddr, device, "vkResetFences", &state->resetFences);
+    if (!loaded) {
+        std::free(state);
+        return XR_ERROR_GRAPHICS_DEVICE_INVALID;
+    }
+    uint32_t familyCount = 0;
+    getQueueFamilies(binding->physicalDevice, &familyCount, nullptr);
+    if (binding->queueFamilyIndex >= familyCount) {
+        std::free(state);
+        return XR_ERROR_GRAPHICS_DEVICE_INVALID;
+    }
+    getDeviceQueue(device, binding->queueFamilyIndex, binding->queueIndex, &state->queue);
+    if (state->queue == VK_NULL_HANDLE) {
+        std::free(state);
+        return XR_ERROR_GRAPHICS_DEVICE_INVALID;
+    }
+    getMemoryProperties(binding->physicalDevice, &state->memory);
+    VkPhysicalDeviceProperties properties{};
+    getProperties(binding->physicalDevice, &properties);
+    std::snprintf(state->renderer, sizeof(state->renderer), "Vulkan %u.%u on %s (MoltenVK, IOSurface images)",
+                  VK_API_VERSION_MAJOR(properties.apiVersion), VK_API_VERSION_MINOR(properties.apiVersion),
+                  properties.deviceName);
+    *session = state;
+    return XR_SUCCESS;
+}
