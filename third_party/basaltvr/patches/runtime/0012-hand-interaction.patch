+// cranvr: XR_EXT_hand_interaction for one hand (BASALT_MSG_HAND_INTERACTION)
+bool parseHandInteraction(const uint8_t* payload, size_t payloadLength) {
+    if (payloadLength < kHandInteractionInactivePayloadLength) {
+        return false;
+    }
+    PayloadReader reader(payload, payloadLength);
+    const uint64_t timestamp = reader.u64();
+    const uint32_t hand = reader.u32();
+    const uint32_t flags = reader.u32();
+    const bool tracked = (flags & 1u) != 0;
+    if (hand > 1 || (flags & ~15u) != 0 ||
+        payloadLength != (tracked ? kHandInteractionActivePayloadLength : kHandInteractionInactivePayloadLength)) {
+        return false;
+    }
+    HandInteractionRecord next{};
+    if (tracked) {
+        for (float& value : next.values) {
+            value = reader.f32();
+            if (!reader.ok() || !std::isfinite(value)) {
+                return false;
+            }
+            value = value < 0.0f ? 0.0f : (value > 1.0f ? 1.0f : value);
+        }
+        for (TrackedRootRecord& pose : next.poses) {
+            if (!readRoot(reader, &pose)) {
+                return false;
+            }
+        }
+    }
+    HandInteractionRecord& record = gHandInteractions[hand];
+    if (timestamp < record.questTimestamp || !gLocalOriginValid) {
+        return true;
+    }
+    record = next;
+    record.active = tracked;
+    record.flags = tracked ? flags : 0;
+    record.questTimestamp = timestamp;
+    record.arrival = monotonicTime();
+    return true;
+}
