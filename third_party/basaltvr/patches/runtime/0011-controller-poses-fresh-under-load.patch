+// cranvr: see control.hpp. The file opens once for each process. It keeps the lines of earlier games, up to 256 KB.
+void note(const char* format, ...) {
+    char line[512];
+    va_list arguments;
+    va_start(arguments, format);
+    std::vsnprintf(line, sizeof(line), format, arguments);
+    va_end(arguments);
+    std::fputs(line, stderr);
+
+    static SRWLOCK lock = SRWLOCK_INIT;
+    static FILE* file = nullptr;
+    static bool opened = false;
+    AcquireSRWLockExclusive(&lock);
+    if (!opened) {
+        opened = true;
+        char path[MAX_PATH]{};
+        const DWORD length = GetEnvironmentVariableA("BASALT_CONTROL", path, sizeof(path) - 20);
+        char* separator = length == 0 ? nullptr : std::strrchr(path, '\\');
+        if (separator != nullptr) {
+            std::strcpy(separator + 1, "game-input.log");
+            WIN32_FILE_ATTRIBUTE_DATA attributes{};
+            const bool large = GetFileAttributesExA(path, GetFileExInfoStandard, &attributes) && attributes.nFileSizeHigh == 0 &&
+                               attributes.nFileSizeLow > 256 * 1024;
+            file = std::fopen(path, large ? "w" : "a");
+            if (file != nullptr) {
+                char program[MAX_PATH]{};
+                GetModuleFileNameA(nullptr, program, sizeof(program));
+                std::fprintf(file, "---- %s (process %lu)\n", program, static_cast<unsigned long>(GetCurrentProcessId()));
+            }
+        }
+    }
+    if (file != nullptr) {
+        std::fputs(line, file);
+        std::fflush(file);
+    }
+    ReleaseSRWLockExclusive(&lock);
+}
