+/*
+ * cranvr: a game's mailbox messages (message 25). A game that speaks OpenVR sends messages to
+ * SteamVR through IVRMailbox, such as what its loading screen shows. An OpenVR runtime on top of
+ * this runtime (OpenComposite) hands each message to the runtime through the extension
+ * XR_CRANVR_mailbox, and the runtime passes it on unchanged. The daemon knows what the messages of
+ * a game mean. A message that comes while no daemon is connected goes out at the next connection, in
+ * order. A message that does not fit into BASALT_CONTROL_MAX_MESSAGE_LENGTH is dropped.
+ *   MAILBOX_MESSAGE (runtime -> daemon)
+ *     u16 address_length, the address in UTF-8 (such as "game/interstitials"),
+ *     u16 message_length, the message in UTF-8 (a JSON object in the games known so far)
+ */
+
 #define BASALT_CONTROL_PROTOCOL_VERSION 9u
 #define BASALT_CONTROL_TOKEN_LENGTH 32u
 #define BASALT_CONTROL_MAX_MESSAGE_LENGTH 4096u
@@ -172,6 +184,7 @@ enum {
