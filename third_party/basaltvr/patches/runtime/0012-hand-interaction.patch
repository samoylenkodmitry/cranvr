+// cranvr: XR_EXT_hand_interaction of both hands in LOCAL. Each pose moves forward by
+// its own velocity from the sample's arrival to `locateTime`, as the joints of a hand do.
+void fillHandInteractionsLocked(
+    ControlInputSnapshot* snapshot, const XrPosef& localFromQuest, XrTime locateTime, XrTime now) {
+    for (uint32_t hand = 0; hand < 2; ++hand) {
+        const HandInteractionRecord& record = gHandInteractions[hand];
+        ControlHandInteractionState& state = snapshot->handInteractions[hand];
+        state = {};
+        state.active = trackedFresh(record.active, record.arrival, now);
+        if (!state.active) {
+            continue;
+        }
+        const float seconds = extrapolationSeconds(record.arrival, locateTime);
+        for (uint32_t gesture = 0; gesture < kHandGestureCount; ++gesture) {
+            state.ready[gesture] = (record.flags & (2u << gesture)) != 0;
+            // The extension's rule: a gesture that is not ready has the value 0
+            state.values[gesture] = state.ready[gesture] ? record.values[gesture] : 0.0f;
+        }
+        for (uint32_t pose = 0; pose < kHandPoseCount; ++pose) {
+            const TrackedRootRecord& motion = record.poses[pose];
+            const ControlTrackedJoint moved =
+                trackedJointInLocal(TrackedJointRecord{15, motion.pose}, motion, localFromQuest, seconds);
+            ControlControllerState& out = state.poses[pose];
+            out.poseActive = true;
+            out.profileActive = true;
+            out.questTimestampNanoseconds = record.questTimestamp;
+            out.poseInLocal = moved.pose;
+            out.linearVelocity = moved.linearVelocity;
+            out.angularVelocity = moved.angularVelocity;
+        }
+    }
