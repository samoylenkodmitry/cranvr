+struct ControlFrameView;
+
+// cranvr: the GPU side of the frame handoff of one session. The runtime sends a frame to the
+// host only after the GPU has finished the game's commands for it. The functions are plain
+// pointers, not virtual functions: a C++ class with virtual functions links the C++ runtime's type
+// information and exceptions, which need libwinpthread-1.dll, and Wine has no such DLL.
+struct FrameSync {
+    // Called on the xrEndFrame thread for each view before signal: copies a slice of a two-slice
+    // swapchain into its exported image and rewrites the image index to the registered surface.
+    bool (*prepareView)(FrameSync* sync, ControlFrameView* view);
+    // Called on the xrEndFrame thread: marks the end of the game's commands for the frame.
+    bool (*signal)(FrameSync* sync, uint64_t frameNumber);
+    // Called on the waiter thread: true once the GPU has passed the frame's mark.
+    bool (*wait)(FrameSync* sync, uint64_t frameNumber, DWORD milliseconds);
+    // Frees the sync and what it holds; null is no sync
+    void (*destroy)(FrameSync* sync);
+};
+
+inline void destroyFrameSync(FrameSync* sync) {
+    if (sync != nullptr) {
+        sync->destroy(sync);
+    }
+}
