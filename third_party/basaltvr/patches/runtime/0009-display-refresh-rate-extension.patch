+// cranvr: XR_FB_display_refresh_rate. The headset's rate comes from the control file and stays for
+// the life of the process (see displayPeriod), so it is the only rate on offer. A request for it,
+// and the request for the default (0), succeed. A request for another rate is refused, as the
+// extension allows for a rate that is not on the list.
+XrResult XRAPI_CALL enumerateDisplayRefreshRates(
+    XrSession session,
+    uint32_t capacityInput,
+    uint32_t* countOutput,
+    float* rates) {
+    if (!isValidSession(session)) {
+        return XR_ERROR_HANDLE_INVALID;
+    }
+    if (countOutput == nullptr || (capacityInput > 0 && rates == nullptr)) {
+        return XR_ERROR_VALIDATION_FAILURE;
+    }
+    *countOutput = 1;
+    if (capacityInput == 0) {
+        return XR_SUCCESS;
+    }
+    rates[0] = static_cast<float>(basalt::controlConfiguredRefreshHz());
+    return XR_SUCCESS;
+}
+
+XrResult XRAPI_CALL getDisplayRefreshRate(XrSession session, float* rate) {
+    if (!isValidSession(session)) {
+        return XR_ERROR_HANDLE_INVALID;
+    }
+    if (rate == nullptr) {
+        return XR_ERROR_VALIDATION_FAILURE;
+    }
+    *rate = static_cast<float>(basalt::controlConfiguredRefreshHz());
+    return XR_SUCCESS;
+}
+
+XrResult XRAPI_CALL requestDisplayRefreshRate(XrSession session, float rate) {
+    if (!isValidSession(session)) {
+        return XR_ERROR_HANDLE_INVALID;
+    }
+    const float hz = static_cast<float>(basalt::controlConfiguredRefreshHz());
+    if (rate == 0.0f || std::fabs(rate - hz) < 0.5f) {
+        return XR_SUCCESS;
+    }
+    return XR_ERROR_DISPLAY_REFRESH_RATE_UNSUPPORTED_FB;
+}
