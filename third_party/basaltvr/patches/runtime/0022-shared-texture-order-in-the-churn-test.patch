+// Work that keeps a process's GPU busy for some milliseconds, and the commands after it wait for it on the GPU. Metal
+// may run the encoders of a command buffer in any order when they share no resource, so the copies alone would not
+// delay a clear of another texture. A fence of the process orders them: run() signals it after the copies and the
+// next commands wait for that value.
+struct Busy {
+    ID3D11Texture2D *a = nullptr, *b = nullptr;
+    ID3D11Fence *fence = nullptr;
+    UINT64 value = 0;
+    unsigned copies = 0;
+
+    bool create(Device &d) {
+        D3D11_TEXTURE2D_DESC desc = {};
+        desc.Width = desc.Height = 4096;
+        desc.MipLevels = desc.ArraySize = 1;
+        desc.Format = DXGI_FORMAT_R8G8B8A8_UNORM;
+        desc.SampleDesc.Count = 1;
+        desc.Usage = D3D11_USAGE_DEFAULT;
+        desc.BindFlags = D3D11_BIND_SHADER_RESOURCE;
+        HRESULT hr = d.device->CreateTexture2D(&desc, nullptr, &a);
+        if (SUCCEEDED(hr))
+            hr = d.device->CreateTexture2D(&desc, nullptr, &b);
+        if (SUCCEEDED(hr))
+            hr = d.device5->CreateFence(0, D3D11_FENCE_FLAG_NONE, IID_PPV_ARGS(&fence));
+        return SUCCEEDED(hr) || fail("the busy work's textures and fence", hr);
+    }
+
+    void run(Device &d) {
+        for (unsigned i = 0; i < copies; i++)
+            d.context->CopyResource(i % 2 ? a : b, i % 2 ? b : a);
+        d.context4->Signal(fence, ++value); // flushes
+        d.context4->Wait(fence, value);
+    }
+
+    // Doubles the copies until the work takes at least 4 ms of the GPU (at most 512 copies); returns the time. A first
+    // run of one copy is not timed: it waits for the zeros that DXMT writes into new textures.
+    double calibrate(Device &d, HANDLE event) {
+        copies = 1;
+        run(d);
+        if (!waitFence(fence, value, event, 10000))
+            return -1;
+        double ms = 0;
+        for (copies = 4; copies <= 512; copies *= 2) {
+            auto begin = std::chrono::steady_clock::now();
+            run(d);
+            if (!waitFence(fence, value, event, 10000))
+                return -1;
+            ms = std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - begin).count();
+            if (ms >= 4)
+                break;
+        }
+        copies = std::min(copies, 512u);
+        return ms;
+    }
+
+    ~Busy() {
+        release(fence);
+        release(b);
+        release(a);
+    }
+};
+
+// Copies a subresource of a texture to a staging texture and reads its first texel as 8-bit R, G, B, or the three
+// half floats of R16G16B16A16_FLOAT. Fails when the copy does not end within `waitMs` (a GPU that waits for good).
+std::string readTexel(Device &d, ID3D11Texture2D *texture, const D3D11_TEXTURE2D_DESC &desc, UINT subresource,
+                      uint16_t out[3], DWORD waitMs = INFINITE) {
+    D3D11_TEXTURE2D_DESC sdesc = desc;
+    sdesc.MipLevels = 1;
+    sdesc.ArraySize = 1;
+    sdesc.Usage = D3D11_USAGE_STAGING;
+    sdesc.BindFlags = 0;
+    sdesc.CPUAccessFlags = D3D11_CPU_ACCESS_READ;
+    sdesc.MiscFlags = 0;
+    ID3D11Texture2D *staging = nullptr;
+    if (FAILED(d.device->CreateTexture2D(&sdesc, nullptr, &staging)))
+        return "no staging texture";
+    d.context->CopySubresourceRegion(staging, 0, 0, 0, 0, texture, subresource, nullptr);
+    if (waitMs != INFINITE) {
+        ID3D11Query *query = nullptr;
+        D3D11_QUERY_DESC qdesc = {D3D11_QUERY_EVENT, 0};
+        if (FAILED(d.device->CreateQuery(&qdesc, &query))) {
+            staging->Release();
+            return "no event query";
+        }
+        d.context->End(query);
+        d.context->Flush();
+        DWORD until = GetTickCount() + waitMs;
+        while (d.context->GetData(query, nullptr, 0, 0) == S_FALSE && GetTickCount() < until)
+            Sleep(1);
+        bool done = d.context->GetData(query, nullptr, 0, 0) == S_OK;
+        query->Release();
+        if (!done) {
+            staging->Release();
+            return "the copy did not end within " + std::to_string(waitMs) + " ms";
+        }
+    }
+    D3D11_MAPPED_SUBRESOURCE mapped;
+    if (FAILED(d.context->Map(staging, 0, D3D11_MAP_READ, 0, &mapped))) {
+        staging->Release();
+        return "the copy does not map";
+    }
+    if (desc.Format == DXGI_FORMAT_R16G16B16A16_FLOAT) {
+        const uint16_t *p = static_cast<const uint16_t *>(mapped.pData);
+        out[0] = p[0];
+        out[1] = p[1];
+        out[2] = p[2];
+    } else {
+        const uint8_t *p = static_cast<const uint8_t *>(mapped.pData);
+        bool bgra = desc.Format == DXGI_FORMAT_B8G8R8A8_UNORM;
+        out[0] = bgra ? p[2] : p[0];
+        out[1] = p[1];
+        out[2] = bgra ? p[0] : p[2];
+    }
+    d.context->Unmap(staging, 0);
+    staging->Release();
+    return "ok";
+}
+
+// Whether a texel that readTexel read is the color c; `seen` describes it
+bool sameColor(DXGI_FORMAT format, const uint16_t got[3], const uint8_t c[4], char *seen, size_t size) {
+    if (format == DXGI_FORMAT_R16G16B16A16_FLOAT) {
+        std::snprintf(seen, size, "%04x %04x %04x, want %04x %04x %04x", got[0], got[1], got[2],
+                      halfOf(c[0] / 256.0f), halfOf(c[1] / 256.0f), halfOf(c[2] / 256.0f));
+        return got[0] == halfOf(c[0] / 256.0f) && got[1] == halfOf(c[1] / 256.0f) && got[2] == halfOf(c[2] / 256.0f);
+    }
+    std::snprintf(seen, size, "%u %u %u, want %u %u %u", got[0], got[1], got[2], c[0], c[1], c[2]);
+    return got[0] == c[0] && got[1] == c[1] && got[2] == c[2];
+}
+
+// Clears every slice of a color texture to c
+bool clearTo(Device &d, ID3D11Texture2D *texture, const D3D11_TEXTURE2D_DESC &desc, const uint8_t c[4]) {
+    float rgba[4] = {c[0] / 256.0f, c[1] / 256.0f, c[2] / 256.0f, 1.0f};
+    if (desc.Format != DXGI_FORMAT_R16G16B16A16_FLOAT) {
+        for (int i = 0; i < 3; i++)
+            rgba[i] = c[i] / 255.0f;
+    }
+    for (UINT slice = 0; slice < desc.ArraySize; slice++) {
+        D3D11_RENDER_TARGET_VIEW_DESC rtv = {};
+        rtv.Format = desc.Format;
+        if (desc.ArraySize > 1) {
+            rtv.ViewDimension = D3D11_RTV_DIMENSION_TEXTURE2DARRAY;
+            rtv.Texture2DArray.FirstArraySlice = slice;
+            rtv.Texture2DArray.ArraySize = 1;
+        } else {
+            rtv.ViewDimension = D3D11_RTV_DIMENSION_TEXTURE2D;
+        }
+        ID3D11RenderTargetView *view = nullptr;
+        HRESULT hr = d.device->CreateRenderTargetView(texture, &rtv, &view);
+        if (FAILED(hr))
+            return fail("CreateRenderTargetView", hr);
+        d.context->ClearRenderTargetView(view, rgba);
+        view->Release();
+    }
+    return true;
+}
+
+// The color that the second process writes back into bgra8 in a cycle, and into the last texture before it ends
+void colorBackOf(unsigned cycle, uint8_t out[4]) {
+    colorOf(cycle + 100000u, kBgra8, out);
+}
